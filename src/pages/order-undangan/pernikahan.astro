---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Container from "../../components/base/Container.astro";
import Section from "../../components/base/Section.astro";
import Icon from "../../components/ui/Icon.astro";
import { getCollection } from "astro:content";
import { pricingPlans } from "../../data/pricing-static";
import { siteConfig } from "../../data/site";

// Fetch all wedding designs from content collection
const allDesigns = await getCollection("designs");
const weddingDesigns = allDesigns
  .filter(
    (d) => d.data.status === "published" && d.data.category === "pernikahan",
  )
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<MarketingLayout
  title="Formulir Order Undangan Pernikahan Premium | Acaranya.id"
  description="Isi detail data pernikahan Anda untuk pembuatan undangan digital premium berestetika tinggi di Acaranya.id."
  hideFloatingWa={true}
>
  <!-- Hero Header -->
  <section
    class="relative pt-28 pb-16 lg:pt-36 lg:pb-24 bg-cream overflow-hidden"
  >
    <div
      class="absolute inset-0 text-brand-300 opacity-20 pointer-events-none"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>

    <Container>
      <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4">
        <span
          class="text-[10px] uppercase tracking-[0.25em] text-[#B59A73] font-bold block"
          >Pemesanan Spesial</span
        >
        <h1
          class="font-serif text-3xl sm:text-5xl text-brand-950 leading-tight"
        >
          Data Undangan <span class="italic font-normal text-[#B59A73]"
            >Pernikahan</span
          >
        </h1>
        <p
          class="text-text-secondary text-xs sm:text-sm max-w-lg mx-auto font-sans tracking-wide leading-relaxed"
        >
          Isi detail data acara pernikahan Anda dengan teliti di bawah ini.
          Semua data akan diformat secara otomatis dan dikirimkan ke WhatsApp
          admin kami.
        </p>

        <!-- Event Type Quick Switcher (Ribbon) -->
        <div class="pt-4 space-y-2 flex flex-col items-center">
          <span
            class="block text-[8px] font-bold uppercase tracking-widest text-[#B59A73]"
            >Pilih Formulir Spesifik Acara:</span
          >
          <div class="flex flex-wrap gap-2.5 justify-center max-w-2xl">
            <a
              href="/order-undangan/pernikahan/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#B59A73]/10 border border-[#B59A73]/40 text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="heart" size={10} /> Pernikahan
            </a>
            <a
              href="/order-undangan/khitanan/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="user" size={10} class="text-[#B59A73]" /> Khitanan
            </a>
            <a
              href="/order-undangan/ulang-tahun/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="cake" size={10} class="text-[#B59A73]" /> Ulang Tahun
            </a>
            <a
              href="/order-undangan/aqiqah/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="baby" size={10} class="text-[#B59A73]" /> Aqiqah
            </a>
            <a
              href="/order-undangan/corporate/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="building" size={10} class="text-[#B59A73]" /> Corporate
            </a>
            <a
              href="/order-undangan/wisuda/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="graduation-cap" size={10} class="text-[#B59A73]" /> Wisuda
            </a>
            <a
              href="/order-undangan/"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs"
            >
              <Icon name="sparkles" size={10} class="text-[#B59A73]" /> Umum (Lainnya)
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Checkout/Form Section -->
  <Section bg="white" class="border-t border-border-soft/60">
    <Container>
      <div class="grid lg:grid-cols-3 gap-12 max-w-6xl mx-auto items-start">
        <!-- Form Column -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Sticky Visual Selection Helpers -->
          <div
            class="grid grid-cols-2 gap-4 p-4 bg-cream/70 rounded-2xl border border-[#B59A73]/15"
          >
            <a
              href="/desain-undangan-digital/pernikahan/"
              class="flex items-center justify-center gap-2 px-4 py-3 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-850 hover:text-[#B59A73] text-[10px] font-bold uppercase tracking-widest rounded-xl transition-all duration-300 shadow-sm text-center"
            >
              <Icon name="image" size={12} class="text-[#B59A73]" />
              Pilih Desain
            </a>
            <a
              href="/harga/"
              class="flex items-center justify-center gap-2 px-4 py-3 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-850 hover:text-[#B59A73] text-[10px] font-bold uppercase tracking-widest rounded-xl transition-all duration-300 shadow-sm text-center"
            >
              <Icon name="tag" size={12} class="text-[#B59A73]" />
              Daftar Harga
            </a>
          </div>

          <form id="order-wedding-form" class="space-y-10">
            <!-- Honeypot -->
            <div class="hidden" aria-hidden="true">
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
            </div>

            <!-- SECTION 1: INFORMASI PEMESAN -->
            <div class="space-y-6">
              <div
                class="flex items-center gap-3 pb-3 border-b border-border-soft/60"
              >
                <span
                  class="w-5 h-5 rounded-full bg-[#B59A73] text-cream text-[9px] font-bold flex items-center justify-center"
                  >1</span
                >
                <h3 class="font-serif text-lg text-brand-950 font-medium">
                  Informasi Pemesan
                </h3>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                  <label
                    for="name"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Nama Pemesan <span class="text-error">*</span></label
                  >
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    minlength="2"
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: Sarah Aulia"
                  />
                </div>
                <div class="space-y-1.5">
                  <label
                    for="whatsapp"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Nomor WhatsApp <span class="text-error">*</span></label
                  >
                  <input
                    type="tel"
                    id="whatsapp"
                    name="whatsapp"
                    required
                    minlength="8"
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: 081234567890"
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                  <label
                    for="template"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Nama Desain Undangan <span class="text-error">*</span
                    ></label
                  >
                  <input
                    type="text"
                    id="template"
                    name="template"
                    required
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: Elegant Gold Wedding"
                  />
                </div>
                <div class="space-y-1.5">
                  <label
                    for="package"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Paket Harga <span class="text-error">*</span></label
                  >
                  <select
                    id="package"
                    name="package"
                    required
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans appearance-none"
                  >
                    <option value="">Pilih paket undangan</option>
                    {
                      pricingPlans.map((p) => (
                        <option value={p.slug}>
                          {p.name} — {p.priceDisplay}
                        </option>
                      ))
                    }
                  </select>
                </div>
              </div>

              <div class="space-y-1.5">
                <label
                  for="email"
                  class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                  >Email Aktif <span
                    class="text-text-muted font-sans font-medium"
                    >(opsional)</span
                  ></label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                  placeholder="Contoh: sarah@gmail.com"
                />
              </div>
            </div>

            <!-- SECTION 2: DATA PENGANTIN -->
            <div class="space-y-6">
              <div
                class="flex items-center gap-3 pb-3 border-b border-border-soft/60"
              >
                <span
                  class="w-5 h-5 rounded-full bg-[#B59A73] text-cream text-[9px] font-bold flex items-center justify-center"
                  >2</span
                >
                <h3 class="font-serif text-lg text-brand-950 font-medium">
                  Informasi Pengantin
                </h3>
              </div>

              <!-- Nama yang Didahulukan -->
              <div class="space-y-2">
                <label
                  class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                >
                  Nama yang Didahulukan <span class="text-error">*</span>
                </label>
                <div class="grid grid-cols-2 gap-4">
                  <label
                    class="relative flex items-center justify-center gap-2 p-3 bg-cream/30 border border-[#B59A73]/20 rounded-xl cursor-pointer hover:bg-cream/50 transition-all font-sans text-xs"
                  >
                    <input
                      type="radio"
                      name="priorityName"
                      value="pria"
                      required
                      class="accent-[#B59A73]"
                      checked
                    />
                    <span class="font-semibold text-brand-950"
                      >Mempelai Pria</span
                    >
                  </label>
                  <label
                    class="relative flex items-center justify-center gap-2 p-3 bg-cream/30 border border-[#B59A73]/20 rounded-xl cursor-pointer hover:bg-cream/50 transition-all font-sans text-xs"
                  >
                    <input
                      type="radio"
                      name="priorityName"
                      value="wanita"
                      required
                      class="accent-[#B59A73]"
                    />
                    <span class="font-semibold text-brand-950"
                      >Mempelai Wanita</span
                    >
                  </label>
                </div>
              </div>

              <!-- DATA MEMPELAI PRIA -->
              <div
                class="p-6 bg-cream/30 rounded-2xl border border-border-soft/60 space-y-5"
              >
                <div
                  class="flex items-center gap-2 pb-2 border-b border-border-soft/40"
                >
                  <span class="text-brand-900 font-bold text-xs font-sans"
                    >Data Mempelai Pria</span
                  >
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="groomFullName"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Lengkap <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="groomFullName"
                      name="groomFullName"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Rian Anggara, S.T."
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="groomNickName"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Panggilan <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="groomNickName"
                      name="groomNickName"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Rian"
                    />
                  </div>
                </div>

                <div class="space-y-1">
                  <label
                    for="groomOrder"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Anak ke-berapa <span class="text-error">*</span></label
                  >
                  <input
                    type="text"
                    id="groomOrder"
                    name="groomOrder"
                    required
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: Putra pertama dari dua bersaudara"
                  />
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="groomFather"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Bapak <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="groomFather"
                      name="groomFather"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Bapak Herman Wijaya"
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="groomMother"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Ibu <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="groomMother"
                      name="groomMother"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Ibu Rita Sugiarto"
                    />
                  </div>
                </div>

                <div class="space-y-1">
                  <label
                    for="groomInstagram"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Username Instagram <span
                      class="text-text-muted font-sans font-medium"
                      >(opsional)</span
                    ></label
                  >
                  <input
                    type="text"
                    id="groomInstagram"
                    name="groomInstagram"
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: @rian.anggara"
                  />
                </div>
              </div>

              <!-- DATA MEMPELAI WANITA -->
              <div
                class="p-6 bg-cream/30 rounded-2xl border border-border-soft/60 space-y-5"
              >
                <div
                  class="flex items-center gap-2 pb-2 border-b border-border-soft/40"
                >
                  <span class="text-brand-900 font-bold text-xs font-sans"
                    >Data Mempelai Wanita</span
                  >
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="brideFullName"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Lengkap <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="brideFullName"
                      name="brideFullName"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Sarah Aulia, S.E."
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="brideNickName"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Panggilan <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="brideNickName"
                      name="brideNickName"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Sarah"
                    />
                  </div>
                </div>

                <div class="space-y-1">
                  <label
                    for="brideOrder"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Anak ke-berapa <span class="text-error">*</span></label
                  >
                  <input
                    type="text"
                    id="brideOrder"
                    name="brideOrder"
                    required
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: Putri kedua dari tiga bersaudara"
                  />
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="brideFather"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Bapak <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="brideFather"
                      name="brideFather"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Bapak Ahmad Syarif"
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="brideMother"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Nama Ibu <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="brideMother"
                      name="brideMother"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Ibu Lilis Kartika"
                    />
                  </div>
                </div>

                <div class="space-y-1">
                  <label
                    for="brideInstagram"
                    class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                    >Username Instagram <span
                      class="text-text-muted font-sans font-medium"
                      >(opsional)</span
                    ></label
                  >
                  <input
                    type="text"
                    id="brideInstagram"
                    name="brideInstagram"
                    class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                    placeholder="Contoh: @sarah.aulia"
                  />
                </div>
              </div>
            </div>

            <!-- SECTION 3: DATA ACARA -->
            <div class="space-y-6">
              <div
                class="flex items-center gap-3 pb-3 border-b border-border-soft/60"
              >
                <span
                  class="w-5 h-5 rounded-full bg-[#B59A73] text-cream text-[9px] font-bold flex items-center justify-center"
                  >3</span
                >
                <h3 class="font-serif text-lg text-brand-950 font-medium">
                  Informasi Acara
                </h3>
              </div>

              <!-- DATA AKAD/PEMBERKATAN -->
              <div
                class="p-6 bg-cream/30 rounded-2xl border border-border-soft/60 space-y-5"
              >
                <div
                  class="flex items-center gap-2 pb-2 border-b border-border-soft/40"
                >
                  <span class="text-brand-900 font-bold text-xs font-sans"
                    >Akad Nikah / Pemberkatan</span
                  >
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="akadDate"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Hari & Tanggal <span class="text-error">*</span></label
                    >
                    <input
                      type="text"
                      id="akadDate"
                      name="akadDate"
                      required
                      class="w-full px-5 py-3.5 border border-[#B59A73]/20 bg-cream/30 text-brand-950 text-xs rounded-xl focus:outline-none focus:ring-1 focus:ring-[#B59A73] focus:border-[#B59A73] transition-all font-sans"
                      placeholder="Contoh: Minggu, 12 Desember 2026"
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="akadTime"
                      class="block text-[9px] font-bold uppercase tracking-widest text-[#B59A73]"
                      >Waktu Acara (Mulai - Selesai) <span class="text-error"
                        >*</span
                      ></label
