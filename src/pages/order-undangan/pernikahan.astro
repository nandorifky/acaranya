              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 border border-brand-300/85 text-brand-850 text-[9px] font-bold uppercase tracking-widest rounded-full hover:bg-brand-950 hover:text-cream transition-all duration-300"
