<script define:vars={{ waPhone: siteConfig.contact.whatsapp }}>
  // Toggle Resepsi Form Container
  const toggleResepsi = document.getElementById("toggle-resepsi");
  const resepsiContainer = document.getElementById("resepsi-form-container");
  const resepsiInputs = resepsiContainer
    ? resepsiContainer.querySelectorAll("input, select, textarea")
    : [];

  if (toggleResepsi && resepsiContainer) {
    toggleResepsi.addEventListener("change", () => {
      if (toggleResepsi.checked) {
        resepsiContainer.classList.remove("hidden");
        // trigger animation frames
        requestAnimationFrame(() => {
          resepsiContainer.classList.remove("opacity-0", "translate-y-[-10px]");
          resepsiContainer.classList.add("opacity-100", "translate-y-0");
        });
        // Make inputs required except maps
        resepsiInputs.forEach((input) => {
          if (input.name !== "resepsiMaps" && input.name !== "resepsiTz") {
            input.setAttribute("required", "true");
          }
        });
      } else {
        resepsiContainer.classList.add("opacity-0", "translate-y-[-10px]");
        resepsiContainer.classList.remove("opacity-100", "translate-y-0");
        setTimeout(() => {
          resepsiContainer.classList.add("hidden");
        }, 300);
        // Remove required attribute
        resepsiInputs.forEach((input) => {
          input.removeAttribute("required");
        });
      }
    });
  }

  // Handle auto-selected query params on mount
  const params = new URLSearchParams(window.location.search);
  const selectedTemplate = params.get("template");
  const selectedPackage = params.get("package");
  const designInput = document.getElementById("template");
  const packageSelect = document.getElementById("package");

  if (selectedTemplate && designInput) {
    designInput.value = selectedTemplate;
  }
  if (selectedPackage && packageSelect) {
    packageSelect.value = selectedPackage;
  }

  // FORM SUBMIT -> FORMAT BEAUTIFUL WHATSAPP MESSAGE
  const form = document.getElementById("order-wedding-form");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get("_hp")) return; // Honeypot match

      const name = fd.get("name");
      const whatsapp = fd.get("whatsapp");
      const email = fd.get("email") || "-";
      const template = fd.get("template");
      const pkg = fd.get("package");
      const referralCode = fd.get("referralCode") || "-";

      const priorityName =
        fd.get("priorityName") === "pria"
          ? "Mempelai Pria Didahulukan"
          : "Mempelai Wanita Didahulukan";

      const groomFullName = fd.get("groomFullName");
      const groomNickName = fd.get("groomNickName");
      const groomOrder = fd.get("groomOrder");
      const groomFather = fd.get("groomFather");
      const groomMother = fd.get("groomMother");
      const groomInstagram = fd.get("groomInstagram") || "-";

      const brideFullName = fd.get("brideFullName");
      const brideNickName = fd.get("brideNickName");
      const brideOrder = fd.get("brideOrder");
      const brideFather = fd.get("brideFather");
      const brideMother = fd.get("brideMother");
      const brideInstagram = fd.get("brideInstagram") || "-";

      const akadDate = fd.get("akadDate");
      const akadTime = fd.get("akadTime");
      const akadTz = fd.get("akadTz");
      const akadAddress = fd.get("akadAddress");
      const akadMaps = fd.get("akadMaps") || "Kirim manual ke WhatsApp admin";

      let resepsiMessage = "❌ Tidak Ada Acara Resepsi";
      if (toggleResepsi && toggleResepsi.checked) {
        const resepsiDate = fd.get("resepsiDate") || "-";
        const resepsiTime = fd.get("resepsiTime") || "-";
        const resepsiTz = fd.get("resepsiTz") || "WIB";
        const resepsiAddress = fd.get("resepsiAddress") || "-";
        const resepsiMaps =
          fd.get("resepsiMaps") || "Kirim manual ke WhatsApp admin";

        resepsiMessage = `💍 ACARA RESEPSI:
• Hari & Tanggal: ${resepsiDate}
• Waktu: ${resepsiTime} ${resepsiTz}
• Alamat: ${resepsiAddress}
• Google Maps: ${resepsiMaps}`;
      }

      const waMessage = `Halo Acaranya.id, saya ingin memesan Undangan Pernikahan Digital Premium!

📋 INFORMASI PEMESAN
------------------------------
• Nama Pemesan: ${name}
• Nomor WhatsApp: ${whatsapp}
• Pilihan Desain: ${template}
• Email Aktif: ${email}
• Paket Harga: ${pkg.toUpperCase()}
• Kode Referal: ${referralCode}

🤵👰 INFORMASI PENGANTIN
------------------------------
• Urutan Tampil: ${priorityName}

♂️ MEMPELAI PRIA:
• Nama Lengkap: ${groomFullName}
• Nama Panggilan: ${groomNickName}
• Urutan Anak: ${groomOrder}
• Nama Bapak: ${groomFather}
• Nama Ibu: ${groomMother}
• Instagram: ${groomInstagram}

♀️ MEMPELAI WANITA:
• Nama Lengkap: ${brideFullName}
• Nama Panggilan: ${brideNickName}
• Urutan Anak: ${brideOrder}
• Nama Bapak: ${brideFather}
• Nama Ibu: ${brideMother}
• Instagram: ${brideInstagram}

📅 INFORMASI ACARA
------------------------------
💍 ACARA AKAD / PEMBERKATAN:
• Hari & Tanggal: ${akadDate}
• Waktu: ${akadTime} ${akadTz}
• Alamat: ${akadAddress}
• Google Maps: ${akadMaps}

${resepsiMessage}

------------------------------
Checklist: Saya menyatakan data di atas sudah diisi dengan benar dan valid.`;

      const targetUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;
      window.open(targetUrl, "_blank");
    });
  }
</script>
