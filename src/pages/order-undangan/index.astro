---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Container from '../../components/base/Container.astro';
import Section from '../../components/base/Section.astro';
import Icon from '../../components/ui/Icon.astro';
import { createWhatsappUrl } from '../../lib/whatsapp/create-whatsapp-url';
import { eventTypes } from '../../data/event-types';
import { pricingPlans } from '../../data/pricing-static';
import { siteConfig } from '../../data/site';
---

<MarketingLayout
  title="Order Undangan Digital Premium"
  description="Langkah mudah order undangan digital berkelas di Acaranya.id. Selesaikan pengisian formulir data acara awal dan hubungi tim admin kami."
  hideFloatingWa={true}
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-16 lg:pt-36 lg:pb-24 bg-cream overflow-hidden">
    <!-- Subtle Background Dot Pattern -->
    <div 
      class="absolute inset-0 text-brand-300 opacity-20 pointer-events-none"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <Container>
      <div class="relative z-10 max-w-3xl space-y-4">
        <span class="text-[10px] uppercase tracking-[0.22em] text-soft-gold font-bold">Pemesanan Instan</span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-950 leading-tight">
          Formulir <span class="italic font-normal text-soft-gold">pemesanan undangan</span>
        </h1>
        <p class="text-text-secondary text-sm md:text-base max-w-lg font-sans tracking-wide leading-relaxed">
          Silakan isi beberapa detail awal di bawah ini. Data Anda akan diteruskan secara instan untuk konsultasi eksklusif bersama tim desainer kami.
        </p>

        <!-- Event Type Quick Switcher (Ribbon) -->
        <div class="pt-4 space-y-2">
          <span class="block text-[8px] font-bold uppercase tracking-widest text-[#B59A73]">Pilih Formulir Spesifik Acara:</span>
          <div class="flex flex-wrap gap-2.5">
            <a href="/order-undangan/pernikahan/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="heart" size={10} class="text-[#B59A73]" /> Pernikahan
            </a>
            <a href="/order-undangan/khitanan/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="user" size={10} class="text-[#B59A73]" /> Khitanan
            </a>
            <a href="/order-undangan/ulang-tahun/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="cake" size={10} class="text-[#B59A73]" /> Ulang Tahun
            </a>
            <a href="/order-undangan/aqiqah/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="baby" size={10} class="text-[#B59A73]" /> Aqiqah
            </a>
            <a href="/order-undangan/corporate/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="building" size={10} class="text-[#B59A73]" /> Corporate
            </a>
            <a href="/order-undangan/wisuda/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#B59A73]/20 hover:border-[#B59A73] text-brand-950 hover:text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="graduation-cap" size={10} class="text-[#B59A73]" /> Wisuda
            </a>
            <a href="/order-undangan/" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#B59A73]/10 border border-[#B59A73]/40 text-[#B59A73] text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-xs">
              <Icon name="sparkles" size={10} /> Umum (Lainnya)
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Checkout Grid (Kinto Style) -->
  <Section bg="white" id="order-flow-section" class="border-t border-border-soft/60">
    <Container>
      <div class="grid lg:grid-cols-3 gap-12 max-w-6xl mx-auto">
        <!-- Form Column -->
        <div class="lg:col-span-2 space-y-8">
          <form id="order-form" class="space-y-6">
            <div class="hidden" aria-hidden="true">
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div class="space-y-1.5">
                <label for="name" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Nama Pemesan <span class="text-error">*</span>
                </label>
                <input type="text" id="name" name="name" required minlength="2" 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide" 
                  placeholder="Nama lengkap Anda" />
              </div>
              <div class="space-y-1.5">
                <label for="whatsapp" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Nomor WhatsApp <span class="text-error">*</span>
                </label>
                <input type="tel" id="whatsapp" name="whatsapp" required minlength="8" 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide" 
                  placeholder="08xxxxxxxxxx" />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="email" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                Email <span class="text-text-muted font-sans font-medium">(opsional)</span>
              </label>
              <input type="email" id="email" name="email" 
                class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide" 
                placeholder="surel@anda.com" />
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div class="space-y-1.5">
                <label for="eventType" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Jenis Acara <span class="text-error">*</span>
                </label>
                <select id="eventType" name="eventType" required 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide appearance-none">
                  <option value="">Pilih jenis acara</option>
                  {eventTypes.map(et => (
                    <option value={et.value}>{et.label}</option>
                  ))}
                </select>
              </div>
              <div class="space-y-1.5">
                <label for="package" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Paket Pilihan <span class="text-error">*</span>
                </label>
                <select id="package" name="package" required 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide appearance-none">
                  <option value="">Pilih paket undangan</option>
                  {pricingPlans.map(p => (
                    <option value={p.slug}>{p.name} — {p.priceDisplay}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div class="space-y-1.5">
                <label for="template" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Desain Pilihan <span class="text-text-muted font-sans font-medium">(opsional)</span>
                </label>
                <input type="text" id="template" name="template" 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide" 
                  placeholder="Contoh: Kinto Luxury" />
              </div>
              <div class="space-y-1.5">
                <label for="eventDate" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                  Tanggal Acara <span class="text-text-muted font-sans font-medium">(opsional)</span>
                </label>
                <input type="date" id="eventDate" name="eventDate" 
                  class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide" />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="notes" class="block text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">
                Catatan Desain & Request Khusus <span class="text-text-muted font-sans font-medium">(opsional)</span>
              </label>
              <textarea id="notes" name="notes" rows="4" maxlength="500" 
                class="w-full px-5 py-4 border border-[#B59A73]/25 bg-cream text-brand-950 text-sm rounded-2xl focus:outline-none focus:ring-1 focus:ring-soft-gold focus:border-soft-gold transition-all duration-300 font-sans tracking-wide resize-none" 
                placeholder="Tulis instruksi warna, tema lagu, atau fitur kustom lain jika ada..."></textarea>
            </div>

            <!-- Selected template indicator (populated by JS) -->
            <div id="selected-info" class="hidden p-5 bg-[#B59A73]/10 border border-[#B59A73]/30 text-xs text-soft-gold rounded-2xl flex items-center gap-2">
              <Icon name="sparkles" size={12} />
              <span>Template dipilih secara otomatis: <strong class="font-bold font-serif" id="selected-template-name"></strong></span>
            </div>

            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-[#25D366] hover:bg-[#1da851] text-cream text-[10px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-card hover:shadow-card-hover"
              id="order-submit"
            >
              <Icon name="whatsapp" size={14} />
              Kirim Pemesanan via WhatsApp
            </button>
          </form>
        </div>

        <!-- Sidebar Column (Kinto Card) -->
        <div class="space-y-6">
          <div class="bg-cream rounded-3xl border border-border-soft/60 p-8 space-y-6">
            <h3 class="font-serif text-xl text-brand-950 pb-3 border-b border-border-soft/50">Langkah Berikutnya</h3>
            <ol class="space-y-4 text-xs font-sans text-text-secondary tracking-wide leading-relaxed">
              <li class="flex items-start gap-3.5">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-soft-gold text-cream text-[9px] font-bold flex items-center justify-center mt-0.5">1</span>
                <span>Kirim data awal secara otomatis dari form ini menuju pesan WhatsApp kami.</span>
              </li>
              <li class="flex items-start gap-3.5">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-soft-gold text-cream text-[9px] font-bold flex items-center justify-center mt-0.5">2</span>
                <span>Desainer butik kami membalas untuk konfirmasi data and menerbitkan invoice resmi.</span>
              </li>
              <li class="flex items-start gap-3.5">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-soft-gold text-cream text-[9px] font-bold flex items-center justify-center mt-0.5">3</span>
                <span>Setelah verifikasi pembayaran, rancangan undangan impian Anda mulai dikerjakan.</span>
              </li>
              <li class="flex items-start gap-3.5">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-soft-gold text-cream text-[9px] font-bold flex items-center justify-center mt-0.5">4</span>
                <span>Proses koreksi / revisi hingga hasil benar-benar sempurna and siap disebarluaskan.</span>
              </li>
            </ol>
          </div>

          <div class="bg-cream rounded-3xl border border-border-soft/60 p-8 space-y-4">
            <h3 class="font-serif text-xl text-brand-950 pb-2 border-b border-border-soft/50">Konsultasi Langsung</h3>
            <p class="text-xs text-text-secondary font-sans leading-relaxed tracking-wide">Hubungi desainer kami langsung tanpa mengisi formulir terlebih dahulu.</p>
            <a
              href={createWhatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3.5 border border-brand-300/80 text-brand-800 text-[9px] font-bold uppercase tracking-widest rounded-full hover:bg-brand-950 hover:text-cream transition-all duration-300"
            >
              <Icon name="whatsapp" size={12} class="text-[#25D366]" />
              Chat Desainer
            </a>
          </div>
        </div>

      </div>
    </Container>
  </Section>
</MarketingLayout>

<script define:vars={{ waPhone: siteConfig.contact.whatsapp }}>
  // Client-side: read query params and auto-fill form
  (function() {
    const params = new URLSearchParams(window.location.search);
    const templateParam = params.get('template') || '';
    const packageParam = params.get('package') || '';

    // Auto-redirect to dedicated event form if template keyword matches or category matches
    const templateLower = templateParam.toLowerCase();
    if (templateLower.includes('wedding') || templateLower.includes('nikah')) {
      window.location.href = '/order-undangan/pernikahan/' + window.location.search;
      return;
    } else if (templateLower.includes('khitan')) {
      window.location.href = '/order-undangan/khitanan/' + window.location.search;
      return;
    } else if (templateLower.includes('ultah') || templateLower.includes('birthday') || templateLower.includes('lahir')) {
      window.location.href = '/order-undangan/ulang-tahun/' + window.location.search;
      return;
    } else if (templateLower.includes('aqiqah')) {
      window.location.href = '/order-undangan/aqiqah/' + window.location.search;
      return;
    } else if (templateLower.includes('corporate') || templateLower.includes('kantor') || templateLower.includes('gathering')) {
      window.location.href = '/order-undangan/corporate/' + window.location.search;
      return;
    } else if (templateLower.includes('wisuda') || templateLower.includes('grad')) {
      window.location.href = '/order-undangan/wisuda/' + window.location.search;
      return;
    }

    const eventSelect = document.getElementById('eventType');
    if (eventSelect) {
      // Auto-redirect if they change select to a specific event
      eventSelect.addEventListener('change', (e) => {
        const val = e.target.value;
        if (val === 'pernikahan') {
          window.location.href = '/order-undangan/pernikahan/' + window.location.search;
        } else if (val === 'khitanan') {
          window.location.href = '/order-undangan/khitanan/' + window.location.search;
        } else if (val === 'ulang-tahun' || val === 'ultah') {
          window.location.href = '/order-undangan/ulang-tahun/' + window.location.search;
        } else if (val === 'aqiqah') {
          window.location.href = '/order-undangan/aqiqah/' + window.location.search;
        } else if (val === 'corporate') {
          window.location.href = '/order-undangan/corporate/' + window.location.search;
        } else if (val === 'wisuda') {
          window.location.href = '/order-undangan/wisuda/' + window.location.search;
        }
      });
    }

    // Auto-select package
    if (packageParam) {
      const pkgSelect = document.getElementById('package');
      if (pkgSelect) {
        const options = pkgSelect.querySelectorAll('option');
        options.forEach((opt) => {
          if (opt.value === packageParam) {
            opt.selected = true;
          }
        });
      }
    }

    // Auto-fill template
    if (templateParam) {
      const templateInput = document.getElementById('template');
      if (templateInput) {
        templateInput.value = templateParam;
      }
      const infoBox = document.getElementById('selected-info');
      const nameSpan = document.getElementById('selected-template-name');
      if (infoBox && nameSpan) {
        nameSpan.textContent = templateParam;
        infoBox.classList.remove('hidden');
      }
    }

    // Form submit → WhatsApp
    const form = document.getElementById('order-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        if (fd.get('_hp')) return;

        const name = fd.get('name');
        const whatsapp = fd.get('whatsapp');
        const eventType = fd.get('eventType');
        const pkg = fd.get('package');
        const template = fd.get('template');
        const eventDate = fd.get('eventDate');
        const notes = fd.get('notes');

        const message = `Halo Acaranya.id, saya mau order undangan digital premium.

Nama Pemesan: ${name}
WhatsApp: ${whatsapp}
Jenis Acara: ${eventType}
Paket Pilihan: ${pkg}
Desain Pilihan: ${template || '-'}
Tanggal Acara: ${eventDate || '-'}
Catatan Desain: ${notes || '-'}`;

        const url = `https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`;
        window.open(url, '_blank');
      });
    }
  })();
</script>
