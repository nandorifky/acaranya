    <script define:vars={{ targetWaPhone: siteConfig.contact.whatsapp }}>
      const form = document.getElementById("reseller-application-form");
      if (form) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const fd = new FormData(form);
          const name = fd.get("fullName");
          const brand = fd.get("brandName");
          const wa = fd.get("whatsappNum");
          const category = fd.get("businessCategory");
          const portfolio = fd.get("portfolioLink");
          const quota = fd.get("initialQuota");

          const waMsg = `Halo Acaranya.id, saya telah mengisi formulir pendaftaran partner reseller di website. Berikut detail data saya:

📋 DATA PENDAFTARAN RESELLER B2B
------------------------------
• Nama Lengkap: ${name}
• Nama Brand / Vendor: ${brand}
• Nomor WhatsApp: ${wa}
• Bidang Usaha: ${category}
• Portofolio/Sosmed: ${portfolio}
• Deposit Paket Awal: ${quota}

Mohon panduan untuk tahap validasi onboarding dan pembuatan Kode Partner Unik saya. Terima kasih!`;

          const targetUrl = `https://wa.me/${targetWaPhone}?text=${encodeURIComponent(waMsg)}`;
          window.open(targetUrl, "_blank");
        });
      }
    </script>

    <!-- Client-side script for Interactive Profit Calculator -->
    <script>
      // State variables
      let currentQuota = 10;
      let currentInv = 500000;
      let currentUnit = 50000;

      const sellPriceInput = document.getElementById("sell-price-input");
      const outTotalInv = document.getElementById("out-total-inv");
      const outPerUnit = document.getElementById("out-per-unit");
      const outGrossRev = document.getElementById("out-gross-rev");
      const outNetProfit = document.getElementById("out-net-profit");
      const calcButtons = document.querySelectorAll(".calc-btn");

      function formatIDR(amount) {
        return "Rp " + amount.toLocaleString("id-ID");
      }

      function recalculate() {
        const sellPrice = parseInt(sellPriceInput.value) || 0;
        const grossRev = sellPrice * currentQuota;
        const netProfit = grossRev - currentInv;

        if (outTotalInv) outTotalInv.textContent = formatIDR(currentInv);
        if (outPerUnit) outPerUnit.textContent = formatIDR(currentUnit);
        if (outGrossRev) outGrossRev.textContent = formatIDR(grossRev);
        if (outNetProfit) outNetProfit.textContent = formatIDR(netProfit);
      }

      // Bind click to quota buttons
      calcButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          // Remove active classes
          calcButtons.forEach((b) => {
            b.classList.remove(
              "bg-brand-950",
              "text-cream",
              "border-brand-950",
            );
            b.classList.add(
              "bg-white",
              "text-brand-950",
              "border-[#B59A73]/20",
            );
          });

          // Add active classes to clicked
          btn.classList.add("bg-brand-950", "text-cream", "border-brand-950");
          btn.classList.remove(
            "bg-white",
            "text-brand-950",
            "border-[#B59A73]/20",
          );

          currentQuota = parseInt(btn.getAttribute("data-quota") || "10");
          currentInv = parseInt(btn.getAttribute("data-inv") || "500000");
          currentUnit = parseInt(btn.getAttribute("data-unit") || "50000");

          recalculate();
        });
      });

      // Bind input to price changes
      if (sellPriceInput) {
        sellPriceInput.addEventListener("input", recalculate);
      }

      // Run initial calculation on load
      recalculate();
    </script>
