---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Container from "../components/base/Container.astro";
import Section from "../components/base/Section.astro";
import Icon from "../components/ui/Icon.astro";
import { siteConfig } from "../data/site";
---

<MarketingLayout
  title="Program Reseller Undangan Digital & Kerjasama Partner Premium - Acaranya.id"
  description="Bergabunglah sebagai partner reseller undangan digital premium terbaik dengan Acaranya.id. Program kerjasama undangan digital B2B terlengkap dengan harga grosir flat murah khusus vendor."
>
  <!-- HERO SECTION: ULTRA-PREMIUM LUXURY LIGHT CREAM DESIGN -->
  <section
    class="relative pt-36 pb-28 lg:pt-48 lg:pb-40 bg-cream text-brand-950 overflow-hidden"
  >
    <!-- Glowing Gold Radial Gradients -->
    <div
      class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-[#B59A73]/10 blur-[120px] pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-[#B59A73]/5 blur-[100px] pointer-events-none"
    >
    </div>

    <!-- Fine Gold Grid BG -->
    <div
      class="absolute inset-0 opacity-[0.06] pointer-events-none"
      style="background-image: linear-gradient(to right, #B59A73 1px, transparent 1px), linear-gradient(to bottom, #B59A73 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <Container class="relative z-10">
      <div class="grid lg:grid-cols-12 gap-16 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-8 text-left">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#B59A73]/10 border border-[#B59A73]/30 text-[#B59A73] text-[10px] font-bold uppercase tracking-[0.2em] rounded-full shadow-sm"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#B59A73] animate-pulse"
            ></span>
            Eksklusif Partner Undangan Digital
          </span>

          <h1
            class="font-serif text-5xl sm:text-6xl lg:text-[4.5rem] text-brand-950 leading-[1.08] tracking-tight"
          >
            Lipat Gandakan Profit Bisnis Anda Bersama
            <br />
            <span
              class="italic font-normal text-[#B59A73] relative inline-block"
            >
              Reseller Undangan Digital
            </span>
          </h1>

          <p
            class="text-text-secondary text-base sm:text-lg max-w-xl font-sans tracking-wide leading-relaxed font-light"
          >
            Tingkatkan margin keuntungan paket layanan WO, Venue, Hotel,
            Katering, atau Studio Foto Anda lewat program <strong
              >kerjasama undangan digital</strong
            > premium. Nikmati kemudahan sistem jatah kuota harga flat grosir termurah
            tanpa repot operasional coding. 100% White-Label.
          </p>

          <!-- Highlights Badges -->
          <div class="grid grid-cols-3 gap-4 pt-2">
            <div
              class="p-4 bg-white/70 backdrop-blur-md border border-[#B59A73]/20 rounded-2xl space-y-1"
            >
              <span
                class="block text-[10px] text-[#B59A73] uppercase tracking-widest font-bold"
                >Harga Grosir</span
              >
              <span
                class="block font-serif text-lg sm:text-xl font-bold text-brand-950"
                >Rp 35K - 50K</span
              >
            </div>
            <div
              class="p-4 bg-white/70 backdrop-blur-md border border-[#B59A73]/20 rounded-2xl space-y-1"
            >
              <span
                class="block text-[10px] text-[#B59A73] uppercase tracking-widest font-bold"
                >Kemitraan</span
              >
              <span
                class="block font-serif text-lg sm:text-xl font-bold text-brand-950"
                >Kode Partner</span
              >
            </div>
            <div
              class="p-4 bg-white/70 backdrop-blur-md border border-[#B59A73]/20 rounded-2xl space-y-1"
            >
              <span
                class="block text-[10px] text-[#B59A73] uppercase tracking-widest font-bold"
                >watermark</span
              >
              <span
                class="block font-serif text-lg sm:text-xl font-bold text-[#2E7D32]"
                >Bebas Logo</span
              >
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <a
              href="#onboarding-form"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-brand-950 hover:bg-brand-900 text-cream text-[10px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-lg hover:scale-[1.02]"
            >
              Registrasi Partner Baru
            </a>
            <a
              href="#pricing-calculator"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-[#B59A73]/50 text-brand-950 text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-white/50 transition-all duration-300"
            >
              Simulasi Cuan Bisnis
            </a>
          </div>
        </div>

        <!-- Interactive Visual Dashboard Column -->
        <div class="lg:col-span-5 relative">
          <!-- Glassmorphic Dashboard Container -->
          <div
            class="relative bg-white/80 backdrop-blur-xl rounded-3xl border border-[#B59A73]/25 p-6 sm:p-8 shadow-2xl space-y-6"
          >
            <div
              class="flex items-center justify-between border-b border-[#B59A73]/15 pb-4"
            >
              <div class="flex items-center gap-2">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#B59A73] inline-block animate-pulse"
                ></span>
                <span
                  class="text-[9px] text-[#B59A73] font-sans tracking-widest font-bold uppercase"
                  >SISTEM INTEGRASI KODE PARTNER</span
                >
              </div>
            </div>

            <!-- Inside Stats Info -->
            <div class="space-y-4 text-xs font-sans">
              <div
                class="p-4 bg-cream/40 border border-[#B59A73]/10 rounded-2xl flex items-center justify-between"
              >
                <div>
                  <span
                    class="block text-[8px] text-[#B59A73] uppercase tracking-wider font-bold"
                    >Partner Unique Code</span
                  >
                  <span
                    class="block font-serif text-sm font-bold text-brand-950"
                    >WO-SBY-ANNA</span
                  >
                </div>
                <span
                  class="px-3 py-1 bg-green-50 text-green-700 border border-green-200 text-[8px] font-bold uppercase tracking-wider rounded-full"
                  >Active</span
                >
              </div>

              <!-- Live activity simulation -->
              <div class="space-y-3">
                <span
                  class="block text-[8px] text-[#B59A73] uppercase tracking-wider font-bold"
                  >Log Pemotongan Saldo Kuota</span
                >
                <div class="space-y-2 text-[10px] text-text-secondary">
                  <div
                    class="p-3 bg-white border border-[#B59A73]/10 rounded-xl flex items-center justify-between shadow-xs"
                  >
                    <span>Pernikahan (Sarah & Rian)</span>
                    <span class="text-green-700 font-bold">-1 Kredit</span>
                  </div>
                  <div
                    class="p-3 bg-white border border-[#B59A73]/10 rounded-xl flex items-center justify-between shadow-xs"
                  >
                    <span>Aqiqah (Syukuran Muhammad)</span>
                    <span class="text-green-700 font-bold">-1 Kredit</span>
                  </div>
                </div>
              </div>

              <!-- Financial Box -->
              <div
                class="pt-4 border-t border-[#B59A73]/15 flex items-center justify-between"
              >
                <div>
                  <span
                    class="block text-[8px] text-[#B59A73] uppercase tracking-wider font-bold"
                    >Akumulasi Cuan Bersih</span
                  >
                  <span
                    class="block font-serif text-lg font-bold text-[#2E7D32]"
                    >Rp 1.980.000</span
                  >
                </div>
                <div class="text-right">
                  <span
                    class="block text-[8px] text-[#B59A73] uppercase tracking-wider font-bold"
                    >Sisa Kuota Bundling</span
                  >
                  <span
                    class="block font-serif text-sm font-bold text-brand-950"
                    >18 / 20 Kredit</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- SIAPA SAJA MITRA KAMI? (SECTION 2): EDITORIAL LIGHT MINIMALIST DESIGN -->
  <Section bg="white" class="border-b border-border-soft/60 relative">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-20">
        <span
          class="text-[10px] font-bold uppercase tracking-widest text-[#B59A73]"
          >Kerjasama Undangan Digital</span
        >
        <h2
          class="font-serif text-3xl sm:text-5xl text-brand-950 tracking-tight leading-tight"
        >
          Program Kerjasama Undangan Digital Khusus Vendor
        </h2>
        <p
          class="text-text-secondary text-base sm:text-lg font-sans tracking-wide leading-relaxed max-w-xl mx-auto font-light"
        >
          Kami memetakan skema <strong>partner undangan digital</strong> premium yang
          disesuaikan secara presisi dengan model bisnis Anda masing-masing agar mudah
          diintegrasikan.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        <!-- WO -->
        <div
          class="p-8 bg-cream/10 border border-[#B59A73]/15 hover:border-[#B59A73] rounded-2xl space-y-6 hover:shadow-xl transition-all duration-500 group relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-[#B59A73]/5 rounded-bl-full pointer-events-none transition-all group-hover:bg-[#B59A73]/10"
          >
          </div>
          <div
            class="w-12 h-12 rounded-xl bg-white border border-[#B59A73]/20 text-[#B59A73] flex items-center justify-center shadow-xs"
          >
            <Icon name="heart" size={18} />
          </div>
          <div class="space-y-2">
            <h4 class="font-serif text-xl sm:text-2xl font-bold text-brand-950">
              Wedding Organizer
            </h4>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-sans font-light"
            >
              Jadikan paket <strong>reseller undangan digital</strong> premium sebagai
              bonus eksklusif bernilai tinggi di dalam paket WO Anda. Hemat pengeluaran
              cetak & mudahkan RSVP tamu secara modern.
            </p>
          </div>
        </div>

        <!-- Venue/Hotel -->
        <div
          class="p-8 bg-cream/10 border border-[#B59A73]/15 hover:border-[#B59A73] rounded-2xl space-y-6 hover:shadow-xl transition-all duration-500 group relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-[#B59A73]/5 rounded-bl-full pointer-events-none transition-all group-hover:bg-[#B59A73]/10"
          >
          </div>
          <div
            class="w-12 h-12 rounded-xl bg-white border border-[#B59A73]/20 text-[#B59A73] flex items-center justify-center shadow-xs"
          >
            <Icon name="building" size={18} />
          </div>
          <div class="space-y-2">
            <h4 class="font-serif text-xl sm:text-2xl font-bold text-brand-950">
              Venue & Hotel
            </h4>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-sans font-light"
            >
              Tingkatkan daya tarik banquet package Anda. Tawarkan complimentary
              undangan digital premium yang sudah tersinkronisasi otomatis
              dengan peta lokasi venue Anda.
            </p>
          </div>
        </div>

        <!-- Studio Foto -->
        <div
          class="p-8 bg-cream/10 border border-[#B59A73]/15 hover:border-[#B59A73] rounded-2xl space-y-6 hover:shadow-xl transition-all duration-500 group relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-[#B59A73]/5 rounded-bl-full pointer-events-none transition-all group-hover:bg-[#B59A73]/10"
          >
          </div>
          <div
            class="w-12 h-12 rounded-xl bg-white border border-[#B59A73]/20 text-[#B59A73] flex items-center justify-center shadow-xs"
          >
            <Icon name="image" size={18} />
          </div>
          <div class="space-y-2">
            <h4 class="font-serif text-xl sm:text-2xl font-bold text-brand-950">
              Studio Foto & Video
            </h4>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-sans font-light"
            >
              Optimalkan hasil karya prewedding/event Anda. Tampilkan galeri
              foto & video beresolusi tinggi langsung di undangan digital
              premium klien tanpa menurunkan kompresi gambar.
            </p>
          </div>
        </div>

        <!-- Catering -->
        <div
          class="p-8 bg-cream/10 border border-[#B59A73]/15 hover:border-[#B59A73] rounded-2xl space-y-6 hover:shadow-xl transition-all duration-500 group relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-[#B59A73]/5 rounded-bl-full pointer-events-none transition-all group-hover:bg-[#B59A73]/10"
          >
          </div>
          <div
            class="w-12 h-12 rounded-xl bg-white border border-[#B59A73]/20 text-[#B59A73] flex items-center justify-center shadow-xs"
          >
            <Icon name="sparkles" size={18} />
          </div>
          <div class="space-y-2">
            <h4 class="font-serif text-xl sm:text-2xl font-bold text-brand-950">
              Catering & Restaurant
            </h4>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-sans font-light"
            >
              Miliki jangkauan pemasaran sekunder. Integrasikan menu hidangan
              khusus, rundown syukuran, dan petunjuk kehadiran tamu dengan
              elegant di undangan acara digital klien.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- SKEMA KERJASAMA DETAIL (SECTION 3): LUXURY COLUMN LIST LAYOUT -->
  <Section bg="cream" class="border-b border-border-soft/60">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-20">
        <span
          class="text-[10px] font-bold uppercase tracking-widest text-[#B59A73]"
          >Alur & Regulasi Kemitraan</span
        >
        <h2
          class="font-serif text-3xl sm:text-5xl text-brand-950 tracking-tight leading-tight"
        >
          Mekanisme Bisnis Tanpa Hambatan
        </h2>
        <p
          class="text-text-secondary text-base sm:text-lg font-sans tracking-wide leading-relaxed max-w-xl mx-auto font-light"
        >
          Kami percaya pada transparansi mutlak. Berikut adalah detail cara
          kuota bundling, validasi vendor, dan penyesuaian harga grosir kami
          bekerja untuk Anda.
        </p>
      </div>

      <div class="max-w-5xl mx-auto space-y-8 font-sans text-xs">
        <!-- Row 1 -->
        <div
          class="grid lg:grid-cols-12 gap-8 bg-white p-8 rounded-3xl border border-[#B59A73]/15 items-center shadow-xs"
        >
          <div class="lg:col-span-5 space-y-2.5">
            <span
              class="w-7 h-7 rounded-lg bg-[#B59A73]/10 text-[#B59A73] text-[10px] font-bold flex items-center justify-center font-serif"
              >01</span
            >
            <h3 class="font-serif text-xl font-bold text-brand-950">
              Sistem Kuota Bundling & Pembayaran
            </h3>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-light"
            >
              Membeli kuota di awal berarti Anda mendapatkan hak istimewa harga
              grosir. Kuota ini berbentuk "kredit saldo" digital di database
              kami.
            </p>
          </div>
          <div
            class="lg:col-span-7 border-t lg:border-t-0 lg:border-l border-border-soft/60 pt-6 lg:pt-0 lg:pl-8 space-y-2.5 text-text-secondary font-light"
          >
            <ul
              class="space-y-2.5 list-disc pl-4 leading-relaxed text-[13px] sm:text-[14px]"
            >
              <li>
                <strong>Deposit Fleksibel:</strong> Anda dapat memulai dengan deposit
                minimum jatah 10 undangan seharga Rp 500.000.
              </li>
              <li>
                <strong>Potong Kredit Otomatis:</strong> Setiap kali ada klien baru
                Anda yang mengirimkan form order dengan kode unik Anda, kuota dipotong
                1 secara otomatis.
              </li>
              <li>
                <strong>Tanpa Kadaluarsa:</strong> Kredit Anda tersimpan aman dan
                tidak akan hangus selamanya.
              </li>
              <li>
                <strong>Notifikasi Top-Up:</strong> Pengingat WhatsApp otomatis saat
                sisa kuota Anda mencapai 2 kredit.
              </li>
            </ul>
          </div>
        </div>

        <!-- Row 2 -->
        <div
          class="grid lg:grid-cols-12 gap-8 bg-white p-8 rounded-3xl border border-[#B59A73]/15 items-center shadow-xs"
        >
          <div class="lg:col-span-5 space-y-2.5">
            <span
              class="w-7 h-7 rounded-lg bg-[#B59A73]/10 text-[#B59A73] text-[10px] font-bold flex items-center justify-center font-serif"
              >02</span
            >
            <h3 class="font-serif text-xl font-bold text-brand-950">
              Penentuan Harga & Margin Keuntungan
            </h3>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-light"
            >
              Kendalikan penuh keuangan bisnis Anda. Kami memberikan harga flat
              yang sangat murah agar Anda dapat menentukan margin secara
              fleksibel.
            </p>
          </div>
          <div
            class="lg:col-span-7 border-t lg:border-t-0 lg:border-l border-border-soft/60 pt-6 lg:pt-0 lg:pl-8 space-y-2.5 text-text-secondary font-light"
          >
            <div class="grid sm:grid-cols-2 gap-4 text-[12px] sm:text-[13px]">
              <div
                class="p-4 bg-cream/30 rounded-xl space-y-1.5 border border-[#B59A73]/10"
              >
                <span class="font-serif font-bold text-brand-950 block"
                  >Opsi A: Bundling Package (Bonus)</span
                >
                <p class="leading-relaxed font-light">
                  Masukkan undangan digital sebagai bonus wajib di dalam brosur
                  paket WO Anda. Secara psikologis, klien merasa paket Anda jauh
                  lebih komplit.
                </p>
              </div>
              <div
                class="p-4 bg-cream/30 rounded-xl space-y-1.5 border border-[#B59A73]/10"
              >
                <span class="font-serif font-bold text-brand-950 block"
                  >Opsi B: Upselling / Resell Ritel</span
                >
                <p class="leading-relaxed font-light">
                  Jual undangan digital secara terpisah dengan harga normal
                  ritel (misal Rp 150.000). Anda langsung mengantongi untung
                  bersih Rp 100.000 (Margin 200%) per transaksi!
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 3 -->
        <div
          class="grid lg:grid-cols-12 gap-8 bg-white p-8 rounded-3xl border border-[#B59A73]/15 items-center shadow-xs"
        >
          <div class="lg:col-span-5 space-y-2.5">
            <span
              class="w-7 h-7 rounded-lg bg-[#B59A73]/10 text-[#B59A73] text-[10px] font-bold flex items-center justify-center font-serif"
              >03</span
            >
            <h3 class="font-serif text-xl font-bold text-brand-950">
              Verifikasi Kelayakan Partner
            </h3>
            <p
              class="text-[13px] sm:text-[14px] text-text-secondary leading-relaxed font-light"
            >
              Kami membatasi keanggotaan ini hanya untuk vendor riil aktif demi
              menjaga eksklusivitas margin harga grosir agar tidak
              disalahgunakan konsumen ritel biasa.
            </p>
          </div>
          <div
            class="lg:col-span-7 border-t lg:border-t-0 lg:border-l border-border-soft/60 pt-6 lg:pt-0 lg:pl-8 space-y-2.5 text-text-secondary font-light"
          >
            <ul
              class="space-y-2.5 list-disc pl-4 leading-relaxed text-[13px] sm:text-[14px]"
            >
              <li>
                <strong>Verifikasi Dokumen Usaha / Portofolio:</strong> Partner wajib
                mencantumkan tautan Instagram bisnis aktif, portofolio wedding, atau
                alamat fisik kantor/lokasi usaha saat mendaftar.
              </li>
              <li>
                <strong>Review Tim Admin:</strong> Tim internal Acaranya.id akan memvalidasi
                data Anda dalam waktu 5-10 menit.
              </li>
              <li>
                <strong>Alokasi Kode Partner Unik:</strong> Setelah terverifikasi,
                kode referal unik khusus Anda akan diaktifkan secara global di seluruh
                database form order kami.
              </li>
              <li>
                <strong>Hak Blokir Penyalahgunaan:</strong> Kami berhak membekukan
                kuota partner jika terbukti menjual di bawah harga flat dasar ke konsumen
                ritel bebas secara merugikan.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- INTERACTIVE PRICING CALCULATOR (SECTION 4): DOCK COMPONENT DESIGN -->
  <Section id="pricing-calculator" bg="white" class="relative overflow-hidden">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-20">
        <span
          class="text-[10px] font-bold uppercase tracking-widest text-[#B59A73]"
          >Kalkulator Simulasi Keuntungan</span
        >
        <h2
          class="font-serif text-3xl sm:text-5xl text-brand-950 tracking-tight leading-tight"
        >
          Proyeksi Laba Bersih Dinamis
        </h2>
        <p
          class="text-text-secondary text-base sm:text-lg font-sans tracking-wide leading-relaxed max-w-xl mx-auto font-light"
        >
          Geser atau pilih paket kuota untuk melihat kalkulasi detail investasi,
          penghematan modal, dan proyeksi margin laba bersih yang Anda peroleh
          secara dinamis.
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid lg:grid-cols-12 gap-12 items-stretch">
        <!-- Interactive Controls -->
        <div
          class="lg:col-span-7 space-y-8 font-sans bg-cream/25 p-8 sm:p-10 border border-[#B59A73]/20 rounded-3xl flex flex-col justify-between"
        >
          <div class="space-y-4">
            <label
              class="block text-xs font-bold uppercase tracking-wider text-brand-950"
              >Pilih Jumlah Kuota Undangan:</label
            >
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button
                data-quota="10"
                data-inv="500000"
                data-unit="50000"
                id="btn-q-10"
                class="calc-btn py-3 px-3 bg-brand-950 text-cream border border-brand-950 font-bold rounded-xl text-center text-xs transition-all shadow-sm"
              >
                10 Kuota
              </button>
              <button
                data-quota="30"
                data-inv="1350000"
                data-unit="45000"
                id="btn-q-30"
                class="calc-btn py-3 px-3 bg-white text-brand-950 border border-[#B59A73]/20 hover:border-[#B59A73] font-bold rounded-xl text-center text-xs transition-all shadow-xs"
              >
                30 Kuota
              </button>
              <button
                data-quota="50"
                data-inv="2000000"
                data-unit="40000"
                id="btn-q-50"
