---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Container from "../../components/base/Container.astro";
import Section from "../../components/base/Section.astro";
import Icon from "../../components/ui/Icon.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import { getCollection, render, getEntry } from "astro:content";
import { siteConfig } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const published = posts
    .filter((p) => p.data.status === "published")
    .sort((a, b) => {
      const dateA = a.data.updatedAt || a.data.publishedAt;
      const dateB = b.data.updatedAt || b.data.publishedAt;
      return dateB.getTime() - dateA.getTime();
    });

  return published.map((post, index) => {
    const prevPost = index < published.length - 1 ? published[index + 1] : null;
    const nextPost = index > 0 ? published[index - 1] : null;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection("blog");
const publishedPosts = allPosts.filter((p) => p.data.status === "published");
const validTagSet = new Set<string>();
const tagCounts = new Map<string, number>();
publishedPosts.forEach((p) => {
  p.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1));
});
tagCounts.forEach((count, tag) => {
  if (count > 1 && /^[a-z0-9-]+$/.test(tag)) validTagSet.add(tag);
});

// Fetch author data
const authorEntry = await getEntry("authors", post.data.author);
const authorName = authorEntry ? authorEntry.data.name : post.data.author;
const authorSlug = authorEntry ? authorEntry.id : "#";

const publishedDate = post.data.publishedAt.toISOString();
const hasSubstantialUpdate = post.data.updatedAt
  ? post.data.updatedAt.getTime() - post.data.publishedAt.getTime() >= 7 * 24 * 60 * 60 * 1000
  : false;
const modifiedDate = hasSubstantialUpdate && post.data.updatedAt
  ? post.data.updatedAt.toISOString()
  : publishedDate;
const publishedDisplay = post.data.publishedAt.toLocaleDateString("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const modifiedDisplay = hasSubstantialUpdate && post.data.updatedAt
  ? post.data.updatedAt.toLocaleDateString("id-ID", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;

const canonicalUrl = new URL(
  post.data.canonicalUrl || `/artikel/${post.id}/`,
  siteConfig.url,
).toString();
const pageTitle = post.data.seoTitle || post.data.title;
const robots = post.data.noindex ? "noindex,nofollow" : "index,follow";
const featuredImage = post.data.image;
const featuredImageUrl = featuredImage
  ? new URL(featuredImage, siteConfig.url).toString()
  : new URL(siteConfig.branding.ogImage, siteConfig.url).toString();

const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(canonicalUrl);
const shareText = encodeURIComponent(
  `${post.data.title} — ${post.data.description}`,
);

// JSON-LD Article schema
const isNews = post.data.tags?.includes("news");
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": isNews ? "NewsArticle" : "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: publishedDate,
    dateModified: modifiedDate,
    author: {
      "@type": "Person",
      name: authorName,
      url: authorEntry
        ? `${siteConfig.url}/penulis/${authorEntry.id}/`
        : undefined,
    },
    publisher: {
      "@id": `${siteConfig.url}/#organization`,
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    image: [featuredImageUrl],
    keywords: post.data.tags.join(", "),
    articleSection: post.data.category,
    inLanguage: "id-ID",
    wordCount,
  },
];
---

<MarketingLayout
  title={pageTitle}
  description={post.data.description}
  ogImage={featuredImageUrl}
  ogImageAlt={post.data.imageAlt || post.data.title}
  type="article"
  canonical={canonicalUrl}
  robots={robots}
  jsonLd={jsonLd}
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
  authorName={authorName}
  section={post.data.category}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Artikel", href: "/artikel/" },
    { label: post.data.customBreadcrumbLabel || post.data.title },
  ]}
>
  <article>
    <!-- Featured Image -->
    {
      featuredImage && (
        <section class="bg-cream pt-6 pb-0 lg:pt-8">
          <Container narrow>
            <figure>
              <div class="aspect-[2/1] sm:aspect-[21/9] overflow-hidden rounded-sm">
                <img
                  src={featuredImage}
                  alt={post.data.imageAlt || post.data.title}
                  width="1200"
                  height="630"
                  class="w-full h-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
              {post.data.imageCaption && (
                <figcaption class="text-center text-[11px] text-text-muted mt-2 italic">
                  {post.data.imageCaption}
                </figcaption>
              )}
            </figure>
          </Container>
        </section>
      )
    }

    <!-- Article Header -->
    <section
      class:list={[
        "pt-6 pb-4 lg:pt-8 lg:pb-6",
        featuredImage ? "bg-cream" : "bg-cream pt-8 lg:pt-12",
      ]}
    >
      <Container narrow>
        <header class="max-w-2xl">
          <!-- Category & Date -->
          <div class="flex items-center gap-2 mb-3">
            <span
              class="text-[11px] text-champagne font-semibold uppercase tracking-[0.2em]"
            >
              {post.data.category}
            </span>
            <span class="text-text-muted/30">·</span>
            <time datetime={publishedDate} class="text-[12px] text-text-muted">
              {publishedDisplay}
            </time>
          </div>

          <!-- Title -->
          <h1
            class="font-serif text-[1.75rem] sm:text-[2.25rem] lg:text-[2.5rem] font-semibold text-text-primary leading-[1.15] mb-4"
          >
            {post.data.title}
          </h1>

          <!-- Description -->
          <p class="text-text-secondary text-[15px] leading-relaxed mb-5">
            {post.data.description}
          </p>

          <!-- Author + Updated -->
          <div
            class="flex items-center justify-between flex-wrap gap-3 pb-5 border-b border-border-soft/60"
          >
            <div class="flex items-center gap-3">
              <a
                href={`/penulis/${authorSlug}/`}
                class="flex items-center gap-3 group"
              >
                <div
                  class="w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center overflow-hidden"
                >
                  {
                    authorEntry?.data.avatar ? (
                      <img
                        src={authorEntry.data.avatar}
                        alt=""
                        width="128"
                        height="128"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Icon name="user" size={16} class="text-brand-500" />
                    )
                  }
                </div>
                <div>
                  <p
                    class="text-sm font-medium text-text-primary group-hover:text-brand-500 transition-colors"
                  >
                    {authorName}
                  </p>
                  <p class="text-[11px] text-text-muted">
                    {authorEntry?.data.role || siteConfig.name}
                  </p>
                </div>
              </a>
            </div>
            {
              modifiedDisplay && (
                <p class="text-[11px] text-text-muted flex items-center gap-1">
                  <Icon name="refresh-cw" size={11} />
                  Diperbarui {modifiedDisplay}
                </p>
              )
            }
          </div>
        </header>
      </Container>
    </section>

    <!-- Article Body -->
    <Section bg="white">
      <Container narrow>
        <div class="max-w-2xl">
          <!-- Table of Contents -->
          <TableOfContents headings={headings} />

          <!-- Contextual Inline CTA (Dofollow) -->
          {
            post.data.ctaText && post.data.ctaUrl && (
              <div class="my-6 p-4 sm:p-5 bg-surface-muted/60 border-l-2 border-[#B59A73] rounded-r-md transition-all duration-300 hover:bg-surface-muted/90 group">
                <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#B59A73] mb-1 select-none">
                  Rekomendasi Editor:
                </span>
                <a
                  href={post.data.ctaUrl}
                  class="font-serif text-[15px] sm:text-[16px] font-bold text-brand-950 hover:text-soft-gold transition-colors inline-flex items-center gap-1.5 leading-relaxed"
                >
                  <span class="underline decoration-border-strong group-hover:decoration-champagne transition-colors underline-offset-4 decoration-1">
                    {post.data.ctaText}
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={14}
                    class="text-[#B59A73] transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300 shrink-0"
                  />
                </a>
              </div>
            )
          }

          <!-- Content -->
          <div class="prose max-w-none">
            <Content />
          </div>

          <!-- Tags -->
          {
            post.data.tags.length > 0 && (
              <div class="mt-10 pt-6 border-t border-border-soft/60">
                <div class="flex items-center gap-2 flex-wrap">
                  <Icon name="tag" size={14} class="text-text-muted" />
                  {post.data.tags.map((tag) => validTagSet.has(tag) ? (
                    <a href={`/artikel/tag/${tag}/`} class="text-[12px] text-text-muted bg-surface-muted px-2.5 py-1 rounded-sm capitalize hover:bg-brand-50 hover:text-brand-500 transition-colors">
                      {tag}
                    </a>
                  ) : (
                    <span class="text-[12px] text-text-muted bg-surface-muted px-2.5 py-1 rounded-sm capitalize">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Share -->
          <div class="mt-8 pt-8 border-t border-border-soft/60">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.15em] text-text-muted mb-4"
            >
              Bagikan artikel
            </p>
            <div class="flex items-center gap-3">
              <a
                href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all duration-300"
                aria-label="Share di WhatsApp"
              >
                <Icon name="whatsapp" size={18} />
              </a>
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-[#1877F2]/10 text-[#1877F2] hover:bg-[#1877F2] hover:text-white transition-all duration-300"
                aria-label="Share di Facebook"
              >
                <Icon name="facebook" size={18} />
              </a>
              <a
                href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-[#26A5E4]/10 text-[#26A5E4] hover:bg-[#26A5E4] hover:text-white transition-all duration-300"
                aria-label="Share di Telegram"
              >
                <Icon name="brand-telegram" size={18} />
              </a>
              <a
                href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-brand-950/5 text-brand-950 hover:bg-brand-950 hover:text-white transition-all duration-300"
                aria-label="Share di X"
              >
                <Icon name="brand-x" size={16} />
              </a>
              <button
                id="copy-url-btn"
                type="button"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-muted text-text-muted hover:bg-brand-950 hover:text-white transition-all duration-300"
                aria-label="Salin link"
              >
                <Icon name="copy" size={18} />
              </button>
            </div>
          </div>

          <!-- Prev / Next Navigation -->
          {
            (prevPost || nextPost) && (
              <div class="mt-12 pt-10 border-t border-border-soft/60 grid sm:grid-cols-2 gap-6">
                <div class="group">
                  {prevPost && (
                    <a
                      href={`/artikel/${prevPost.id}/`}
                      class="flex flex-col gap-2 h-full p-6 bg-cream border border-border-soft rounded-sm hover:border-brand-500 transition-all"
                    >
                      <span class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">
                        <Icon name="arrow-left" size={10} /> Sebelumnya
                      </span>
                      <p class="font-serif text-sm font-semibold text-brand-950 group-hover:text-brand-500 transition-colors line-clamp-2 leading-relaxed">
                        {prevPost.data.title}
                      </p>
                    </a>
                  )}
                </div>
                <div class="group text-right">
                  {nextPost && (
                    <a
                      href={`/artikel/${nextPost.id}/`}
                      class="flex flex-col gap-2 h-full p-6 bg-cream border border-border-soft rounded-sm hover:border-brand-500 transition-all"
                    >
                      <span class="flex items-center justify-end gap-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">
                        Selanjutnya <Icon name="arrow-right" size={10} />
                      </span>
                      <p class="font-serif text-sm font-semibold text-brand-950 group-hover:text-brand-500 transition-colors line-clamp-2 leading-relaxed">
                        {nextPost.data.title}
                      </p>
                    </a>
                  )}
                </div>
              </div>
            )
          }

          <!-- CTA -->
          <div class="mt-14 p-7 bg-cream border border-border-soft text-center">
            <h3 class="font-serif text-xl font-semibold text-text-primary mb-2">
              Tertarik Membuat Undangan Digital?
            </h3>
            <p class="text-sm text-text-muted mb-5">
              Percayakan kebutuhan undangan digital dengan Acaranya.id, temukan
              berbagai desain undangan digital terbaik untuk acara Anda.
            </p>
            <a
              href="/desain-undangan-digital/"
              class="inline-flex items-center gap-2 px-6 py-3 bg-brand-900 text-white text-[13px] font-medium uppercase tracking-wider rounded-sm hover:bg-brand-950 transition-colors"
            >
              Lihat Desain
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </Container>
    </Section>
  </article>
</MarketingLayout>

<script>
  const copyBtn = document.getElementById("copy-url-btn");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
        copyBtn.classList.add("!bg-[#B59A73]", "!text-white");
        setTimeout(() => {
          copyBtn.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
          copyBtn.classList.remove("!bg-[#B59A73]", "!text-white");
        }, 2000);
      } catch (e) {
        /* noop */
      }
    });
  }
</script>
