---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import Container from "../../components/base/Container.astro";
import Section from "../../components/base/Section.astro";
import SectionHeader from "../../components/base/SectionHeader.astro";
import Icon from "../../components/ui/Icon.astro";
import Pagination from "../../components/ui/Pagination.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { getCollection } from "astro:content";
import slugify from "slugify";

export async function getStaticPaths({ paginate }: any) {
  const allPosts = await getCollection("blog");

  const publishedPosts = allPosts
    .filter((p) => p.data.status === "published")
    .sort(
      (a, b) =>
        b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
        a.id.localeCompare(b.id),
    );

  return paginate(publishedPosts, { pageSize: 18 });
}

const { page } = Astro.props;
const publishedPosts = page.data;

const taxonomyEntries = await getCollection("blogTaxonomy");
const categories = taxonomyEntries.flatMap((entry) => entry.data.categories);

const titleSuffix =
  page.currentPage > 1 ? ` — Halaman ${page.currentPage}` : "";
const robots = page.currentPage > 1 ? "noindex,follow" : "index,follow";
---

<MarketingLayout
  title={`Artikel — Inspirasi dan Tips Undangan Digital${titleSuffix}`}
  description="Inspirasi, tips, dan panduan seputar undangan digital dari Acaranya.id."
  robots={robots}
>
  <section class="pt-8 pb-6 lg:pt-12 lg:pb-8 bg-cream">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeader
          as="h1"
          eyebrow="Artikel"
          title="Inspirasi & Tips Undangan Digital"
          subtitle="Artikel, tips, dan panduan untuk membantu kamu membuat undangan digital terbaik."
        />
        {
          categories.length > 0 && (
            <nav
              class="flex flex-wrap items-center justify-center gap-2 pt-6"
              aria-label="Kategori artikel"
            >
              {categories.map((category: any) => (
                <a
                  href={`/artikel/kategori/${slugify(category.value, { lower: true, strict: true })}/`}
                  class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-text-secondary bg-white border border-border-soft rounded-full hover:border-soft-gold hover:text-soft-gold transition-colors"
                >
                  {category.title}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </Container>
  </section>

  <Section bg="white">
    <Container>
      {
        publishedPosts.length > 0 ? (
          <>
            <h2 class="sr-only">Inspirasi &amp; Tips Undangan Digital Terbaru</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
              {publishedPosts.map((post: any) => (
                <BlogCard post={post} />
              ))}
            </div>

            <Pagination page={page} baseUrl="/artikel/" />
          </>
        ) : (
          <div class="text-center py-20">
            <div class="w-14 h-14 rounded-full bg-brand-50 border border-brand-100 flex items-center justify-center mx-auto mb-5">
              <Icon name="pen-line" size={24} class="text-brand-400" />
            </div>
            <h3 class="font-serif text-xl font-semibold text-text-primary mb-2">
              Artikel segera hadir
            </h3>
            <p class="text-text-muted text-sm">
              Kami sedang menyiapkan konten inspiratif untuk kamu.
            </p>
          </div>
        )
      }
    </Container>
  </Section>
</MarketingLayout>
