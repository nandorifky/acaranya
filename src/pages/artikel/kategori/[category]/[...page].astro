---
import MarketingLayout from '../../../../layouts/MarketingLayout.astro';
import Container from '../../../../components/base/Container.astro';
import Section from '../../../../components/base/Section.astro';
import Icon from '../../../../components/ui/Icon.astro';
import Pagination from '../../../../components/ui/Pagination.astro';
import BlogCard from '../../../../components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import slugify from 'slugify';
import { siteConfig } from '../../../../data/site';

export async function getStaticPaths({ paginate }: any) {
  const [taxonomy] = await getCollection('blogTaxonomy');
  const categories = taxonomy?.data.categories ?? [];
  const allPosts = await getCollection('blog');
  const published = allPosts.filter((p) => p.data.status === 'published');

  return categories.flatMap((category: any) => {
    const posts = published
      .filter((p) => p.data.category === category.value)
      .sort(
        (a, b) =>
          b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
          a.id.localeCompare(b.id),
      );

    return paginate(posts, {
      params: { category: slugify(category.value, { lower: true, strict: true }) },
      props: { category },
      pageSize: 24,
    });
  });
}

const { page, category } = Astro.props;
const categorySlug = slugify(category.value, { lower: true, strict: true });
const baseUrl = `/artikel/kategori/${categorySlug}/`;
const titleSuffix = page.currentPage > 1 ? ` — Halaman ${page.currentPage}` : '';
const robots =
  page.currentPage > 1 || page.total < 3 ? 'noindex,follow' : 'index,follow';

const canonicalUrl = new URL(page.url.current, siteConfig.url).toString();
const description =
  category.description ||
  `Kumpulan artikel kategori ${category.title} dari Acaranya.id.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalUrl}#collection`,
    name: `Artikel Kategori ${category.title}`,
    description,
    url: canonicalUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: page.total,
    itemListElement: page.data.map((post: any, index: number) => ({
      '@type': 'ListItem',
      position: page.start + index + 1,
      name: post.data.title,
      url: `${siteConfig.url}/artikel/${post.data.customSlug || post.id}/`,
    })),
  },
];
---

<MarketingLayout
  title={`Artikel Kategori ${category.title}${titleSuffix}`}
  description={description}
  robots={robots}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: 'Beranda', href: '/' },
    { label: 'Artikel', href: '/artikel/' },
    { label: category.title },
  ]}
>
  <section class="pt-8 pb-6 lg:pt-12 lg:pb-8 bg-cream">
    <Container>
      <div class="max-w-3xl">
        <a
          href="/artikel/"
          class="text-[12px] text-text-muted hover:text-brand-500 transition-colors inline-flex items-center gap-1 mb-4"
        >
          <Icon name="arrow-right" size={12} class="rotate-180" /> Semua Artikel
        </a>
        <h1
          class="font-serif text-[1.75rem] sm:text-[2.25rem] font-semibold text-text-primary leading-tight mb-3"
        >
          Artikel Kategori {category.title}
        </h1>
        <p class="text-[15px] text-text-secondary leading-relaxed mb-2">{description}</p>
        <p class="text-[12px] text-text-muted">{page.total} artikel</p>
      </div>
    </Container>
  </section>

  <Section bg="white">
    <Container>
      {
        page.data.length > 0 ? (
          <>
            <h2 class="sr-only">Daftar Artikel Kategori {category.title}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
              {page.data.map((post: any) => (
                <BlogCard post={post} />
              ))}
            </div>
            <Pagination page={page} baseUrl={baseUrl} />
          </>
        ) : (
          <div class="text-center py-20">
            <h2 class="font-serif text-xl font-semibold text-text-primary mb-2">
              Belum ada artikel
            </h2>
            <p class="text-text-muted text-sm">
              Artikel untuk kategori ini sedang kami siapkan.
            </p>
          </div>
        )
      }
    </Container>
  </Section>
</MarketingLayout>
