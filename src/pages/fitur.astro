---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Container from '../components/base/Container.astro';
import Section from '../components/base/Section.astro';
import Icon from '../components/ui/Icon.astro';

const features = [
  { num: '01', title: 'Unlimited Tamu', desc: 'Tidak ada batasan jumlah tamu yang bisa diundang. Bagikan ke semua kerabat Anda tanpa khawatir.' },
  { num: '02', title: 'Google Maps Interaktif', desc: 'Tampilkan lokasi acara dengan koordinat presisi dan tombol rute sekali klik untuk memudahkan tamu.' },
  { num: '03', title: 'Konfirmasi RSVP Otomatis', desc: 'Tamu dapat melakukan konfirmasi kehadiran secara online yang terdata langsung pada dashboard Anda.' },
  { num: '04', title: 'Kolom Ucapan & Doa', desc: 'Sediakan tempat khusus bagi para tamu undangan untuk memberikan ucapan selamat dan doa terbaik secara langsung.' },
  { num: '05', title: 'QR Code Check-in', desc: 'Sistem check-in tamu undangan yang modern menggunakan pemindaian kode QR yang cepat di lokasi acara.' },
  { num: '06', title: 'Buku Tamu Digital', desc: 'Catatan daftar hadir tamu yang tersusun dengan rapi, otomatis, dan dapat diunduh kapan saja Anda butuhkan.' },
  { num: '07', title: 'Amplop Digital (e-Gift)', desc: 'Memudahkan tamu mengirim kado pernikahan atau sumbangan tunai secara digital langsung ke rekening Anda.' },
  { num: '08', title: 'Galeri Foto Premium', desc: 'Tampilkan foto-foto pre-wedding terbaik Anda dalam kolase galeri bertata letak editorial yang mewah.' },
  { num: '09', title: 'Hitung Mundur Waktu', desc: 'Penunjuk hitung mundur waktu menuju jam dan hari istimewa Anda untuk menambah kesan dramatis.' },
  { num: '10', title: 'Jadwal & Rundown Acara', desc: 'Tampilkan susunan dan detail agenda acara pernikahan (Akad, Resepsi, dll.) dengan runut dan jelas.' },
  { num: '11', title: 'Love Story / Timeline', desc: 'Bagikan kisah perjalanan cinta indah Anda kepada kerabat terdekat melalui linimasa bergambar yang estetik.' },
  { num: '12', title: 'Embed Video & Streaming', desc: 'Sematkan video pre-wedding atau siaran langsung acara agar tamu yang berada jauh tetap bisa menyaksikan.' },
  { num: '13', title: 'Musik Latar Belakang', desc: 'Putar lagu instrumental romantis pilihan Anda untuk menemani tamu saat membuka dan membaca undangan.' },
  { num: '14', title: 'Personalisasi Nama Tamu', desc: 'Tulis dan kirim undangan dengan nama tamu penerima yang disesuaikan secara dinamis agar terasa eksklusif.' },
  { num: '15', title: 'Kemudahan WhatsApp Share', desc: 'Kirim link undangan digital dengan generator teks WhatsApp instan tanpa perlu repot menyimpan nomor.' },
];
---

<MarketingLayout
  title="Fitur Premium Undangan Digital"
  description="Daftar fitur lengkap undangan digital Acaranya.id: unlimited tamu, Google Maps interaktif, RSVP otomatis, galeri foto, amplop digital, dan check-in QR."
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-16 lg:pt-36 lg:pb-24 bg-cream overflow-hidden">
    <!-- Subtle Background Dot Pattern -->
    <div 
      class="absolute inset-0 text-brand-300 opacity-20 pointer-events-none"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <Container>
      <div class="relative z-10 max-w-3xl mx-auto text-center space-y-4">
        <span class="text-[10px] uppercase tracking-[0.22em] text-soft-gold font-bold">Koleksi Fitur</span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-950 leading-tight">
          Segudang fitur dengan <br class="hidden sm:block" />
          <span class="italic font-normal text-soft-gold">estetika premium</span>
        </h1>
        <p class="text-text-secondary text-sm md:text-base max-w-lg mx-auto font-sans tracking-wide leading-relaxed">
          Dirancang untuk memberikan kenyamanan maksimal bagi Anda dan pengalaman interaktif yang mewah bagi para tamu undangan.
        </p>
      </div>
    </Container>
  </section>

  <!-- Open Grid Feature List (Kinto Style) -->
  <Section bg="white" id="all-features" class="border-t border-border-soft/60">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-16 stagger">
        {features.map((feature) => (
          <div class="group border-b border-border-soft/40 pb-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] font-sans font-semibold tracking-widest text-soft-gold uppercase">
                  Feature {feature.num}
                </span>
                <div class="w-8 h-8 rounded-full border border-soft-gold/20 flex items-center justify-center text-soft-gold/70 text-xs">
                  ✓
                </div>
              </div>
              <h3 class="font-serif text-xl font-medium text-brand-950 mb-3 group-hover:text-soft-gold transition-colors duration-300">
                {feature.title}
              </h3>
              <p class="text-text-secondary text-sm leading-relaxed font-sans tracking-wide">
                {feature.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Premium Bottom Banner -->
  <Section bg="cream" class="border-t border-border-soft/50">
    <Container>
      <div class="text-center max-w-xl mx-auto space-y-6">
        <span class="text-[10px] uppercase tracking-[0.2em] text-soft-gold font-bold">Wujudkan Undangan Impian</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-brand-950 leading-tight">
          Siap melangkah ke momen bahagia bersama kami?
        </h2>
        <p class="text-text-secondary text-sm font-sans tracking-wide max-w-md mx-auto">
          Mulai buat undangan digital premium Anda sekarang. Proses mudah, hasil super anggun, dan harga sangat terjangkau.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a href="/harga/" class="px-8 py-3.5 bg-brand-950 text-cream text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-brand-900 transition-all duration-300 shadow-card hover:shadow-card-hover">
            Lihat Paket Harga
          </a>
          <a href="/desain-undangan-digital/" class="px-8 py-3.5 border border-brand-300/80 text-brand-800 text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-white transition-all duration-300">
            Katalog Desain
          </a>
        </div>
      </div>
    </Container>
  </Section>
</MarketingLayout>
