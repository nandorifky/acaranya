---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Container from '../../components/base/Container.astro';
import Section from '../../components/base/Section.astro';
import DesignCard from '../../components/designs/DesignCard.astro';
import CategoryWhyChooseUs from '../../components/designs/CategoryWhyChooseUs.astro';
import Icon from '../../components/ui/Icon.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../data/site';
import { pricingPlans } from '../../data/pricing-static';

function bySortOrder(a, b) {
  return a.data.sortOrder - b.data.sortOrder || a.id.localeCompare(b.id);
}

function byCatalogOrder(a, b) {
  return (
    (a.data.catalogSortOrder || Number.MAX_SAFE_INTEGER) - (b.data.catalogSortOrder || Number.MAX_SAFE_INTEGER) ||
    (b.data.publishedAt?.getTime() || 0) - (a.data.publishedAt?.getTime() || 0) ||
    a.id.localeCompare(b.id)
  );
}

export async function getStaticPaths() {
  const categories = await getCollection('designCategories');
  const allDesigns = await getCollection('designs');
  const publishedDesigns = allDesigns
    .filter(d => d.data.status === 'published')
    .sort((a, b) => (
      (a.data.catalogSortOrder || Number.MAX_SAFE_INTEGER) - (b.data.catalogSortOrder || Number.MAX_SAFE_INTEGER) ||
      (b.data.publishedAt?.getTime() || 0) - (a.data.publishedAt?.getTime() || 0) ||
      a.id.localeCompare(b.id)
    ));

  const pageSize = 72;
  const paths = [];
  const belongsToCategory = (design, categoryId) =>
    design.data.category === categoryId || design.data.categories.includes(categoryId);

  // Helper to build the pagination object expected by the UI
  const buildPageObj = (data, page, total, baseUrl) => {
    const lastPage = Math.ceil(total / pageSize);
    return {
      data,
      start: (page - 1) * pageSize,
      end: Math.min(page * pageSize - 1, total - 1),
      total,
      currentPage: page,
      size: pageSize,
      lastPage,
      url: {
        current: page === 1 ? baseUrl : `${baseUrl}${page}/`,
        prev: page > 1 ? (page === 2 ? baseUrl : `${baseUrl}${page - 1}/`) : undefined,
        next: page < lastPage ? `${baseUrl}${page + 1}/` : undefined,
      }
    };
  };

  // 1. ALL DESIGNS PATHS
  const totalMain = publishedDesigns.length;
  const mainLastPage = Math.ceil(totalMain / pageSize);
  for (let i = 1; i <= mainLastPage; i++) {
    const data = publishedDesigns.slice((i - 1) * pageSize, i * pageSize);
    paths.push({
      params: { path: i === 1 ? undefined : i.toString() },
      props: { 
        page: buildPageObj(data, i, totalMain, '/desain-undangan-digital/'),
        isCategory: false 
      }
    });
  }

  // 2. CATEGORY PATHS
  for (const cat of categories) {
    const catDesigns = publishedDesigns.filter(d => belongsToCategory(d, cat.id));
    const totalCat = catDesigns.length;
    const catLastPage = Math.ceil(totalCat / pageSize) || 1;

    for (let i = 1; i <= catLastPage; i++) {
      const data = catDesigns.slice((i - 1) * pageSize, i * pageSize);
      const baseUrl = `/desain-undangan-digital/${cat.id}/`;
      paths.push({
        params: { path: i === 1 ? cat.id : `${cat.id}/${i}` },
        props: { 
          page: buildPageObj(data, i, totalCat, baseUrl),
          category: cat,
          isCategory: true
        }
      });
    }
  }

  return paths;
}

const { page, category, isCategory } = Astro.props;
const { path } = Astro.params;

// Render content if it's a category and we are on page 1
const Content = isCategory ? (await render(category)).Content : null;

const allCategories = await getCollection('designCategories');
const publishedCategories = allCategories
  .filter(c => c.data.status === 'published')
  .sort(bySortOrder);

const isFirstPage = page.currentPage === 1;
const siteName = siteConfig.name;
const toAbsoluteUrl = (url) => url?.startsWith('http') ? url : `${siteConfig.url}${url}`;

// SEO logic
const title = isCategory 
  ? (isFirstPage ? category.data.metaTitle : `${category.data.title} - Halaman ${page.currentPage} | ${siteName}`)
  : (isFirstPage ? "Desain Undangan Digital Online, Template Website & Tema Undangan | Acaranya.id" : `Semua Desain - Halaman ${page.currentPage} | ${siteName}`);

const description = isCategory ? category.data.metaDescription : "Pilih desain undangan digital online untuk pernikahan, ulang tahun, wisuda, aqiqah, corporate, dan acara lainnya. Template website elegan, praktis, siap dibagikan.";
const canonicalUrl = `${siteConfig.url}${page.url.current}`;
const ogImage = isCategory
  ? (category.data.featuredImage || category.data.whyChooseUs?.image || siteConfig.branding.ogImage)
  : '/images/desain-undangan-digital.webp';
const ogImageAlt = isCategory
  ? (category.data.featuredImageAlt || category.data.whyChooseUs?.imageAlt || category.data.metaTitle || category.data.title)
  : title;
const breadcrumbs = isCategory
  ? [
      { label: 'Home', href: '/' },
      { label: 'Desain Undangan Digital', href: '/desain-undangan-digital/' },
      { label: category.data.title },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'Desain Undangan Digital' },
    ];

// Use the price from the 'simple' plan as the base price for templates
const basePrice = pricingPlans.find(p => p.slug === 'simple')?.price || 75000;

// JSON-LD Schema
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: description,
    url: canonicalUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    numberOfItems: page.total,
    itemListElement: page.data.map((design, index) => ({
      '@type': 'ListItem',
      position: page.start + index + 1,
      item: {
        '@type': 'Product',
        name: `Template Undangan Digital - ${design.data.title}`,
        description: `Desain undangan digital ${design.data.category} tema ${design.data.title}.`,
        url: toAbsoluteUrl(design.data.previewUrl),
        image: toAbsoluteUrl(design.data.thumbnail),
        brand: {
          '@type': 'Brand',
          name: siteConfig.name,
        },
        offers: {
          '@type': 'Offer',
          price: basePrice,
          priceCurrency: 'IDR',
          availability: 'https://schema.org/InStock',
          url: `${siteConfig.url}/harga/`,
        }
      }
    }))
  }
];

if (isCategory && isFirstPage) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonicalUrl}#service`,
    name: category.data.metaTitle || `Jasa Undangan Digital ${category.data.title}`,
    description,
    serviceType: `Jasa Undangan Digital ${category.data.title}`,
    provider: {
      '@id': `${siteConfig.url}/#organization`,
    },
    areaServed: {
      '@type': 'Country',
      name: 'Indonesia',
    },
    url: canonicalUrl,
    offers: {
      '@type': 'Offer',
      price: basePrice,
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
      url: `${siteConfig.url}/harga/`,
    },
  });
}

if (!isCategory && isFirstPage) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Apa itu desain undangan digital?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Desain undangan digital adalah tampilan undangan berbasis website atau link online yang bisa dibagikan lewat WhatsApp, media sosial, dan chat pribadi. Di Acaranya.id, desain dibuat responsif, elegan, dan siap digunakan untuk berbagai acara.'
        }
      },
      {
        '@type': 'Question',
        name: 'Apakah template undangan digital bisa dipakai untuk ulang tahun dan acara lain?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Bisa. Acaranya.id menyediakan tema undangan digital untuk pernikahan, ulang tahun, wisuda, aqiqah, khitan, natal, grand opening, corporate, syukuran, dan acara lainnya.'
        }
      },
      {
        '@type': 'Question',
        name: 'Apakah undangan digital Acaranya.id berbentuk website?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Ya. Undangan dibuat dalam bentuk website online dengan link khusus, sehingga tamu dapat membuka detail acara, galeri, RSVP, peta lokasi, dan informasi penting lain dari ponsel.'
        }
      }
    ]
  });
}

---

<MarketingLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- Unified Hero Section -->
  <header class:list={["relative pt-24 pb-16 lg:pt-36 lg:pb-24 bg-cream overflow-hidden", !isFirstPage && "lg:pt-28 lg:pb-12"]}>
    <div 
      class="absolute inset-0 text-brand-300 opacity-20 pointer-events-none"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <Container>
      <div class="relative z-10 max-w-4xl space-y-6">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full border border-soft-gold/20 flex items-center justify-center text-soft-gold">
            <Icon name={isCategory ? category.data.icon : "palette"} size={13} />
          </div>
          <span class="text-[10px] uppercase tracking-[0.22em] text-soft-gold font-bold">
            {isCategory ? `Kategori ${category.data.title}` : "Showroom Katalog"}
          </span>
        </div>

        {isFirstPage ? (
          <>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-950 leading-tight">
              {isCategory ? (category.data.heroTitle || (
                <>
                  Pilihan eksklusif undangan <br class="hidden sm:block" />
                  <span class="italic font-normal text-soft-gold">{category.data.title.toLowerCase()}</span>
                </>
              )) : (
                <>
                  Desain Undangan Digital <br class="hidden sm:block" />
                  <span class="italic font-normal text-soft-gold">Profesional & Elegan</span>
                </>
              )}
            </h1>
            <p class="text-text-secondary text-sm md:text-base max-w-lg font-sans tracking-wide leading-relaxed">
              {isCategory ? (category.data.heroSubtitle || category.data.description) : "Pilih template website undangan untuk pernikahan, ulang tahun, wisuda, aqiqah, corporate, dan momen istimewa lainnya. Setiap tema dibuat elegan, ringan, responsif, dan praktis untuk hari bahagia Anda."}
            </p>
          </>
        ) : (
          <div class="space-y-2">
            <p class="font-serif text-3xl text-brand-950">
              {isCategory ? category.data.title : "Semua Desain"} <span class="text-soft-gold italic">— Halaman {page.currentPage}</span>
            </p>
            <p class="text-xs text-text-muted">Jelajahi koleksi desain undangan digital terbaik kami.</p>
          </div>
        )}

        <!-- Dynamic Category Chips -->
        <nav class="flex flex-wrap gap-2.5 pt-4" aria-label="Navigasi Kategori">
          <a 
            href="/desain-undangan-digital/" 
            class:list={[
              "inline-flex items-center gap-2 px-5 py-2.5 text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-card",
              !isCategory ? "bg-brand-950 text-cream" : "bg-white border border-[#B59A73]/20 text-[#B59A73] hover:text-soft-gold"
            ]}
          >
            <Icon name="palette" size={10} class={!isCategory ? "" : "rotate-180"} /> Semua Desain
          </a>
          {publishedCategories.map((cat) => (
            <a
              href={`/desain-undangan-digital/${cat.id}/`}
              class:list={[
                'inline-flex items-center gap-2 px-5 py-2.5 text-[9px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-card',
                isCategory && cat.id === category.id
                  ? 'bg-brand-950 text-cream border border-brand-950'
                  : 'bg-white border border-[#B59A73]/20 hover:border-soft-gold text-brand-800 hover:text-soft-gold hover:shadow-card-hover'
              ]}
            >
              <Icon name={cat.data.icon} size={11} />
              {cat.data.labelShort}
            </a>
          ))}
        </nav>
      </div>
    </Container>
  </header>

  <!-- Showroom Results Section -->
  <Section bg="white" id="showroom-results" class="border-t border-border-soft/60">
    <Container>
      {page.data.length > 0 ? (
        <>
          <div class="flex items-center justify-between mb-8 border-b border-border-soft/30 pb-4">
            <p class="text-[11px] font-sans font-semibold uppercase tracking-widest text-text-muted">
              Menampilkan <span class="text-brand-950 font-bold">{page.start + 1} - {page.end + 1}</span> dari <span class="text-brand-950 font-bold">{page.total}</span> Desain {isCategory ? category.data.title : ""}
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 stagger">
            {page.data.map((design) => (
              <DesignCard design={design} />
            ))}
          </div>

          <Pagination page={page} baseUrl={isCategory ? `/desain-undangan-digital/${category.id}/` : '/desain-undangan-digital/'} />
        </>
      ) : (
        <div class="text-center py-24 max-w-md mx-auto space-y-6">
          <div class="w-16 h-16 rounded-full border border-soft-gold/20 flex items-center justify-center text-soft-gold mx-auto bg-cream">
            <Icon name="palette" size={24} />
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-2xl text-brand-950">Katalog Belum Tersedia</h3>
            <p class="text-xs text-text-muted font-sans tracking-wide leading-relaxed">
              Template khusus untuk kategori {isCategory ? category.data.title : ""} sedang dirancang secara personal oleh desainer kami.
            </p>
          </div>
          <div class="pt-2">
            <a href={`/order-undangan/?category=${isCategory ? category.id : "all"}&request=custom`} class="inline-flex items-center gap-2 px-8 py-3.5 bg-brand-900 text-cream text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-brand-950 transition-all duration-300 shadow-card">
              Request Desain Custom
              <Icon name="arrow-right" size={12} />
            </a>
          </div>
        </div>
      )}
    </Container>
  </Section>

  {isFirstPage && (
    <>
      <!-- Why Choose Us Section -->
      <section id="why-choose-us">
        <CategoryWhyChooseUs data={isCategory ? (category.data.whyChooseUs || {}) : {
          title: "Kenapa Memilih Acaranya.id?",
          subtitle: "Kami menghadirkan desain undangan digital online yang elegan, praktis, dan siap dibagikan untuk berbagai momen istimewa.",
          image: "/images/desain-undangan-digital.webp",
          imageAlt: "Desain undangan digital online Acaranya.id untuk pernikahan ulang tahun dan acara lainnya",
          imageTitle: "Desain Undangan Digital Online Acaranya.id",
          features: [
            { title: "Desain Estetik", description: "Koleksi template mewah dengan tipografi dan layout profesional.", icon: "sparkles" },
            { title: "Fitur Lengkap", description: "Navigasi Maps, RSVP otomatis, hingga galeri foto interaktif.", icon: "zap" },
            { title: "Proses Cepat", description: "Undangan digital siap digunakan hanya dalam hitungan jam.", icon: "clock" },
            { title: "Revisi Puas", description: "Layanan revisi sepuasnya demi hasil yang paling sempurna.", icon: "refresh-cw" }
          ]
        }} />
      </section>

      <!-- Article SEO Content Section -->
      <article class="bg-white border-t border-border-soft/60">
        <Section>
          <Container narrow>
            <div class="space-y-12">
              {isCategory ? (
                <div class="prose max-w-none prose-brand mx-auto">
                  <Content />
                </div>
              ) : (
                <div class="prose max-w-none prose-brand mx-auto">
                  <h2>Desain Undangan Digital Premium dan Loading Cepat</h2>
                  <p>Memilih desain undangan digital bukan sekadar memilih tampilan yang cantik. Untuk banyak calon pengantin dan keluarga, undangan adalah kesan pertama sebelum tamu hadir di momen istimewa. Dari sana, tamu mulai merasakan suasana acara, memahami detail waktu dan lokasi, lalu menyimpan harapan kecil tentang hari bahagia Anda. Karena itu, Acaranya.id merancang koleksi template undangan digital online yang hangat, elegan, praktis, dan siap dibagikan tanpa ribet.</p>

                  <p>Halaman ini dibuat sebagai katalog utama untuk Anda yang sedang mencari desain undangan, tema undangan, template website undangan, atau contoh undangan online untuk berbagai acara. Fokusnya sederhana. Anda bisa menemukan gaya visual yang paling sesuai, memahami fitur yang dibutuhkan, lalu memilih undangan impian dengan lebih tenang.</p>

                  <h2>Desain Undangan Digital untuk Berbagai Momen Istimewa</h2>
                  <p>Setiap acara punya karakter yang berbeda. Undangan pernikahan biasanya membutuhkan nuansa romantis, rapi, dan personal. Undangan ulang tahun lebih bebas bermain warna, ilustrasi, dan tone yang meriah. Undangan wisuda perlu terasa bangga namun tetap hangat. Undangan corporate, grand opening, atau acara bisnis membutuhkan desain yang bersih, profesional, dan mudah dipercaya.</p>

                  <p>Di Acaranya.id, koleksi desain undangan digital disusun agar Anda tidak harus memulai dari halaman kosong. Anda bisa memilih tema yang sudah siap, lalu menyesuaikan detail nama, tanggal, tempat, foto, cerita, dan informasi acara. Alurnya lebih hemat waktu karena bagian teknis sudah disiapkan, sementara Anda tetap punya ruang untuk membuat undangan terasa personal.</p>

                  <h3>Undangan Pernikahan Online yang Elegan dan Romantis</h3>
                  <p>Untuk pernikahan, desain yang baik harus mampu menyeimbangkan estetika dan informasi. Nama pengantin, susunan acara, lokasi, galeri, love story, dan RSVP perlu tampil jelas tanpa mengurangi kesan romantis. Template undangan pernikahan Acaranya.id dibuat agar detail penting mudah ditemukan tamu, sementara visualnya tetap terasa lembut dan premium.</p>

                  <p>Anda dapat memilih tema klasik, modern, adat, minimalis, floral, islami, atau gaya editorial yang lebih mewah. Setiap desain dirancang responsif agar nyaman dibuka dari ponsel, karena sebagian besar tamu akan menerima undangan lewat WhatsApp atau media sosial.</p>

                  <h3>Undangan Ulang Tahun, Wisuda, Aqiqah, dan Acara Lainnya</h3>
                  <p>Tidak semua undangan digital harus bernuansa pernikahan. Banyak keluarga dan penyelenggara acara juga membutuhkan undangan online untuk ulang tahun anak, sweet seventeen, wisuda, aqiqah, khitanan, syukuran, natal, buka bersama, hingga gathering perusahaan. Kebutuhannya bisa berbeda, tetapi prinsipnya sama. Undangan harus cantik, informatif, mudah dibuka, dan siap dibagikan.</p>

                  <p>Untuk acara keluarga, desain yang hangat membantu tamu merasa dekat sejak menerima link undangan. Untuk acara formal, tampilan yang rapi membantu membangun kepercayaan. Untuk acara anak, warna dan ilustrasi bisa dibuat lebih ceria tanpa mengorbankan keterbacaan.</p>

                  <h2>Kenapa Template Website Undangan Lebih Praktis</h2>
                  <p>Undangan digital berbasis website memberi pengalaman yang lebih lengkap dibanding gambar undangan biasa. Tamu tidak hanya melihat poster acara, tetapi bisa membuka halaman khusus yang berisi informasi lengkap. Link undangan dapat dikirim lewat WhatsApp, dicantumkan di bio, dibagikan ke grup keluarga, atau dikirim satu per satu kepada tamu penting.</p>

                  <p>Dalam satu halaman, Anda bisa menampilkan peta lokasi, tombol navigasi, RSVP, galeri foto, countdown, cerita singkat, musik, detail dress code, hingga amplop digital bila diperlukan. Semua informasi itu tersusun dalam alur yang nyaman dibaca, sehingga tamu tidak perlu bertanya ulang tentang jam acara, alamat, atau tautan lokasi.</p>

                  <p>Untuk Anda yang ingin proses terima beres, template website undangan juga menghemat banyak waktu. Tidak perlu memikirkan struktur halaman dari awal. Tidak perlu mendesain manual satu per satu. Anda cukup memilih desain, mengirim data acara, lalu tim membantu menyiapkan undangan online agar siap digunakan.</p>

                  <h2>Cara Memilih Tema Undangan yang Tepat</h2>
                  <p>Desain yang paling bagus bukan selalu desain yang paling ramai. Desain yang tepat adalah desain yang sesuai dengan suasana acara, mudah dipahami tamu, dan membuat Anda merasa yakin saat membagikannya. Jika acara Anda formal, pilih warna yang tenang, tipografi bersih, dan komposisi yang rapi. Jika acaranya intimate, tema minimalis, floral lembut, atau nuansa earth tone bisa memberi kesan hangat.</p>

                  <p>Untuk pernikahan adat, pilih desain yang memberi ruang untuk ornamen budaya tanpa membuat informasi utama tenggelam. Untuk ulang tahun anak, pilih ilustrasi dan warna cerah, tetapi tetap pastikan teks tanggal, jam, dan lokasi mudah dibaca. Untuk undangan corporate atau grand opening, pilih layout yang modern, profesional, dan tidak terlalu dekoratif.</p>

                  <h3>Pertimbangkan Foto dan Warna Acara</h3>
                  <p>Jika Anda sudah punya foto prewedding, foto keluarga, atau dokumentasi acara, pilih template yang dapat menonjolkan foto tersebut dengan elegan. Warna desain juga sebaiknya selaras dengan konsep dekorasi, busana, atau mood acara. Keselarasan kecil seperti ini membuat undangan terasa lebih utuh dan personal.</p>

                  <h3>Utamakan Kenyamanan Tamu</h3>
                  <p>Undangan digital yang baik harus cepat dibuka dan mudah dipahami. Tamu dari berbagai usia perlu bisa menemukan informasi utama tanpa kebingungan. Karena itu, Acaranya.id menjaga struktur undangan tetap jelas, tombol penting mudah terlihat, dan tampilan tetap nyaman di layar ponsel.</p>

                  <h2>Fitur Lengkap untuk Undangan Online yang Siap Dibagikan</h2>
                  <p>Selain desain cantik, fitur menjadi alasan utama banyak orang memilih undangan digital. Fitur RSVP membantu Anda memperkirakan kehadiran tamu. Galeri foto membuat undangan terasa lebih personal. Peta lokasi memudahkan tamu datang tepat waktu. Countdown memberi sentuhan antusias menjelang hari acara. Tombol share membantu undangan lebih mudah dibagikan.</p>

                  <p>Untuk acara pernikahan, fitur cerita pasangan, susunan acara, informasi keluarga, dan ucapan tamu bisa membuat halaman terasa lebih hidup. Untuk acara bisnis, fitur detail agenda, lokasi, kontak, dan tombol konfirmasi hadir membantu komunikasi terlihat profesional. Semua fitur ini disusun agar tetap praktis, bukan sekadar ramai.</p>

                  <h2>Desain Cantik Saja Tidak Cukup</h2>
                  <p>Banyak orang mencari template undangan digital karena ingin hasil yang cepat dan cantik. Namun pengalaman tamu juga sangat penting. Jika halaman lambat, tombol sulit ditemukan, teks terlalu kecil, atau desain tidak rapi di mobile, undangan bisa terasa kurang nyaman walaupun visualnya menarik. Di Acaranya.id, desain, performa, dan keterbacaan dipikirkan bersama.</p>

                  <p>Kami memilih pendekatan semi premium yang tidak berlebihan. Visual dibuat elegan, konten disusun jelas, dan elemen penting ditempatkan secara natural. Hasilnya adalah undangan online yang terasa indah saat dilihat, tetapi tetap membantu tamu memahami acara dengan cepat.</p>

                  <h2>Pertanyaan yang Sering Muncul</h2>
                  <h3>Apa Perbedaan Undangan Digital dan Website Undangan?</h3>
                  <p>Undangan digital adalah istilah umum untuk undangan yang dibagikan secara online. Website undangan adalah salah satu bentuknya, berupa halaman khusus yang dapat dibuka melalui link. Acaranya.id menggunakan format website undangan karena lebih fleksibel, lebih lengkap, dan lebih nyaman untuk berbagai kebutuhan acara.</p>

                  <h3>Apakah Template Bisa Disesuaikan?</h3>
                  <p>Bisa. Nama, tanggal, lokasi, foto, susunan acara, narasi, dan detail lain dapat disesuaikan dengan kebutuhan. Anda tetap memilih dari desain yang sudah siap, tetapi isi undangan dibuat mengikuti acara Anda.</p>

                  <h3>Apakah Cocok untuk Acara Selain Pernikahan?</h3>
                  <p>Sangat cocok. Koleksi Acaranya.id mencakup tema undangan untuk ulang tahun, wisuda, aqiqah, khitan, natal, syukuran, buka bersama, grand opening, corporate, dan acara lainnya. Anda tinggal memilih kategori yang paling dekat dengan kebutuhan acara.</p>

                  <h2>Mulai dari Desain yang Membuat Anda Yakin</h2>
                  <p>Undangan adalah bagian kecil yang membawa rasa besar. Ia menyampaikan kabar bahagia, menghubungkan keluarga dan sahabat, lalu menjadi pembuka menuju momen yang akan dikenang. Dengan desain undangan digital online dari Acaranya.id, Anda bisa menyiapkan undangan yang elegan, praktis, dan siap dibagikan tanpa proses yang melelahkan.</p>

                  <p>Silakan jelajahi katalog desain di halaman ini. Pilih template yang paling sesuai dengan suasana acara Anda, lalu biarkan Acaranya.id membantu menyiapkan undangan impian yang rapi, hangat, dan terima beres.</p>
                </div>
              )}

