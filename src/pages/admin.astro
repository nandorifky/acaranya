---
/* src/pages/admin.astro */
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acaranya.id — Admin Panel</title>
    <!-- Konfigurasi Langsung (Inline) -->
    <script type="text/yaml" id="cms-config">
      backend:
        name: github
        repo: nandorifky/acaranya
        branch: main
        base_url: https://sveltia.mr-winando.workers.dev
        auth_endpoint: /auth

      local_backend: true
      media_folder: "public/images"
      public_folder: "/images"

      collections:
        - name: "designs"
          label: "Katalog Desain"
          folder: "src/content/designs"
          create: true
          slug: "{{slug}}"
          format: "frontmatter"
          fields:
            - { label: "Nama Template Desain", name: "title", widget: "string" }
            - { label: "Kategori (Slug)", name: "category", widget: "string" }
            - { label: "Tipe Acara", name: "eventType", widget: "select", options: ["wedding", "khitanan", "birthday", "aqiqah", "corporate", "graduation", "other"] }
            - { label: "Gambar Thumbnail", name: "thumbnail", widget: "image", required: false }
            - { label: "Tautan Live Preview", name: "previewUrl", widget: "string" }
            - { label: "Tampilkan di Unggulan?", name: "isFeatured", widget: "boolean", default: false }
            - { label: "Desain Premium?", name: "isPremium", widget: "boolean", default: false }
            - { label: "Tags / Label", name: "tags", widget: "list", default: [] }
            - { label: "Paket Investasi", name: "package", widget: "select", options: ["simple", "mengundang", "meriah"] }
            - { label: "Urutan Pengurutan (Sort Order)", name: "sortOrder", widget: "number", value_type: "int", default: 0 }
            - { label: "Status Publikasi", name: "status", widget: "select", options: ["draft", "published"], default: "published" }

        - name: "blog"
          label: "Artikel Blog"
          folder: "src/content/blog"
          create: true
          slug: "{{slug}}"
          format: "frontmatter"
          fields:
            - { label: "Judul Artikel", name: "title", widget: "string" }
            - { label: "Deskripsi Singkat", name: "description", widget: "text" }
            - { label: "Tanggal Rilis", name: "publishedAt", widget: "datetime" }
            - { label: "Isi Konten Artikel (Body)", name: "body", widget: "markdown" }
    </script>
  </head>
  <body>
    <!-- Sveltia CMS akan otomatis mencari script#cms-config jika tidak ada file eksternal -->
    <script src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
  </body>
</html>
