---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Container from '../components/base/Container.astro';
---

<MarketingLayout title="Halaman Tidak Ditemukan" robots="noindex,follow">
  <section class="py-24 lg:py-32 bg-cream">
    <Container>
      <div class="text-center max-w-lg mx-auto">
        <p class="font-serif text-8xl text-brand-200 font-bold mb-6">404</p>
        <h1 class="font-serif text-3xl font-bold text-text-primary mb-3">Halaman tidak ditemukan</h1>
        <p class="text-text-secondary mb-8">Maaf, halaman yang kamu cari tidak tersedia atau sudah dipindahkan.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-500 text-white font-semibold rounded-full hover:bg-brand-600 transition-colors text-sm">
            Kembali ke Beranda
          </a>
          <a href="/desain-undangan-digital/" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-brand-200 text-brand-700 font-semibold rounded-full hover:bg-brand-50 transition-colors text-sm">
            Lihat Desain
          </a>
        </div>
      </div>
    </Container>
  </section>
</MarketingLayout>
