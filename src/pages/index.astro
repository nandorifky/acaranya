---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import TrustStats from "../components/home/TrustStats.astro";
import FeaturedDesigns from "../components/home/FeaturedDesigns.astro";
import CulturalLayouts from "../components/home/CulturalLayouts.astro";
import FeatureHighlights from "../components/home/FeatureHighlights.astro";
import GuestJourney from "../components/home/GuestJourney.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import QRCodeGuestbook from "../components/home/QRCodeGuestbook.astro";
import PricingPreview from "../components/home/PricingPreview.astro";
import Testimonials from "../components/home/Testimonials.astro";
import UptimeInfrastructure from "../components/home/UptimeInfrastructure.astro";
import FAQSection from "../components/home/FAQSection.astro";
import BlogPreview from "../components/home/BlogPreview.astro";
import EcoImpact from "../components/home/EcoImpact.astro";
import Partners from "../components/home/Partners.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import { siteConfig } from "../data/site";
import { getCollection } from "astro:content";
import { pricingPlans } from "../data/pricing-static";

const allTestimonials = await getCollection("testimonials");
const publishedTestimonials = allTestimonials
  .filter((t) => t.data.status === "published")
  .slice(0, 5); // Take up to 5 for schema

const prices = pricingPlans.map((p) => p.price);
const lowPrice = Math.min(...prices);
const highPrice = Math.max(...prices);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: siteConfig.name,
    image: `${siteConfig.url}${siteConfig.branding.logo}`,
    "@id": `${siteConfig.url}/#localbusiness`,
    url: siteConfig.url,
    telephone: `+${siteConfig.contact.whatsapp}`,
    priceRange: siteConfig.seo.priceRange,
    address: {
      "@type": "PostalAddress",
      addressLocality: siteConfig.business.schemaLocality,
      addressRegion: siteConfig.business.schemaRegion,
      addressCountry: siteConfig.business.schemaCountry,
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: siteConfig.business.latitude,
      longitude: siteConfig.business.longitude,
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: siteConfig.seo.ratingValue,
      reviewCount: siteConfig.seo.reviewCount,
      bestRating: "5",
      worstRating: "1",
    },
    review: publishedTestimonials.map((t) => ({
      "@type": "Review",
      author: {
        "@type": "Person",
        name: t.data.name,
      },
      reviewBody: t.data.message,
      reviewRating: {
        "@type": "Rating",
        ratingValue: t.data.rating,
        bestRating: "5",
        worstRating: "1",
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    logo: `${siteConfig.url}${siteConfig.branding.logo}`,
    sameAs: [
      siteConfig.social.instagram.url,
      siteConfig.social.facebook.url,
      siteConfig.social.tiktok.url,
    ].filter((url) => url),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${siteConfig.url}/#webapp`,
    name: siteConfig.name,
    url: siteConfig.url,
    operatingSystem: "All",
    applicationCategory: "DesignApplication",
    browserRequirements: "Requires HTML5, CSS3, JavaScript",
    publisher: {
      "@type": "LocalBusiness",
      "@id": `${siteConfig.url}/#localbusiness`,
    },
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "IDR",
      lowPrice: lowPrice.toString(),
      highPrice: highPrice.toString(),
      priceRange: siteConfig.seo.priceRange,
      areaServed: {
        "@type": "Country",
        name: "ID",
      },
    },
  },
];
---

<MarketingLayout jsonLd={jsonLd}>
  <HeroSection />
  <TrustStats />
  <Partners />
  <FeaturedDesigns />
  <CulturalLayouts />
  <FeatureHighlights />
  <GuestJourney />
  <HowItWorks />
  <QRCodeGuestbook />
  <PricingPreview />
  <Testimonials />
  <UptimeInfrastructure />
  <EcoImpact />
  <FAQSection />
  <FinalCTA />
  <BlogPreview />
</MarketingLayout>
