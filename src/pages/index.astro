---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import TrustStats from "../components/home/TrustStats.astro";
import FeaturedDesigns from "../components/home/FeaturedDesigns.astro";
import CulturalLayouts from "../components/home/CulturalLayouts.astro";
import FeatureHighlights from "../components/home/FeatureHighlights.astro";
import GuestJourney from "../components/home/GuestJourney.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import QRCodeGuestbook from "../components/home/QRCodeGuestbook.astro";
import PricingPreview from "../components/home/PricingPreview.astro";
import Testimonials from "../components/home/Testimonials.astro";
import UptimeInfrastructure from "../components/home/UptimeInfrastructure.astro";
import FAQSection from "../components/home/FAQSection.astro";
import BlogPreview from "../components/home/BlogPreview.astro";
import EcoImpact from "../components/home/EcoImpact.astro";
import Partners from "../components/home/Partners.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import { siteConfig } from "../data/site";
import { pricingPlans } from "../data/pricing-static";

const prices = pricingPlans.map((p) => p.price);
const lowPrice = Math.min(...prices);
const highPrice = Math.max(...prices);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteConfig.url}/#service`,
    name: "Jasa Undangan Digital untuk Semua Acara",
    serviceType: "Jasa Undangan Digital",
    description: siteConfig.description,
    url: siteConfig.url,
    provider: {
      "@id": `${siteConfig.url}/#organization`,
    },
    areaServed: {
      "@type": "Country",
      name: "Indonesia",
    },
    availableChannel: {
      "@type": "ServiceChannel",
      serviceUrl: siteConfig.url,
      servicePhone: `+${siteConfig.contact.whatsapp}`,
      availableLanguage: "id-ID",
    },
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "IDR",
      lowPrice: lowPrice.toString(),
      highPrice: highPrice.toString(),
      priceRange: siteConfig.seo.priceRange,
      availability: "https://schema.org/InStock",
      url: `${siteConfig.url}/harga/`,
    },
  },
];
---

<MarketingLayout jsonLd={jsonLd}>
  <HeroSection />
  <TrustStats />
  <Partners />
  <FeaturedDesigns />
  <PricingPreview />
  <CulturalLayouts />
  <FeatureHighlights />
  <GuestJourney />
  <HowItWorks />
  <QRCodeGuestbook />
  <Testimonials />
  <UptimeInfrastructure />
  <EcoImpact />
  <FAQSection />
  <FinalCTA />
  <BlogPreview />
</MarketingLayout>
