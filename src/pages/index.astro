---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import TrustStats from "../components/home/TrustStats.astro";
import FeaturedDesigns from "../components/home/FeaturedDesigns.astro";
import FeatureHighlights from "../components/home/FeatureHighlights.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import PricingPreview from "../components/home/PricingPreview.astro";
import Testimonials from "../components/home/Testimonials.astro";
import FAQSection from "../components/home/FAQSection.astro";
import BlogPreview from "../components/home/BlogPreview.astro";
import EcoImpact from "../components/home/EcoImpact.astro";
import Partners from "../components/home/Partners.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import { siteConfig } from "../data/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": siteConfig.name,
    "image": `${siteConfig.url}/favicon.svg`,
    "@id": `${siteConfig.url}/#localbusiness`,
    "url": siteConfig.url,
    "telephone": `+${siteConfig.contact.whatsapp}`,
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Surabaya",
      "addressRegion": "Jawa Timur",
      "addressCountry": "ID"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "384",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "Romi & Yuli"
        },
        "datePublished": "2026-05-10",
        "reviewBody": "Desain undangan sangat premium dan elegan. Fitur RSVP otomatis sangat membantu jalannya acara kami.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        }
      },
      {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": "Baby Al & Family"
        },
        "datePublished": "2026-04-18",
        "reviewBody": "Sangat praktis untuk undangan aqiqah. Foto galeri tampil jernih dan loading-nya sangat cepat.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Undangan Digital",
    "provider": {
      "@type": "LocalBusiness",
      "name": siteConfig.name,
      "url": siteConfig.url
    },
    "description": siteConfig.description,
    "areaServed": "ID",
    "serviceType": "Undangan Digital"
  }
];
---

<MarketingLayout jsonLd={jsonLd}>
  <HeroSection />
  <TrustStats />
  <Partners />
  <FeaturedDesigns />
  <FeatureHighlights />
  <HowItWorks />
  <PricingPreview />
  <Testimonials />
  <EcoImpact />
  <FAQSection />
  <FinalCTA />
  <BlogPreview />
</MarketingLayout>
