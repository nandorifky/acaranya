---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import FloatingWhatsapp from '../components/layout/FloatingWhatsapp.astro';
import Breadcrumbs from '../components/base/Breadcrumbs.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  robots?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  section?: string;
  hideFloatingWa?: boolean;
  pagefindBody?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const { hideFloatingWa = false, pagefindBody = true, breadcrumbs, ...seoProps } = Astro.props;
---

<BaseLayout {...seoProps}>
  <SiteHeader />
  <Breadcrumbs items={breadcrumbs} />
  <main class="flex-1" data-pagefind-body={pagefindBody ? true : undefined}>
    <slot />
  </main>
  <SiteFooter />
  {!hideFloatingWa && <FloatingWhatsapp />}
  <slot name="scripts" />
</BaseLayout>
