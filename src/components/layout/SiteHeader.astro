---
import { siteConfig } from "../../data/site";
import { mainNavigation, mobileNavigation, ctaNavItem } from "../../data/navigation";
import Icon from "../ui/Icon.astro";
import { createWhatsappUrl } from "../../lib/whatsapp/create-whatsapp-url";

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-4 left-4 right-4 z-50 transition-all duration-300"
>
  <div
    class="max-w-5xl mx-auto px-5 py-2.5 sm:py-3 bg-surface/80 backdrop-blur-md rounded-full border border-border-soft/60 shadow-card flex items-center justify-between transition-all duration-300 relative overflow-hidden"
    id="header-container"
  >
    {/* Reading Progress Bar (Global) */}
    <div
      id="reading-progress"
      class="absolute top-0 left-0 h-[2px] bg-soft-gold w-0 transition-all duration-150 z-20"
    >
    </div>

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center group"
      id="header-logo"
      aria-label={`Kembali ke beranda ${siteConfig.name}`}
    >
      <!-- Mobile Logo (1x1) -->
      <img
        src={siteConfig.branding.logo1x1Png}
        alt={`${siteConfig.name} Logo`}
        width="36"
        height="36"
        class="w-9 h-9 object-contain lg:hidden"
        decoding="async"
        fetchpriority="high"
      />
      <!-- Desktop Logo (Horizontal) -->
      <img
        src={siteConfig.branding.logo}
        alt={`${siteConfig.name} Logo`}
        width="160"
        height="32"
        class="hidden lg:block h-8 object-contain"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden lg:flex items-center gap-1"
      id="desktop-nav"
      aria-label="Navigasi Utama"
    >
      {
        mainNavigation.map((item) => {
          const isActive =
            pathname === item.href ||
            (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 text-[11px] font-bold tracking-widest uppercase transition-all duration-300",
                isActive
                  ? "text-soft-gold"
                  : "text-text-secondary hover:text-soft-gold",
              ]}
            >
              {item.label}
              {isActive && (
                <span class="absolute bottom-1 left-4 right-4 h-px bg-soft-gold/40" />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href={ctaNavItem.href}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-900 hover:bg-brand-950 text-white text-[11px] font-bold tracking-widest uppercase rounded-full transition-all duration-300 shadow-sm hover:shadow active:scale-[0.98]"
        id="header-cta"
      >
        {ctaNavItem.label}
        <Icon name="arrow-right" size={13} />
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="lg:hidden flex items-center">
      <button
        type="button"
        class="p-2 -mr-2 transition-colors text-text-primary"
        aria-label="Buka menu"
        aria-controls="mobile-menu-overlay"
        aria-expanded="false"
        id="mobile-menu-trigger"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[9999] hidden flex-col bg-cream"
  role="dialog"
  aria-modal="true"
  aria-label="Menu navigasi"
>
  <div class="flex items-center justify-between px-5 h-[68px] shrink-0 border-b border-border-soft/50">
    <img
      src={siteConfig.branding.logo1x1Png}
      alt={`${siteConfig.name} Logo`}
      width="36"
      height="36"
      class="w-9 h-9 object-contain"
      decoding="async"
    />
    <button
      type="button"
      class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-muted text-text-secondary"
      aria-label="Tutup menu"
      id="mobile-menu-close"
    >
      <Icon name="x" size={18} />
    </button>
  </div>

  <nav class="flex-1 flex flex-col justify-center px-8 overflow-y-auto -mt-10" aria-label="Navigasi Mobile">
    <div>
      {mobileNavigation.map((item, index) => (
        <a
          href={item.href}
          class:list={[
            "mobile-menu-link group flex items-center justify-between py-3 border-border-soft/40",
            index < mobileNavigation.length - 1 ? "border-b" : "",
          ]}
          style={`animation: mnSlideUp 0.3s ease-out ${index * 0.04}s both;`}
        >
          <span class="font-serif text-2xl font-medium text-text-primary">{item.label}</span>
          <Icon name="arrow-up-right" size={16} class="text-text-muted opacity-30" />
        </a>
      ))}
    </div>
  </nav>

  <div class="px-5 py-5 shrink-0 border-t border-border-soft/50">
    <a href={ctaNavItem.href} class="mobile-menu-link flex items-center justify-center gap-2 w-full py-3.5 bg-brand-900 text-white text-[12px] font-semibold uppercase tracking-[0.15em] rounded-sm">
      {ctaNavItem.label}
    </a>
    <a href={createWhatsappUrl()} target="_blank" rel="noopener noreferrer" class="mobile-menu-link flex items-center justify-center gap-2 w-full py-3 mt-2.5 border border-border-soft text-text-primary text-[12px] font-semibold uppercase tracking-[0.15em] rounded-sm">
      <Icon name="whatsapp" size={15} />
      Chat WhatsApp
    </a>
  </div>
</div>

<!-- Spacer to prevent content overlapping under fixed floating header -->
<div class="h-20 lg:h-24"></div>

<script>
  const headerContainer = document.getElementById("header-container");
  const mobileMenuTrigger = document.getElementById("mobile-menu-trigger");
  const mobileMenuClose = document.getElementById("mobile-menu-close");
  const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");

  const setMobileMenuOpen = (isOpen: boolean) => {
    if (!mobileMenuOverlay || !mobileMenuTrigger) return;
    mobileMenuOverlay.classList.toggle("hidden", !isOpen);
    mobileMenuOverlay.classList.toggle("flex", isOpen);
    mobileMenuTrigger.setAttribute("aria-expanded", String(isOpen));
    document.documentElement.style.overflow = isOpen ? "hidden" : "";
    document.body.style.overflow = isOpen ? "hidden" : "";
  };

  mobileMenuTrigger?.addEventListener("click", () => setMobileMenuOpen(true));
  mobileMenuClose?.addEventListener("click", () => setMobileMenuOpen(false));
  document.querySelectorAll(".mobile-menu-link").forEach((link) => {
    link.addEventListener("click", () => setMobileMenuOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMobileMenuOpen(false);
  });

  window.addEventListener("scroll", () => {
    if (headerContainer) {
      if (window.scrollY > 20) {
        headerContainer.classList.add(
          "py-2",
          "bg-surface/90",
          "border-brand-200/50",
          "shadow-card-hover",
        );
        headerContainer.classList.remove(
          "py-2.5",
          "sm:py-3",
          "bg-surface/80",
          "border-border-soft/60",
          "shadow-card",
        );
      } else {
        headerContainer.classList.remove(
          "py-2",
          "bg-surface/90",
          "border-brand-200/50",
          "shadow-card-hover",
        );
        headerContainer.classList.add(
          "py-2.5",
          "sm:py-3",
          "bg-surface/80",
          "border-border-soft/60",
          "shadow-card",
        );
      }
    }
  });

  // Reading Progress Bar Logic
  const progressBar = document.getElementById("reading-progress");
  const updateProgress = () => {
    if (!progressBar) return;

    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    
    // Avoid division by zero
    if (height <= 0) {
      progressBar.style.width = "0%";
      return;
    }

    const scrolled = (winScroll / height) * 100;
    progressBar.style.width = scrolled + "%";
  };

  window.addEventListener("scroll", updateProgress);
  // Initial check
  updateProgress();
</script>
