---

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items?: BreadcrumbItem[];
}

const { items } = Astro.props;

// Auto-generate breadcrumbs from URL if not provided
const pathname = Astro.url.pathname;
let breadcrumbItems: BreadcrumbItem[] = items || [];

if (!items && pathname !== '/') {
  breadcrumbItems = [{ label: 'Home', href: '/' }];
  const segments = pathname.split('/').filter(Boolean);
  
  const labelMap: Record<string, string> = {
    'fitur': 'Fitur',
    'harga': 'Harga',
    'desain-undangan-digital': 'Desain Undangan Digital',
    'kategori': 'Kategori',
    'order-undangan': 'Order Undangan',
    'artikel': 'Artikel',
    'tag': 'Tag',
    'kontak': 'Kontak',
    'tentang': 'Tentang',
    'legal': 'Legal',
    'syarat-ketentuan': 'Syarat & Ketentuan',
    'kebijakan-privasi': 'Kebijakan Privasi',
    'refund-policy': 'Refund Policy',
    'pernikahan': 'Pernikahan',
    'khitanan': 'Khitanan',
    'ulang-tahun': 'Ulang Tahun',
    'aqiqah': 'Aqiqah',
    'corporate': 'Corporate',
    'graduation': 'Graduation',
  };

  let currentPath = '';
  segments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    const label = labelMap[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    const isLast = index === segments.length - 1;
    breadcrumbItems.push({
      label,
      href: isLast ? undefined : `${currentPath}/`,
    });
  });
}

// Don't render on homepage
const isHome = pathname === '/';

// JSON-LD
const jsonLd = !isHome ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, 'https://acaranya.id').toString() } : {}),
  })),
} : null;
---

{!isHome && (
  <nav aria-label="Breadcrumb" class="w-full bg-transparent relative z-20">
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <div class="max-w-5xl mx-auto px-5 pt-8 pb-0">
      <ol class="flex items-center flex-wrap gap-1 text-[10px] tracking-[0.2em] uppercase font-medium">
        {breadcrumbItems.map((item, index) => (
          <li class="flex items-center">
            {index > 0 && (
              <span class="text-text-muted/30 mx-2 select-none font-light">/</span>
            )}
            {item.href ? (
              <a 
                href={item.href} 
                class="text-text-muted hover:text-soft-gold transition-colors duration-300"
              >
                {item.label}
              </a>
            ) : (
              <span class="text-soft-gold font-semibold truncate max-w-[200px] sm:max-w-none">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}
