---
interface Props {
  text: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'whatsapp' | 'ghost';
}

const { text, variant = 'primary' } = Astro.props;

const colors: Record<string, string> = {
  primary: 'bg-brand-100 text-brand-700 border border-brand-200',
  secondary: 'bg-surface-muted text-text-secondary border border-border-soft',
  outline: 'bg-transparent text-brand-500 border border-brand-300',
  whatsapp: 'bg-green-50 text-green-700 border border-green-200',
  ghost: 'bg-champagne/20 text-soft-gold border border-champagne/30',
};
---

<span class:list={['inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-full', colors[variant]]}>
  {text}
</span>
