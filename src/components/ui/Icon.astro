---

{isBrand ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    class:list={['shrink-0', className]}
    aria-hidden="true"
    set:html={svgContent}
  />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={['shrink-0', className]}
    aria-hidden="true"
    set:html={svgContent}
  />
)}
