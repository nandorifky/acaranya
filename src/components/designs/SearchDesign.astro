---
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
  categorySlug?: string;
  categoryTitle?: string;
}

const { categorySlug, categoryTitle } = Astro.props;

// Fetch ALL designs for the global index
const allDesigns = await getCollection('designs');
const publishedDesigns = allDesigns
  .filter(d => d.data.status === 'published')
  .filter(d => !categorySlug || d.data.category === categorySlug)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Create a lightweight index for search
const searchIndex = publishedDesigns.map(design => ({
  id: design.id,
  title: design.data.title,
  category: design.data.category,
  thumbnail: design.data.thumbnail,
  isPremium: design.data.isPremium,
  previewUrl: design.data.previewUrl,
  tags: design.data.tags || []
}));
---

<div class="mt-8 mb-4">
  <search role="search">
    <form class="relative group max-w-2xl" onsubmit="return false;">
      <div class="absolute inset-y-0 left-5 flex items-center pointer-events-none text-soft-gold group-focus-within:text-brand-900 transition-colors">
        <Icon name="search" size={20} />
      </div>
      <input 
        type="search" 
        id="design-search-input"
        placeholder={categoryTitle ? `Cari tema ${categoryTitle}...` : "Cari nama tema atau gaya desain..."}
        class="w-full pl-14 pr-14 py-4 bg-white border border-border-soft rounded-full font-serif text-lg text-brand-950 focus:border-soft-gold focus:ring-4 focus:ring-soft-gold/5 transition-all outline-none shadow-sm"
        autocomplete="off"
        data-index={JSON.stringify(searchIndex)}
      />
      <!-- Clear button (shown when typing) -->
      <button 
        type="reset" 
        id="search-clear-btn"
        class="hidden absolute right-5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-cream hover:bg-white text-text-muted hover:text-brand-950 transition-all items-center justify-center"
        aria-label="Bersihkan pencarian"
      >
        <Icon name="x" size={14} />
      </button>
    </form>
  </search>
  
<!-- Search Results Section (Mimics Section > Container) -->
<div id="search-results-section" class="hidden bg-white border-t border-border-soft/60">
  <div class="py-20 sm:py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-border-soft/30 pb-4">
        <p class="text-[11px] font-sans font-semibold uppercase tracking-widest text-text-muted">
          Hasil Pencarian: <span id="results-count" class="text-brand-950 font-bold">0</span> Tema Ditemukan
        </p>
      </div>

      <div id="search-results-grid" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 stagger">
        <!-- Results will be injected here via JS -->
      </div>
      
      <div id="no-results-msg" class="hidden py-20 text-center">
        <div class="w-16 h-16 rounded-full border border-soft-gold/20 flex items-center justify-center text-soft-gold mx-auto bg-cream mb-6">
          <Icon name="palette" size={24} />
        </div>
        <h3 class="font-serif text-2xl text-brand-950 mb-2">Tema Tidak Ditemukan</h3>
        <p class="text-xs text-text-muted max-w-sm mx-auto">
          Maaf, kami tidak menemukan tema {categoryTitle ? `di kategori ${categoryTitle}` : ''} yang cocok dengan kata kunci Anda. Coba kata kunci lain atau hubungi kami untuk request desain custom.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initDesignSearch() {
    const input = document.getElementById('design-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear-btn');
    const countSpan = document.getElementById('results-count');
    const searchSection = document.getElementById('search-results-section');
    const resultsGrid = document.getElementById('search-results-grid');
    const noResults = document.getElementById('no-results-msg');
    
    // Original results section to hide
    const showroomSection = document.getElementById('showroom-results') || document.getElementById('category-results');

    if (!input || !resultsGrid || !searchSection || !showroomSection) return;

    const index = JSON.parse(input.getAttribute('data-index') || '[]');

    input.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      
      if (query.length > 0) {
        // Toggle UI
        clearBtn?.classList.remove('hidden');
        clearBtn?.classList.add('flex');
        searchSection.classList.remove('hidden');
        showroomSection.classList.add('hidden');
        noResults?.classList.add('hidden');

        // Filter
        const filtered = index.filter((item: any) => {
          return item.title.toLowerCase().includes(query) || 
                 item.tags.some((tag: string) => tag.toLowerCase().includes(query));
        });

        countSpan!.textContent = filtered.length.toString();

        if (filtered.length > 0) {
          resultsGrid.innerHTML = filtered.map((item: any) => `
            <article class="group relative bg-surface border border-border-soft/60 rounded-3xl overflow-hidden hover:border-[#B59A73]/50 hover:-translate-y-1 transition-all duration-300 shadow-card hover:shadow-card-hover" id="design-card-${item.id}">
              <div class="relative aspect-[3/4] overflow-hidden bg-surface-muted">
                <img 
                  src="${item.thumbnail || ''}" 
                  alt="${item.title}" 
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
                ${item.isPremium ? `
                  <div class="absolute top-4 left-4 flex items-center gap-1 px-3 py-1.5 bg-[#FAF9F6] border border-[#B59A73]/30 backdrop-blur-md text-soft-gold rounded-full shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-soft-gold" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5.21 16.5h13.58"/></svg>
                    <span class="text-[9px] font-bold uppercase tracking-widest">Premium</span>
                  </div>
                ` : ''}
                <div class="absolute inset-0 bg-[#121110]/50 group-hover:bg-[#121110]/60 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto backdrop-blur-[2px]">
                  <div class="flex flex-col sm:flex-row gap-2 px-4 w-full justify-center items-center">
                    <a href="${item.previewUrl}" target="_blank" rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-1.5 px-4 py-2 sm:px-5 sm:py-2.5 bg-[#FAF9F6] text-brand-950 text-[9px] sm:text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-white transition-colors duration-300 shadow-sm w-full sm:w-auto">
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                      Preview
                    </a>
                    <a href="/order-undangan/?template=${item.id}"
                      class="inline-flex items-center justify-center gap-1.5 px-4 py-2 sm:px-5 sm:py-2.5 bg-brand-900 text-cream text-[9px] sm:text-[10px] font-bold uppercase tracking-widest rounded-full hover:bg-brand-950 transition-colors duration-300 shadow-sm w-full sm:w-auto">
                      Order
                      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
              <div class="p-5 space-y-2.5">
                <div>
                  <h3 class="font-serif text-base text-brand-900 font-semibold line-clamp-1 group-hover:text-soft-gold transition-colors duration-300">${item.title}</h3>
                  <p class="text-[10px] text-text-muted capitalize font-semibold tracking-wider">${item.category}</p>
                </div>
              </div>
            </article>
          `).join('');
          resultsGrid.classList.remove('hidden');
          resultsGrid.classList.add('grid');
        } else {
          resultsGrid.classList.add('hidden');
          resultsGrid.classList.remove('grid');
          noResults?.classList.remove('hidden');
        }
      } else {
        resetSearch();
      }
    });

    clearBtn?.addEventListener('click', resetSearch);

    function resetSearch() {
      input.value = '';
      clearBtn?.classList.add('hidden');
      clearBtn?.classList.remove('flex');
      searchSection.classList.add('hidden');
      showroomSection.classList.remove('hidden');
    }
  }

  // Initial load
  initDesignSearch();
  // View Transitions
  document.addEventListener('astro:page-load', initDesignSearch);
</script>
