        b.classList.add("border-transparent", "text-text-muted"),
      );

      btn.classList.add("active", "border-brand-600", "text-brand-800");
      btn.classList.remove("border-transparent", "text-text-muted");

      const target = btn.getAttribute("data-view");
      viewContents.forEach((c) => {
        if (c.id === `view-${target}`) {
          c.classList.remove("hidden");
          c.classList.add("block");
        } else {
          c.classList.remove("block");
          c.classList.add("hidden");
        }
      });
    });
  });

  // Main Submit handler
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const pNameRaw =
        (document.getElementById("pria-name") as HTMLInputElement).value ||
        "Calon Suami";
      const wNameRaw =
        (document.getElementById("wanita-name") as HTMLInputElement).value ||
        "Calon Istri";
      const pName = escapeHTML(pNameRaw);
      const wName = escapeHTML(wNameRaw);
      const pDateVal = (
        document.getElementById("pria-date") as HTMLInputElement
      ).value;
      const wDateVal = (
        document.getElementById("wanita-date") as HTMLInputElement
      ).value;
      const selectedYear = parseInt(
        (document.getElementById("rencana-tahun") as HTMLSelectElement).value,
        10,
      );

      const isWeekendOnly = (
        document.getElementById("filter-weekend") as HTMLInputElement
      ).checked;
      const isAvoidPantangan = (
        document.getElementById("filter-pantangan") as HTMLInputElement
      ).checked;
      const isPrioritizeCantik = (
        document.getElementById("filter-cantik") as HTMLInputElement
      ).checked;

      if (!pDateVal || !wDateVal) return;

      // 1. Calculate Weton of couple
      const wetonPria = calculateWeton(parseInputDate(pDateVal));
      const wetonWanita = calculateWeton(parseInputDate(wDateVal));
      const jodohComp = getCompatibility(wetonPria.neptu, wetonWanita.neptu);
      const totalNeptuJodoh = wetonPria.neptu + wetonWanita.neptu;

      // Render Ringkasan
      if (ringkasanJodoh) {
        ringkasanJodoh.innerHTML = `
          <div class="text-center pb-4 border-b border-brand-200/40">
            <span class="text-[10px] uppercase font-bold tracking-widest text-soft-gold">Kecocokan Pondasi Pernikahan</span>
            <h4 class="font-serif text-2xl font-bold text-brand-900 mt-2 mb-1">${pName} & ${wName}</h4>
            <p class="text-xs text-text-muted">Total Neptu Jodoh: ${wetonPria.neptu} + ${wetonWanita.neptu} = ${totalNeptuJodoh}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 bg-white rounded-xl border border-brand-200/20 text-center space-y-1">
              <span class="block text-[10px] uppercase font-bold text-text-muted">Weton Pria</span>
              <span class="block text-sm font-bold text-brand-900">${wetonPria.hari} ${wetonPria.pasaran}</span>
              <span class="text-[10px] text-text-muted">(Neptu ${wetonPria.neptu})</span>
            </div>
            <div class="p-4 bg-white rounded-xl border border-brand-200/20 text-center space-y-1">
              <span class="block text-[10px] uppercase font-bold text-text-muted">Weton Wanita</span>
              <span class="block text-sm font-bold text-brand-900">${wetonWanita.hari} ${wetonWanita.pasaran}</span>
              <span class="text-[10px] text-text-muted">(Neptu ${wetonWanita.neptu})</span>
            </div>
          </div>
          <div class="p-5 bg-white rounded-xl border border-gradient text-center space-y-2">
            <span class="text-[10px] font-bold uppercase tracking-widest text-soft-gold">Tafsir Ramalan Jodoh</span>
            <span class="block text-lg font-bold text-brand-800">${jodohComp.hasil}</span>
            <p class="text-xs text-text-secondary leading-relaxed max-w-2xl mx-auto">${jodohComp.desc}</p>
          </div>
        `;
      }

      // 2. Generate Days in selected year
      const startDate = new Date(selectedYear, 0, 1);
      const endDate = new Date(selectedYear, 11, 31);

      // If chosen year is current year, start from today
      const today = new Date();
      let actualStartDate = startDate;
      if (today.getFullYear() === selectedYear) {
        actualStartDate = new Date(
          today.getFullYear(),
          today.getMonth(),
          today.getDate(),
        );
      }

      selectedPlanYear = selectedYear;
      selectedPlanMinMonth = actualStartDate.getMonth();
      selectedPlanMaxMonth = 11;
      currentCalendarYear = selectedYear;
      currentCalendarMonth = actualStartDate.getMonth();

      processedDates = [];

      // Weton lahir pasangan cukup dihitung sekali, bukan diulang untuk setiap tanggal.
      const pBirthWeton = wetonPria;
      const wBirthWeton = wetonWanita;

      // Iterate through year dates
      let curr = new Date(actualStartDate);
      while (curr <= endDate) {
        const dateObj = new Date(curr);
        const dayOfWeek = dateObj.getDay();

        // Apply weekend filter
        if (isWeekendOnly && dayOfWeek !== 0 && dayOfWeek !== 6) {
          curr.setDate(curr.getDate() + 1);
          continue;
        }

        const dateWeton = calculateWeton(dateObj);
        const sasiJawa = getJavaneseMonth(dateObj);

        // Check month pantangan
        if (isAvoidPantangan && sasiJawa.status === "Pantangan") {
          curr.setDate(curr.getDate() + 1);
          continue;
        }

        // Calculations
        const grandNeptu = totalNeptuJodoh + dateWeton.neptu;

        const mod5 = grandNeptu % 5;
        const mod5Result = PANCASUDA_5[mod5 as keyof typeof PANCASUDA_5];

        const mod7 = grandNeptu % 7;
        const mod7Result = PANCASUDA_7[mod7 as keyof typeof PANCASUDA_7];

        const isCantik = isBeautifulDate(dateObj);

        // Scoring engine
        let score = 50; // Neutral baseline

        // Modulo 5
        if (mod5 === 1 || mod5 === 2 || mod5 === 3)
          score += 20; // Sri, Lungguh, Gedhong
        else if (mod5 === 4)
          score -= 10; // Lara
        else if (mod5 === 0) score -= 30; // Pati

        // Modulo 7
        if (mod7 === 1 || mod7 === 2 || mod7 === 3 || mod7 === 4)
          score += 15; // Wasesa, Tunggak, Satria, Sumur
        else if (mod7 === 5)
          score += 5; // Bumi Kapetak
        else score -= 20; // Satria Wirang, Lebu Katiup Angin

        // Month
        score += sasiJawa.bobot;

        // Beautiful Date bonus
        if (isPrioritizeCantik && isCantik) score += 15;

        // Weekend bonus
        if (dayOfWeek === 0 || dayOfWeek === 6) score += 5;

        // Naas check (apakah bertepatan dengan weton lahir mempelai?)
        let isNaas = false;
        let naasReason = "";

        if (
          dateWeton.hari === pBirthWeton.hari &&
          dateWeton.pasaran === pBirthWeton.pasaran
        ) {
          isNaas = true;
          naasReason = "Bertepatan dengan Weton Lahir Suami";
        } else if (
          dateWeton.hari === wBirthWeton.hari &&
          dateWeton.pasaran === wBirthWeton.pasaran
        ) {
          isNaas = true;
          naasReason = "Bertepatan dengan Weton Lahir Istri";
        }

        if (isNaas) {
          score -= 35;
        }

        // Clamp score
        score = clampScore(score);

        // Rating Star
        let stars = 3;
        if (score >= 88) stars = 5;
        else if (score >= 70) stars = 4;
        else if (score >= 45) stars = 3;
        else if (score >= 30) stars = 2;
        else stars = 1;

        processedDates.push({
          date: dateObj,
          weton: dateWeton,
          sasi: sasiJawa,
          grandNeptu,
          mod5: mod5Result,
          mod7: mod7Result,
          isCantik,
          isNaas,
          naasReason,
          score,
          stars,
        });

        curr.setDate(curr.getDate() + 1);
      }

      // Sort by score first for Golden Cards
      const sortedByScore = [...processedDates].sort(
        (a, b) => b.score - a.score,
      );
      const top5 = sortedByScore.filter((d) => d.stars >= 4).slice(0, 5);

      // Render Golden Cards
      if (goldenCardsContainer) {
        if (top5.length === 0) {
          goldenCardsContainer.innerHTML = `
            <div class="col-span-full py-8 text-center bg-brand-50/50 rounded-xl border border-brand-200/20 text-xs text-text-muted">
              Tidak ditemukan hari istimewa bintang 4 atau 5 dalam tahun ini berdasarkan filter yang aktif. Coba nonaktifkan beberapa penyaring.
            </div>
          `;
        } else {
          goldenCardsContainer.innerHTML = top5
            .map((d, idx) => {
              const formattedDate = d.date.toLocaleDateString("id-ID", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
              });
              return `
              <div class="p-5 bg-white border rounded-2xl golden-card-glow transition-all duration-300 relative overflow-hidden flex flex-col justify-between space-y-4">
                <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-champagne/10 to-transparent rounded-bl-full pointer-events-none"></div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-soft-gold bg-cream-warm border border-champagne/30 rounded-full">Pilihan Utama #${idx + 1}</span>
                    <div class="flex text-soft-gold text-xs font-bold gap-0.5">
                      ${"★".repeat(d.stars)}
                    </div>
                  </div>
                  <h5 class="font-serif text-base font-bold text-brand-900">${formattedDate}</h5>
                  <p class="text-xs text-text-secondary mt-1 font-semibold">Weton: ${d.weton.hari} ${d.weton.pasaran} (Neptu ${d.weton.neptu})</p>
                </div>
                <div class="pt-3 border-t border-brand-100/50 space-y-1.5 text-[11px] text-text-secondary">
                  <div class="flex justify-between">
                    <span class="text-text-muted">Pancasuda (5):</span>
                    <span class="font-bold text-brand-800">${d.mod5.nama}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Pancasuda (7):</span>
                    <span class="font-bold text-brand-800">${d.mod7.nama}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Bulan Jawa:</span>
                    <span class="font-bold text-brand-800">${d.sasi.nama}</span>
                  </div>
                </div>
              </div>
            `;
            })
            .join("");
        }
      }

      // Group other recommendations by month
      renderMonthlyList();

      // Setup Calendar View
      renderCalendar();

      // Show Dashboard
      if (dashboard) {
        dashboard.classList.remove("hidden");
        dashboard.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // Render Monthly Accordions list
  function renderMonthlyList() {
    if (!monthlyAccordionContainer) return;

    const monthsName = [
      "Januari",
      "Februari",
      "Maret",
