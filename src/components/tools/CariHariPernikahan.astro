                  return `
                  <div class="p-4 bg-brand-50/20 rounded-xl border border-brand-100/40 hover:bg-brand-50/50 transition-all space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="font-serif text-xs font-bold text-brand-900">${formattedDate}</span>
                      <span class="text-[10px] font-black uppercase tracking-wider ${starColor}">
                        ${"★".repeat(d.stars)}
                      </span>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-[10px] text-text-secondary">
                      <div>Weton: <strong class="text-brand-800">${d.weton.hari} ${d.weton.pasaran}</strong></div>
                      <div>Modulo 5: <strong class="text-brand-800">${d.mod5.nama}</strong></div>
                      <div>Modulo 7: <strong class="text-brand-800">${d.mod7.nama}</strong></div>
                      <div>Bulan: <strong class="text-brand-800">${d.sasi.nama}</strong></div>
                    </div>
