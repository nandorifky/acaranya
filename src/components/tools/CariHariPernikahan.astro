  const EPOCH_DATE = new Date("1970-01-01");

  // Safer helpers
  function escapeHTML(value: string) {
    return value.replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;",
      };
      return entities[char] || char;
    });
  }

  function parseInputDate(value: string) {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function clampScore(score: number) {
    return Math.max(10, Math.min(100, score));
  }

  function copyTextToClipboard(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }

    return new Promise<void>((resolve, reject) => {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      textarea.style.top = "0";
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();

      try {
        const ok = document.execCommand("copy");
        document.body.removeChild(textarea);
        ok ? resolve() : reject(new Error("Gagal menyalin teks."));
      } catch (error) {
        document.body.removeChild(textarea);
        reject(error);
      }
    });
  }

  // Weton engine helper
  function calculateWeton(date: Date) {
    const dayIdx = date.getDay();
    const h = HARI[dayIdx];

    const diffTime = date.getTime() - EPOCH_DATE.getTime();
    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

    let pasaranIdx = diffDays % 5;
    if (pasaranIdx < 0) {
      pasaranIdx = (pasaranIdx + 5) % 5;
    }
    const p = PASARAN[pasaranIdx];
    const neptuTotal = h.neptu + p.neptu;

    return {
      hari: h.nama,
      hariNeptu: h.neptu,
      pasaran: p.nama,
      pasaranNeptu: p.neptu,
      neptu: neptuTotal,
    };
  }

  // Native Islamic calendar conversion.
  // Catatan: ini pendekatan Hijriah Umm al-Qura, bukan kalender Jawa/Kemenag resmi.
  // Untuk akurasi produksi, sebaiknya pakai tabel kalender Jawa/Hijriah Indonesia per tahun.
  function getJavaneseMonth(date: Date) {
    try {
      const formatter = new Intl.DateTimeFormat("id-ID-u-ca-islamic-umalqura", {
        month: "numeric",
      });
      const parts = formatter.formatToParts(date);
      const monthPart = parts.find((p) => p.type === "month");
      const mVal = monthPart ? parseInt(monthPart.value, 10) : NaN;

      if (!Number.isFinite(mVal) || mVal < 1 || mVal > 12) {
        throw new Error("Bulan Hijriah tidak valid.");
      }

      return {
        idx: mVal - 1,
        ...MONTHS_JAWA[mVal - 1],
      };
    } catch (e) {
      // Fallback netral agar browser yang tidak mendukung kalender Islam
      // tidak otomatis memberi skor sangat baik untuk semua tanggal.
      return {
        idx: -1,
        nama: "Bulan tidak terdeteksi",
        status: "Netral",
        bobot: 0,
        ket: "Kalender Hijriah/Jawa tidak tersedia di browser ini.",
      };
    }
  }

  // Check beautiful date
  function isBeautifulDate(date: Date) {
    const d = date.getDate();
    const m = date.getMonth() + 1;
    // e.g. 6/6, 7/7, 8/8, 9/9, 10/10, 11/11, 12/12
    if (d === m) return true;
    // e.g. 20/02, 22/02
    if (d === 20 && m === 2) return true;
    if (d === 22 && m === 2) return true;
    return false;
  }

  // Check compatibility
  function getCompatibility(n1: number, n2: number) {
    const total = n1 + n2;
    const rem = total % 8;

    switch (rem) {
      case 1:
        return COMPATIBILITY.PEGAT;
      case 2:
        return COMPATIBILITY.RATU;
      case 3:
        return COMPATIBILITY.JODOH;
      case 4:
        return COMPATIBILITY.TOPO;
      case 5:
        return COMPATIBILITY.TINARI;
      case 6:
        return COMPATIBILITY.PADU;
      case 7:
        return COMPATIBILITY.SUJANAN;
      case 0:
        return COMPATIBILITY.PESTHI;
      default:
        return COMPATIBILITY.JODOH;
    }
  }

  // Active state data for calculations
  let processedDates: any[] = [];
  let currentCalendarMonth = 5; // June by default
  let currentCalendarYear = 2026;
  let selectedPlanYear = 2026;
  let selectedPlanMinMonth = 0;
  let selectedPlanMaxMonth = 11;

  // DOM Elements
  const form = document.getElementById("form-cari-hari") as HTMLFormElement;
  const dashboard = document.getElementById("dashboard-hasil");

  const ringkasanJodoh = document.getElementById("hasil-ringkasan-jodoh");
  const goldenCardsContainer = document.getElementById(
    "golden-cards-container",
