  // Render Calendar Grid
  function renderCalendar() {
    if (!calendarDaysGrid || !calendarMonthLabel) return;

    const monthsName = [
      "Januari",
      "Februari",
      "Maret",
      "April",
      "Mei",
      "Juni",
      "Juli",
      "Agustus",
      "September",
      "Oktober",
      "November",
      "Desember",
    ];
    calendarMonthLabel.textContent = `${monthsName[currentCalendarMonth]} ${currentCalendarYear}`;

    if (btnPrevMonth) {
      const isFirstAllowedMonth =
        currentCalendarYear === selectedPlanYear &&
        currentCalendarMonth <= selectedPlanMinMonth;
      btnPrevMonth.toggleAttribute("disabled", isFirstAllowedMonth);
      btnPrevMonth.classList.toggle("opacity-40", isFirstAllowedMonth);
      btnPrevMonth.classList.toggle("cursor-not-allowed", isFirstAllowedMonth);
    }

    if (btnNextMonth) {
      const isLastAllowedMonth =
        currentCalendarYear === selectedPlanYear &&
        currentCalendarMonth >= selectedPlanMaxMonth;
      btnNextMonth.toggleAttribute("disabled", isLastAllowedMonth);
      btnNextMonth.classList.toggle("opacity-40", isLastAllowedMonth);
      btnNextMonth.classList.toggle("cursor-not-allowed", isLastAllowedMonth);
    }

    // Get first day of month
    const firstDay = new Date(currentCalendarYear, currentCalendarMonth, 1);
    const startDayOfWeek = firstDay.getDay();

    // Get number of days in month
    const totalDays = new Date(
      currentCalendarYear,
      currentCalendarMonth + 1,
      0,
    ).getDate();

    let gridHTML = "";

    // Blank cells before first day
    for (let i = 0; i < startDayOfWeek; i++) {
      gridHTML += `<div class="p-3 bg-brand-50/10 text-transparent select-none">-</div>`;
    }

    // Days cells
    for (let day = 1; day <= totalDays; day++) {
      const dateVal = new Date(currentCalendarYear, currentCalendarMonth, day);

      // Find matches in calculated dates
      const calcData = processedDates.find((d) => {
        return (
          d.date.getDate() === day && d.date.getMonth() === currentCalendarMonth
        );
      });

      let cellClass =
        "p-3 bg-white border border-brand-100/30 rounded-lg hover:bg-brand-50/50 transition-all cursor-pointer relative flex flex-col items-center justify-between min-h-[50px]";
      let indicatorDot = "";

      if (calcData) {
        if (calcData.stars === 5) {
          cellClass +=
            " border-soft-gold bg-cream-warm font-bold text-brand-900 shadow-[0_0_6px_rgba(201,183,125,0.3)]";
          indicatorDot = `<span class="w-1.5 h-1.5 rounded-full bg-soft-gold shadow-[0_0_4px_rgba(201,183,125,1)]"></span>`;
        } else if (calcData.stars === 4) {
          cellClass += " font-semibold text-brand-900";
          indicatorDot = `<span class="w-1.5 h-1.5 rounded-full bg-success"></span>`;
        } else if (calcData.stars === 3) {
          indicatorDot = `<span class="w-1.5 h-1.5 rounded-full bg-warning"></span>`;
        }
      } else {
        // Did not match filters (e.g. filtered out weekdays or pantangan)
        cellClass +=
          " bg-brand-50/30 text-text-muted opacity-40 cursor-not-allowed pointer-events-none";
      }

      gridHTML += `
        <div class="${cellClass}" data-day="${day}">
          <span class="block">${day}</span>
          ${indicatorDot}
        </div>
      `;
    }

    calendarDaysGrid.innerHTML = gridHTML;

    // Attach click events on day cells
    const dayCells = calendarDaysGrid.querySelectorAll("[data-day]");
    dayCells.forEach((cell) => {
      cell.addEventListener("click", () => {
        // Clear active styles
        dayCells.forEach((c) => c.classList.remove("ring-2", "ring-brand-500"));
        cell.classList.add("ring-2", "ring-brand-500");

        const day = parseInt(cell.getAttribute("data-day")!, 10);
        showCalendarDayDetail(day);
      });
    });

    // Auto-select first recommended day in month if exists
    const firstCell = calendarDaysGrid.querySelector(
      "[data-day]:not(.pointer-events-none)",
    );
    if (firstCell) {
      firstCell.dispatchEvent(new Event("click"));
    } else {
      if (detailPanel) {
        detailPanel.innerHTML = `
          <div class="text-center py-10 text-text-muted text-xs my-auto">
            Tidak ada hari baik pernikahan yang direkomendasikan pada bulan ini berdasarkan preferensi filter Anda.
          </div>
        `;
      }
    }
  }

  // Show calendar day details
  function showCalendarDayDetail(day: number) {
    if (!detailPanel) return;

    const data = processedDates.find((d) => {
      return (
        d.date.getDate() === day && d.date.getMonth() === currentCalendarMonth
      );
    });

    if (!data) return;

    const formattedDate = data.date.toLocaleDateString("id-ID", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    });
    const starText = "★".repeat(data.stars);
    const starColor =
      data.stars === 5
        ? "text-soft-gold"
        : data.stars === 4
          ? "text-success"
          : "text-warning";

    detailPanel.innerHTML = `
      <div class="space-y-4">
        <div class="text-center pb-3 border-b border-brand-200/30">
          <span class="text-[9px] uppercase font-bold tracking-widest text-text-muted">Detail Kelayakan Hajat</span>
          <h5 class="font-serif text-sm font-bold text-brand-900 mt-1">${formattedDate}</h5>
          <span class="block text-xs font-black mt-1 ${starColor}">${starText}</span>
        </div>

        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <div class="p-3 bg-white rounded-xl border border-brand-200/10">
            <span class="block font-bold text-brand-800 uppercase text-[9px] mb-0.5">Weton Hari: ${data.weton.hari} ${data.weton.pasaran}</span>
            <p class="text-[10px] text-text-muted">Bernilai Neptu ${data.weton.neptu} (Saptawara ${data.weton.hariNeptu} + Pancawara ${data.weton.pasaranNeptu})</p>
          </div>

          <div class="p-3 bg-white rounded-xl border border-brand-200/10">
            <span class="block font-bold text-brand-800 uppercase text-[9px] mb-0.5">Modulo 5: ${data.mod5.nama}</span>
            <p class="text-[10px] text-text-muted">${data.mod5.ket}</p>
          </div>

          <div class="p-3 bg-white rounded-xl border border-brand-200/10">
            <span class="block font-bold text-brand-800 uppercase text-[9px] mb-0.5">Modulo 7: ${data.mod7.nama}</span>
            <p class="text-[10px] text-text-muted">${data.mod7.ket}</p>
          </div>

          <div class="p-3 bg-white rounded-xl border border-brand-200/10">
            <span class="block font-bold text-brand-800 uppercase text-[9px] mb-0.5">Bulan Jawa: ${data.sasi.nama}</span>
            <p class="text-[10px] text-text-muted">${data.sasi.ket}</p>
          </div>

          ${
            data.isCantik
              ? `
            <div class="p-3 bg-cream-warm border border-champagne/20 rounded-xl">
              <span class="block font-bold text-soft-gold uppercase text-[9px] mb-0.5">Tanggal Cantik Terdeteksi</span>
              <p class="text-[10px] text-text-secondary">Tanggal ini merupakan pola kembar masehi yang indah dan mudah diingat.</p>
            </div>
          `
              : ""
          }

          ${
            data.isNaas
              ? `
            <div class="p-3 bg-error/5 border border-error/15 rounded-xl">
              <span class="block font-bold text-error uppercase text-[9px] mb-0.5">Pantangan Dino Naas</span>
              <p class="text-[10px] text-error">${data.naasReason} calon pengantin. Sangat disarankan berikhtiar ekstra.</p>
            </div>
          `
              : ""
          }
        </div>
      </div>
      
      <div class="pt-4 border-t border-brand-100/50 text-center">
        <span class="text-[10px] text-text-muted">Skor Kelayakan Keluhuran: <strong class="text-brand-900">${data.score}%</strong></span>
      </div>
    `;
  }

  // Calendar prev/next navigation
  if (btnPrevMonth) {
    btnPrevMonth.addEventListener("click", () => {
      if (currentCalendarMonth > selectedPlanMinMonth) {
        currentCalendarMonth--;
        renderCalendar();
      }
    });
  }

  if (btnNextMonth) {
    btnNextMonth.addEventListener("click", () => {
      if (currentCalendarMonth < selectedPlanMaxMonth) {
        currentCalendarMonth++;
        renderCalendar();
      }
    });
  }

  // Clipboard copy action
  if (btnCopy) {
    btnCopy.addEventListener("click", () => {
      const topDates = [...processedDates]
        .sort((a, b) => b.score - a.score)
        .filter((d) => d.stars >= 4)
        .slice(0, 5);
      if (topDates.length === 0) return;

      const pNameRaw =
        (document.getElementById("pria-name") as HTMLInputElement).value ||
        "Calon Suami";
      const wNameRaw =
        (document.getElementById("wanita-name") as HTMLInputElement).value ||
        "Calon Istri";
      const pName = pNameRaw.trim() || "Calon Suami";
      const wName = wNameRaw.trim() || "Calon Istri";

      let text = `Rekomendasi Hari & Tanggal Pernikahan Terbaik (${pName} & ${wName}) oleh Acaranya.id\n\n`;
      text += `Rekomendasi Tanggal Teratas:\n`;

      topDates.forEach((d, idx) => {
        const formattedDate = d.date.toLocaleDateString("id-ID", {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        });
        text += `${idx + 1}. ${formattedDate} (${d.weton.hari} ${d.weton.pasaran})\n`;
        text += `   - Pancasuda (5): ${d.mod5.nama}\n`;
        text += `   - Pancasuda (7): ${d.mod7.nama}\n`;
        text += `   - Bulan Jawa: ${d.sasi.nama}\n\n`;
      });

      text += `Perhitungan selengkapnya di https://acaranya.id/cari-hari-pernikahan/`;

      const defaultCopyButtonHTML = `
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
        </svg>
        Salin Hasil
      `;

      copyTextToClipboard(text)
        .then(() => {
          btnCopy.innerHTML = `
          <svg class="w-3.5 h-3.5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          Berhasil Disalin
        `;
          setTimeout(() => {
            btnCopy.innerHTML = defaultCopyButtonHTML;
          }, 2000);
        })
        .catch(() => {
          btnCopy.innerHTML = `
          <svg class="w-3.5 h-3.5 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          Gagal Menyalin
        `;
          setTimeout(() => {
            btnCopy.innerHTML = defaultCopyButtonHTML;
          }, 2000);
        });
    });
  }

  // Print action
  if (btnPrint) {
    btnPrint.addEventListener("click", () => {
      window.print();
    });
  }
</script>
