---
// src/components/tools/CariHariPernikahan.astro
---

<div class="cari-hari-container font-sans text-brand-950">
  <!-- Input Form Section -->
  <form id="form-cari-hari" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Data Calon Suami -->
      <div
        class="space-y-3 p-5 bg-cream-warm/40 rounded-2xl border border-brand-200/30"
      >
        <h3
          class="text-xs font-bold text-brand-800 uppercase tracking-wider flex items-center gap-2"
        >
          <svg
            class="w-4 h-4 text-brand-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
          </svg>
          Mempelai Pria
        </h3>
        <div>
          <label
            class="block text-[11px] font-semibold text-text-secondary mb-1"
            >Nama Lengkap</label
          >
          <input
            type="text"
            id="pria-name"
            placeholder="Nama Calon Suami..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-brand-200 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm transition-all"
          />
        </div>
        <div>
          <label
            class="block text-[11px] font-semibold text-text-secondary mb-1"
            >Tanggal Lahir</label
          >
          <input
            type="date"
            id="pria-date"
            class="w-full px-3.5 py-2.5 rounded-xl border border-brand-200 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm transition-all"
            required
          />
        </div>
      </div>

      <!-- Data Calon Istri -->
      <div
        class="space-y-3 p-5 bg-cream-warm/40 rounded-2xl border border-brand-200/30"
      >
        <h3
          class="text-xs font-bold text-brand-800 uppercase tracking-wider flex items-center gap-2"
        >
          <svg
            class="w-4 h-4 text-brand-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
          </svg>
          Mempelai Wanita
        </h3>
        <div>
          <label
            class="block text-[11px] font-semibold text-text-secondary mb-1"
            >Nama Lengkap</label
          >
          <input
            type="text"
            id="wanita-name"
            placeholder="Nama Calon Istri..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-brand-200 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm transition-all"
          />
        </div>
        <div>
          <label
            class="block text-[11px] font-semibold text-text-secondary mb-1"
            >Tanggal Lahir</label
          >
          <input
            type="date"
            id="wanita-date"
            class="w-full px-3.5 py-2.5 rounded-xl border border-brand-200 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm transition-all"
            required
          />
        </div>
      </div>
    </div>

    <!-- Parameter Acara -->
    <div class="p-5 bg-white rounded-2xl border border-brand-200/40 space-y-4">
      <h3 class="text-xs font-bold text-brand-800 uppercase tracking-wider">
        Parameter Acara
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label
            class="block text-[11px] font-semibold text-text-secondary mb-1"
            >Rencana Tahun Pernikahan</label
          >
          <select
            id="rencana-tahun"
            class="w-full px-3.5 py-2.5 rounded-xl border border-brand-200 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-sm transition-all"
          >
            <option value="2026" selected>2026</option>
            <option value="2027">2027</option>
            <option value="2028">2028</option>
          </select>
        </div>
      </div>

      <!-- Filter Preferensi -->
      <div class="pt-2 border-t border-brand-100 space-y-3">
        <label
          class="block text-[11px] font-bold text-brand-800 uppercase tracking-wider mb-2"
          >Preferensi Pencarian</label
        >
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <label
            class="flex items-center gap-3 p-3 rounded-xl border border-brand-100 hover:bg-brand-50/50 cursor-pointer transition-all select-none"
          >
            <input
              type="checkbox"
              id="filter-weekend"
              checked
              class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-brand-300"
            />
            <div class="flex flex-col">
              <span class="text-xs font-bold text-brand-900"
                >Hanya Akhir Pekan</span
              >
              <span class="text-[10px] text-text-muted"
                >Tampilkan Sabtu & Minggu</span
              >
            </div>
          </label>

          <label
            class="flex items-center gap-3 p-3 rounded-xl border border-brand-100 hover:bg-brand-50/50 cursor-pointer transition-all select-none"
          >
            <input
              type="checkbox"
              id="filter-pantangan"
              checked
              class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-brand-300"
            />
            <div class="flex flex-col">
              <span class="text-xs font-bold text-brand-900"
                >Hindari Bulan Pantangan</span
              >
              <span class="text-[10px] text-text-muted">Suro dan Ramadan</span>
            </div>
          </label>

          <label
            class="flex items-center gap-3 p-3 rounded-xl border border-brand-100 hover:bg-brand-50/50 cursor-pointer transition-all select-none"
          >
            <input
              type="checkbox"
              id="filter-cantik"
              checked
              class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-brand-300"
            />
            <div class="flex flex-col">
              <span class="text-xs font-bold text-brand-900"
                >Poin Tanggal Cantik</span
              >
              <span class="text-[10px] text-text-muted"
                >Prioritas pola kembar</span
              >
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Tombol Submit -->
    <button
      type="submit"
      class="w-full py-3.5 bg-brand-800 hover:bg-brand-900 text-white rounded-xl font-semibold text-sm shadow-sm transition-all transform hover:scale-[1.005] active:scale-[0.995] flex items-center justify-center gap-2"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span>Cari Tanggal Pernikahan Terbaik</span>
    </button>
  </form>

  <!-- Output Dashboard Section (Hidden by Default) -->
  <div id="dashboard-hasil" class="hidden mt-10 space-y-8 animate-fade-in">
    <!-- 1. Ringkasan Kecocokan Jodoh Dasar -->
    <div
      id="hasil-ringkasan-jodoh"
      class="p-6 bg-brand-50/50 border border-brand-200/50 rounded-2xl space-y-4"
    >
      <!-- Dynamic summary content -->
    </div>

    <!-- Tampilan Visual Selector Tabs -->
    <div class="flex border-b border-brand-200">
      <button
        class="view-tab-btn active flex-1 py-3 text-sm font-semibold border-b-2 border-brand-600 text-brand-800 focus:outline-none transition-all flex items-center justify-center gap-2"
        data-view="list"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        Tampilan Daftar
      </button>
      <button
        class="view-tab-btn flex-1 py-3 text-sm font-semibold border-b-2 border-transparent text-text-muted hover:text-brand-800 focus:outline-none transition-all flex items-center justify-center gap-2"
        data-view="calendar"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Tampilan Kalender
      </button>
    </div>

    <!-- Opsi A: Tampilan Daftar -->
    <div id="view-list" class="view-content block space-y-6">
      <!-- Top 5 Golden Cards -->
      <div class="space-y-3">
        <h4
          class="text-xs font-bold text-soft-gold uppercase tracking-widest flex items-center gap-2"
        >
          <svg
            class="w-4 h-4 text-soft-gold"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          Top 5 Hari Pernikahan Terindah
        </h4>
        <div
          id="golden-cards-container"
          class="grid grid-cols-1 md:grid-cols-2 gap-4"
        >
          <!-- Dynamic gold cards -->
        </div>
      </div>

      <!-- Accordion Kelompok per Bulan -->
      <div class="space-y-3 pt-4">
        <h4 class="text-xs font-bold text-brand-800 uppercase tracking-widest">
          Rekomendasi Berdasarkan Bulan
        </h4>
        <div id="monthly-accordion-container" class="space-y-3">
          <!-- Dynamic monthly list accordions -->
        </div>
      </div>
    </div>

    <!-- Opsi B: Tampilan Kalender -->
    <div id="view-calendar" class="view-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Kalender Grid Kolom (Kiri-Tengah) -->
        <div class="lg:col-span-2 space-y-4">
          <div
            class="flex items-center justify-between p-3 bg-cream rounded-xl border border-brand-200/50"
          >
            <button
              id="btn-prev-month"
              type="button"
              class="p-2 hover:bg-brand-100 rounded-lg transition-all"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
            <span
              id="calendar-month-label"
              class="font-serif text-lg font-bold text-brand-900"
              >Januari 2026</span
            >
            <button
              id="btn-next-month"
              type="button"
              class="p-2 hover:bg-brand-100 rounded-lg transition-all"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>

          <!-- Calendar Board -->
          <div class="bg-white p-4 rounded-2xl border border-brand-200/30">
            <!-- Days header -->
            <div
              class="grid grid-cols-7 gap-1 text-center font-bold text-xs text-text-muted mb-2 py-1.5 border-b border-brand-50"
            >
              <div>Min</div>
              <div>Sen</div>
              <div>Sel</div>
              <div>Rab</div>
              <div>Kam</div>
              <div>Jum</div>
              <div>Sab</div>
            </div>
            <!-- Days grid container -->
            <div
              id="calendar-days-grid"
              class="grid grid-cols-7 gap-1 text-center text-xs"
            >
              <!-- Dynamically populated dates -->
            </div>
          </div>

          <!-- Legend -->
          <div
            class="flex flex-wrap gap-4 justify-center text-[10px] text-text-muted pt-2"
          >
            <span class="flex items-center gap-1.5">
              <span
                class="w-2.5 h-2.5 rounded-full bg-soft-gold shadow-[0_0_6px_rgba(201,183,125,0.8)]"
              ></span>
              Sangat Direkomendasikan (Bintang 5)
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-success"></span>
              Baik (Bintang 4)
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-warning"></span>
              Cukup (Bintang 3)
            </span>
            <span class="flex items-center gap-1.5">
              <span
                class="w-2.5 h-2.5 rounded-full bg-brand-100 border border-brand-300"
              ></span>
              Kurang Disarankan / Dihindari
            </span>
          </div>
        </div>

        <!-- Panel Detail Tanggal yang Dipilih (Kanan) -->
        <div class="space-y-4">
          <div
            id="calendar-day-detail-panel"
            class="p-5 bg-cream-warm/50 rounded-2xl border border-brand-200/40 min-h-[350px] flex flex-col justify-between"
          >
            <div class="text-center py-10 text-text-muted text-xs my-auto">
              Silakan pilih tanggal bertanda di kalender untuk melihat rincian
              kelayakan spiritual dan catatan penting.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Export & Print Area -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-5 bg-cream-warm/30 rounded-2xl border border-brand-200/30 gap-4 transition-all duration-300"
    >
      <div class="space-y-1">
        <h5 class="text-xs font-bold text-brand-900 uppercase tracking-wider">
          Simpan & Bagikan Rekomendasi
        </h5>
        <p class="text-[11px] text-text-muted leading-relaxed max-w-sm">
          Salin teks ringkasan untuk berdiskusi bersama keluarga atau cetak
          langsung sebagai panduan fisik.
        </p>
      </div>
      <div class="flex gap-2.5 w-full sm:w-auto">
        <button
          id="btn-copy-results"
          class="flex-1 sm:flex-initial px-4 py-2.5 text-xs font-semibold text-brand-800 hover:text-brand-900 bg-white hover:bg-brand-50 border border-brand-200/80 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
            ></path>
          </svg>
          <span>Salin Ringkasan</span>
        </button>
        <button
          id="btn-print-results"
          class="flex-1 sm:flex-initial px-4 py-2.5 text-xs font-semibold text-white bg-brand-800 hover:bg-brand-900 rounded-xl transition-all shadow-sm flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 00-2 2h2m2 4h10a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h6z"
            ></path>
          </svg>
          <span>Cetak Halaman</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .golden-card-glow {
    box-shadow: 0 4px 20px rgba(201, 183, 125, 0.15);
    border-color: rgba(201, 183, 125, 0.5);
  }

  .golden-card-glow:hover {
    box-shadow: 0 10px 30px rgba(201, 183, 125, 0.25);
    border-color: rgba(201, 183, 125, 0.8);
  }

  /* Custom Print styles */
  @media print {
    body * {
      visibility: hidden;
    }
    #dashboard-hasil,
    #dashboard-hasil * {
      visibility: visible;
    }
    #dashboard-hasil {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
    }
    .view-tab-btn,
    #btn-copy-results,
    #btn-print-results,
    #form-cari-hari {
      display: none !important;
    }
  }
</style>

