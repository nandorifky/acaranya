  );

  const calendarMonthLabel = document.getElementById("calendar-month-label");
  const calendarDaysGrid = document.getElementById("calendar-days-grid");
  const btnPrevMonth = document.getElementById("btn-prev-month");
  const btnNextMonth = document.getElementById("btn-next-month");
  const detailPanel = document.getElementById("calendar-day-detail-panel");

  const tabBtns = document.querySelectorAll(".view-tab-btn");
  const viewContents = document.querySelectorAll(".view-content");

  const btnCopy = document.getElementById("btn-copy-results");
  const btnPrint = document.getElementById("btn-print-results");

  // Switch tabs
  tabBtns.forEach((btn) => {
