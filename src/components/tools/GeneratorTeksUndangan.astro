---
// src/components/tools/GeneratorTeksUndangan.astro
---

<div class="generator-container font-sans text-brand-950">
  <form id="form-generator" class="space-y-4 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label
          class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2"
          >Nama Pasangan Pengantin</label
        >
        <input
          type="text"
          id="gen-names"
          placeholder="Contoh: Romi & Yuli..."
          class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm"
          required
        />
      </div>
      <div>
        <label
          class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2"
          >Hari & Tanggal Acara</label
        >
        <input
          type="text"
          id="gen-date"
          placeholder="Contoh: Ahad, 12 Oktober 2026..."
          class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm"
          required
        />
      </div>
    </div>

    <div>
      <label
        class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2"
        >Tautan (Link) Undangan Digital</label
      >
      <input
        type="url"
        id="gen-link"
        placeholder="Contoh: https://inv.acaranya.id/romi-yuli"
        class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm"
        required
      />
    </div>

    <div>
      <label
        class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2"
        >Pilih Gaya & Kategori Penerima</label
      >
      <select
        id="gen-style"
        class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm bg-white"
      >
        <option value="teman">Teman Dekat / Sahabat (Hangat & Akrab)</option>
        <option value="atasan"
          >Atasan Kerja / Dosen (Sangat Sopan - "Tanpa Mengurangi Rasa Hormat")</option
        >
        <option value="keluarga"
          >Keluarga Besar / Kerabat Orang Tua (Sopan & Hormat)</option
        >
        <option value="islami"
          >Gaya Islami / Walimatul Ursy (Doa & Salam Khidmat)</option
        >
        <option value="singkat">Singkat & Jelas (To the Point)</option>
        <option value="jawa">Bahasa Jawa Krama Inggil (Serat Ulem WA)</option>
        <option value="sunda">Bahasa Sunda Lemes (Uleman WA)</option>
      </select>
    </div>

    <button
      type="submit"
      class="w-full py-3 bg-brand-800 hover:bg-brand-900 text-white rounded-lg font-semibold text-sm shadow-sm transition-all transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
        ></path>
      </svg>
      <span>Buat Kata-Kata Undangan</span>
    </button>
  </form>

  <!-- Output Section -->
  <div id="result-generator" class="hidden space-y-4 animate-fade-in">
    <div class="p-6 bg-brand-50/40 rounded-2xl border border-brand-200/30">
      <span
        class="text-[10px] uppercase tracking-widest text-brand-700 font-bold bg-brand-100/50 px-3 py-1.5 rounded-full block w-max mb-4 mx-auto"
      >
        Kata-Kata Undangan Siap Kirim
      </span>

      <!-- Textarea containing result -->
      <div
        class="relative bg-white rounded-xl border border-brand-200/30 shadow-inner p-4 text-left"
      >
        <pre
          id="output-text"
          class="text-xs text-text-muted leading-relaxed whitespace-pre-wrap font-sans max-h-72 overflow-y-auto select-all">...</pre>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 max-w-md mx-auto">
        <!-- Copy Button -->
        <button
          id="btn-copy"
          class="py-3 px-4 bg-white border border-brand-200 hover:border-brand-500 text-brand-800 rounded-lg font-semibold text-xs shadow-xs transition-all flex items-center justify-center gap-2"
        >
          <svg
            class="w-4 h-4 text-brand-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
            ></path>
          </svg>
          <span id="copy-label">Salin Teks Chat</span>
        </button>

        <!-- Share to WA Button -->
        <a
          id="btn-wa"
          href="#"
          target="_blank"
          class="py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-semibold text-xs shadow-xs transition-all flex items-center justify-center gap-2"
        >
          <svg
            class="w-4 h-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"
            ></path>
          </svg>
          <span>Kirim via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById("form-generator") as HTMLFormElement;
  const resultDiv = document.getElementById("result-generator");
  const outputText = document.getElementById("output-text");
  const btnCopy = document.getElementById("btn-copy");
  const copyLabel = document.getElementById("copy-label");
  const btnWa = document.getElementById("btn-wa") as HTMLAnchorElement;

  // Template Generation Functions
  function getTemplate(
    names: string,
    date: string,
    link: string,
    style: string,
  ) {
    switch (style) {
      case "teman":
        return `Halo, Sahabatku!

Kabar bahagia akhirnya datang dari kami. Tanpa mengurangi rasa hormat, melalui pesan digital ini kami ingin membagikan momen kebahagiaan kami dengan mengundangmu untuk hadir di acara pernikahan kami:

*Pernikahan: ${names}*
*Hari/Tanggal: ${date}*

Keseruan hari spesial kami tidak akan lengkap tanpa kehadiranmu. Silakan kunjungi tautan berikut untuk info detail acara, waktu, rute lokasi, serta pengisian konfirmasi RSVP kehadiran:

*Tautan Undangan:* ${link}

Terima kasih banyak atas perhatian dan doa restu terbaikmu. Sampai jumpa di hari bahagia kami!`;

      case "atasan":
        return `Selamat pagi/siang Bapak/Ibu,

Dengan segala hormat dan kerendahan hati, tanpa mengurangi rasa hormat kami, kami bermaksud membagikan kabar bahagia pernikahan kami. Melalui media pesan digital ini, kami ingin mengundang Bapak/Ibu untuk berkenan hadir dalam perayaan akad nikah & resepsi kami:

*Pernikahan: ${names}*
*Hari/Tanggal: ${date}*

Merupakan suatu kehormatan dan kebahagiaan yang luar biasa bagi kami apabila Bapak/Ibu berkenan hadir dan memberikan doa restu secara langsung. Detail mengenai waktu, protokol, rute peta lokasi, serta konfirmasi kehadiran dapat Bapak/Ibu akses melalui tautan berikut:

*Undangan Digital:* ${link}

Demikian undangan ini kami sampaikan. Terima kasih banyak atas waktu, perhatian, serta doa restu yang Bapak/Ibu berikan.

Hormat kami,
${names}`;

      case "keluarga":
        return `Assalamualaikum Wr. Wb. / Salam Sejahtera bagi kita semua,

Kepada Yth. Bapak/Ibu/Kerabat sekalian,

Keluarga besar kami memanjatkan puji syukur kehadirat Tuhan Yang Maha Esa atas limpahan rahmat-Nya. Tanpa mengurangi rasa hormat, kami bermaksud mengabarkan sekaligus mengundang Bapak/Ibu/Saudara(i) untuk menghadiri acara syukuran pernikahan putra-putri kami:

*Pernikahan: ${names}*
*Hari/Tanggal: ${date}*

Doa restu serta kehadiran Bapak/Ibu/Saudara(i) sekalian adalah berkah yang sangat melimpah bagi biduk rumah tangga baru yang akan dibina. Detail peta lokasi, waktu, dan pengisian RSVP dapat diakses melalui link undangan berikut:

*Link Undangan:* ${link}

Atas perhatian, doa restu yang tulus, serta kehadiran Bapak/Ibu/Saudara(i), kami sekeluarga besar menghaturkan ucapan terima kasih yang sedalam-dalamnya.

Wassalamualaikum Wr. Wb. / Salam Hormat,
Keluarga Besar Pengantin`;

      case "islami":
        return `Assalamualaikum Warahmatullahi Wabarakatuh,

Dengan memohon rahmat, taufik, serta rida dari Allah SWT, kami bermaksud mengundang Bapak/Ibu/Saudara(i) dalam acara Walimatul 'Ursy (pernikahan) kami:

*Pernikahan: ${names}*
*Hari/Tanggal: ${date}*

"Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang." (QS. Ar-Rum: 21)

Merupakan suatu kebahagiaan bagi kami apabila Bapak/Ibu/Saudara(i) berkenan hadir untuk memberikan doa restu. Informasi detail terkait tata cara acara, rute maps lokasi, dan RSVP kehadiran dapat diakses pada link di bawah ini:

*Undangan Digital:* ${link}

Barakallahu lakum wa baraka 'alaikum. Semoga Allah menghimpun kita dalam kebaikan. Terima kasih atas perhatian dan doa restunya.

Wassalamualaikum Warahmatullahi Wabarakatuh,
${names}`;

      case "singkat":
        return `Dear Sahabat & Rekan sekalian,

Save the date!

Dengan penuh kebahagiaan, kami mengundang Anda untuk merayakan hari pernikahan kami:

*Pernikahan: ${names}*
*Hari/Tanggal: ${date}*

Detail lengkap acara, rute peta navigasi Google Maps, dan konfirmasi kehadiran (RSVP) dapat langsung diakses melalui tautan berikut:

*Link:* ${link}

Doa restu Anda sangat berarti bagi kami. Terima kasih!`;

      case "jawa":
        return `Assalamu’alaikum Wr. Wb.

Nuwun sewu, kanti tulus lan manah ingkang luhur, mboten ngirangi raos kurmat, lumantar serat ulem digital menika, kula sowan dumateng panjenengan sakulawarga, kersaa rawuh wonten ing acara pawiwahan (pernikahan) kula:

*Pawiwahan: ${names}*
*Dinten/Tanggal: ${date}*

Mugi dumateng Gusti Allah paring berkah lan kelancaran. Mugi dadosaken karukunan lan kabagyan kagem kita sedaya. Katerangan jangkep babagan wektu, papan panggenan, lan konfirmasi rawuh saged dipunakses lumantar link ing ngisor menika:

*Serat Ulem:* ${link}

Matur nuwun sanget dumateng kawigatosan, pandonga, saha rawuh panjenengan sakulawarga.

Wassalamu’alaikum Wr. Wb.

Kanthi taklim kula,
${names}`;

      case "sunda":
        return `Assalamu’alaikum Wr. Wb.

Teu ngirangan rasa hormat, ku ayana serat ulem digital ieu, sim kuring sakulawarga maksad ngahaturanan linggih ka Bapa/Ibu/Saderek sadayana dina raraga syukuran pernikahan (walimahan) sim kuring:

*Pernikahan: ${names}*
*Dinten/Ping: ${date}*

Kasadayaan doa restu sareng kasumpingan ti Bapa/Ibu/Saderek sadayana mangrupikeun kabagjaan anu kacida ageungna kanggo sim kuring sakulawarga. Kanggo info langkung jéntré ngeunaan waktos, rute lokasina, sareng RSVP tiasa ditingal dina tautan ieu:

*Serat Uleman:* ${link}

Hatur nuhun anu saageung-ageungna kana kasumpingan sareng doa restuna.

Wassalamu’alaikum Wr. Wb.

Hormat sim kuring,
${names}`;

      default:
        return "";
    }
  }

  if (form && resultDiv && outputText) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const names = (document.getElementById("gen-names") as HTMLInputElement)
        .value;
      const date = (document.getElementById("gen-date") as HTMLInputElement)
        .value;
      const link = (document.getElementById("gen-link") as HTMLInputElement)
        .value;
      const style = (document.getElementById("gen-style") as HTMLSelectElement)
        .value;

      const generatedText = getTemplate(names, date, link, style);
      outputText.innerText = generatedText;

      // Update WA Link
      const waMessage = encodeURIComponent(generatedText);
      btnWa.href = `https://api.whatsapp.com/send?text=${waMessage}`;

      // Reset Copy Button
      if (copyLabel) copyLabel.innerText = "Salin Teks Chat";

      resultDiv.classList.remove("hidden");
    });
  }

  // Copy Clipboard Logic
  if (btnCopy && outputText && copyLabel) {
    btnCopy.addEventListener("click", () => {
      const textToCopy = outputText.innerText;
      navigator.clipboard
        .writeText(textToCopy)
        .then(() => {
          copyLabel.innerText = "Tersalin!";
          setTimeout(() => {
            copyLabel.innerText = "Salin Teks Chat";
          }, 3000);
        })
        .catch((err) => {
          console.error("Failed to copy: ", err);
        });
    });
  }
</script>
