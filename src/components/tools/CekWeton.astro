---
// src/components/tools/CekWeton.astro
---

<div class="weton-container font-sans text-brand-950">
  <!-- Tabs Navigation -->
  <div class="flex border-b border-brand-200 mb-6">
    <button 
      class="tab-btn active flex-1 py-3 text-sm font-semibold border-b-2 border-brand-600 text-brand-800 focus:outline-none transition-all flex items-center justify-center gap-2"
      data-tab="single"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      Cek Weton Pribadi
    </button>
    <button 
      class="tab-btn flex-1 py-3 text-sm font-semibold border-b-2 border-transparent text-text-muted hover:text-brand-800 focus:outline-none transition-all flex items-center justify-center gap-2"
      data-tab="jodoh"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      Cek Weton Jodoh
    </button>
  </div>

  <!-- Tab 1: Cek Weton Pribadi -->
  <div id="tab-single" class="tab-content block">
    <form id="form-single" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">Nama Lengkap</label>
        <input 
          type="text" 
          id="single-name" 
          placeholder="Masukkan nama Anda..." 
          class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm"
          required
        />
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">Tanggal Lahir</label>
        <input 
          type="date" 
          id="single-date" 
          class="w-full px-4 py-3 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all text-sm"
          required
        />
      </div>
      <button 
        type="submit" 
        class="w-full py-3 bg-brand-800 hover:bg-brand-900 text-white rounded-lg font-semibold text-sm shadow-sm transition-all transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span>Hitung Karakter Weton</span>
      </button>
    </form>
    
    <!-- Result Single -->
    <div id="result-single" class="hidden mt-8 p-6 bg-brand-50/50 rounded-xl border border-brand-200/50 animate-fade-in space-y-6">
      <!-- Generated content goes here -->
    </div>
  </div>

  <!-- Tab 2: Cek Weton Jodoh -->
  <div id="tab-jodoh" class="tab-content hidden">
    <form id="form-jodoh" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Pasangan 1 -->
        <div class="space-y-3 p-4 bg-cream/30 rounded-lg border border-brand-200/20">
          <h3 class="text-xs font-bold text-brand-800 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Pihak Pertama (Pria)
          </h3>
          <div>
            <label class="block text-[11px] font-semibold text-text-muted mb-1">Nama Pria</label>
            <input 
              type="text" 
              id="jodoh-name-1" 
              placeholder="Nama Lengkap..." 
              class="w-full px-3 py-2.5 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-xs"
              required
            />
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-text-muted mb-1">Tanggal Lahir</label>
            <input 
              type="date" 
              id="jodoh-date-1" 
              class="w-full px-3 py-2.5 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-xs"
              required
            />
          </div>
        </div>

        <!-- Pasangan 2 -->
        <div class="space-y-3 p-4 bg-cream/30 rounded-lg border border-brand-200/20">
          <h3 class="text-xs font-bold text-brand-800 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Pihak Kedua (Wanita)
          </h3>
          <div>
            <label class="block text-[11px] font-semibold text-text-muted mb-1">Nama Wanita</label>
            <input 
              type="text" 
              id="jodoh-name-2" 
              placeholder="Nama Lengkap..." 
              class="w-full px-3 py-2.5 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-xs"
              required
            />
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-text-muted mb-1">Tanggal Lahir</label>
            <input 
              type="date" 
              id="jodoh-date-2" 
              class="w-full px-3 py-2.5 rounded-lg border border-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-xs"
              required
            />
          </div>
        </div>
      </div>
      
      <button 
        type="submit" 
        class="w-full py-3 bg-brand-800 hover:bg-brand-900 text-white rounded-lg font-semibold text-sm shadow-sm transition-all transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
        <span>Ramal Kesesuaian Jodoh</span>
      </button>
    </form>

    <!-- Result Jodoh -->
    <div id="result-jodoh" class="hidden mt-8 p-6 bg-brand-50/50 rounded-xl border border-brand-200/50 animate-fade-in space-y-6">
      <!-- Generated content goes here -->
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  // Javanese Weton Core Data Arrays
  const HARI = [
    { nama: 'Minggu', neptu: 5, karakter: 'Samudra (Luas budinya, pemaaf, berjiwa penolong, dan penyabar).' },
    { nama: 'Senin', neptu: 4, karakter: 'Raseksa (Berani, berprinsip kokoh, tekun bekerja, dan bertekad kuat).' },
    { nama: 'Selasa', neptu: 3, karakter: 'Layu (Cenderung pendiam, penyendiri, namun setia jika sudah percaya).' },
    { nama: 'Rabu', neptu: 7, karakter: 'Bumi (Stabil, tenang, berwibawa, penyayang keluarga, dan murah hati).' },
    { nama: 'Kamis', neptu: 8, karakter: 'Banyu (Tenang di permukaan namun menghanyutkan, cerdas, berwawasan luas).' },
    { nama: 'Jumat', neptu: 6, karakter: 'Geni (Penuh semangat, pemberani, berjiwa petualang, berambisi tinggi).' },
    { nama: 'Sabtu', neptu: 9, karakter: 'Angin (Supel, mudah bergaul, menyukai perjalanan, ceria dan dinamis).' }
  ];

  const PASARAN = [
    { nama: 'Wage', neptu: 4, watak: 'Kaku di luar namun berhati lembut, pandai menyimpan rahasia, ulet.' },
    { nama: 'Kliwon', neptu: 8, watak: 'Berwibawa tinggi, pandai berbicara, cerdas memimpin, berkarisma.' },
    { nama: 'Legi', neptu: 5, watak: 'Optimis, menyukai seni dan keindahan, ramah, suka berbagi ilmu.' },
    { nama: 'Pahing', neptu: 9, watak: 'Penuh visi, kreatif, bersemangat tinggi, setia pada janji.' },
    { nama: 'Pon', neptu: 7, watak: 'Bijaksana, tenang mengambil keputusan, penyabar, berbudi luhur.' }
  ];

  // Primbon Pancasuda (Total Neptu % 7)
  const PANCASUDA = {
    1: { nama: 'Wasesa Segara', ket: 'Memiliki hati yang mulia, sangat pemaaf, penyabar, berjiwa kepemimpinan tinggi, dan memiliki wibawa luar biasa layaknya luasnya samudra.' },
    2: { nama: 'Tunggak Semi', ket: 'Dianugerahi keberuntungan finansial yang tinggi. Rezeki diramalkan selalu tumbuh subur dan mengalir kembali meskipun sempat mengalami masa surut.' },
    3: { nama: 'Satria Wibawa', ket: 'Selalu dihormati dan disegani di lingkungan sosialnya. Mendapatkan banyak kemudahan dalam karier serta keluhuran martabat hidup.' },
    4: { nama: 'Sumur Sinaba', ket: 'Dikenal cerdas, bijaksana, dan berwawasan luas. Sering dijadikan tempat bertanya, rujukan ilmu, dan panutan bagi orang-orang sekitar.' },
    5: { nama: 'Bumi Kapetak', ket: 'Merupakan tipe pekerja keras, sangat ulet, tangguh menghadapi cobaan hidup, berhati tulus, dan mencintai alam serta menetap.' },
    6: { nama: 'Satria Wirang', ket: 'Sering menghadapi ujian kesabaran dalam pergaulan sosial. Disarankan untuk selalu berlapang dada, ikhlas, dan fokus meningkatkan kualitas diri.' },
    0: { nama: 'Lebu Katiup Angin', ket: 'Sering mengalami ujian fluktuasi dalam rencana atau cita-cita. Sangat dianjurkan untuk rajin menabung, berhemat, dan fokus pada target hidup.' }
  };

  // Karakter Lahir Sandang Pangan (Total Neptu % 5)
  const KARAKTER_LAHIR = {
    1: { nama: 'Sri (Kemakmuran)', ket: 'Dianugerahi kemudahan dalam rezeki sehari-hari, beruntung dalam hidup, dan membawa keceriaan bagi lingkungan keluarga.' },
    2: { nama: 'Lungguh (Kedudukan)', ket: 'Berbakat menduduki jabatan atau posisi penting, disegani di masyarakat, berwibawa tinggi, dan dipercaya memegang tanggung jawab.' },
    3: { nama: 'Gedhong (Kekayaan)', ket: 'Pintar mengelola aset finansial, berbakat hidup makmur secara materi, dan mampu mengumpulkan kekayaan melalui kerja cerdas.' },
    4: { nama: 'Lara (Ujian Fisik)', ket: 'Sering diuji dengan rintangan kesehatan atau kebugaran. Sangat disarankan untuk disiplin menjaga pola hidup sehat dan rajin beribadah.' },
    0: { nama: 'Pati (Ujian Mental)', ket: 'Sering menghadapi fase ujian hidup yang menuntut keteguhan mental. Disarankan giat bersedekah dan berikhtiar sebagai benteng spiritual.' }
  };

  const EPOCH_DATE = new Date('1970-01-01');

  function getWeton(dateStr: string) {
    const targetDate = new Date(dateStr);
    const dayIdx = targetDate.getDay();
    const hariObj = HARI[dayIdx];

    const diffTime = targetDate.getTime() - EPOCH_DATE.getTime();
    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
    
    let pasaranIdx = diffDays % 5;
    if (pasaranIdx < 0) {
      pasaranIdx = (pasaranIdx + 5) % 5;
    }
    const pasaranObj = PASARAN[pasaranIdx];
    const neptuTotal = hariObj.neptu + pasaranObj.neptu;

    return {
      hari: hariObj.nama,
      hariNeptu: hariObj.neptu,
      hariKarakter: hariObj.karakter,
      pasaran: pasaranObj.nama,
      pasaranNeptu: pasaranObj.neptu,
      pasaranWatak: pasaranObj.watak,
      neptu: neptuTotal
    };
  }

  const COMPATIBILITY = {
    PEGAT: {
      hasil: 'PEGAT (Sering Menghadapi Hambatan)',
      warna: 'text-amber-700 bg-amber-50 border-amber-200',
      desc: 'Pegat menandakan kemungkinan adanya fluktuasi ekonomi atau rintangan kecil di awal adaptasi pernikahan. Rintangan ini akan sangat mudah diatasi melalui komunikasi transparan, kedewasaan emosional, serta kedisiplinan mengelola keuangan bersama sejak hari pertama.'
    },
    RATU: {
      hasil: 'RATU (Sangat Serasi & Dihormati)',
      warna: 'text-emerald-700 bg-emerald-50 border-emerald-200',
      desc: 'Ratu menandakan hubungan yang sangat serasi bagaikan raja dan ratu pernikahan. Anda berdua diramalkan disegani oleh kerabat dan lingkungan, rezeki mengalir harmonis, dan rumah tangga dipenuhi kedamaian spiritual.'
    },
    JODOH: {
      hasil: 'JODOH (Saling Melengkapi & Rukun)',
      warna: 'text-brand-800 bg-brand-50 border-brand-200',
      desc: 'Jodoh adalah lambang kecocokan sejati dan kemitraan hidup yang harmonis. Pasangan ini diramalkan rukun, damai, bisa saling melengkapi kekurangan satu sama lain, serta diberkahi kelancaran rezeki hingga hari tua.'
    },
    TOPO: {
      hasil: 'TOPO (Sukses Setelah Perjuangan Awal)',
      warna: 'text-indigo-700 bg-indigo-50 border-indigo-200',
      desc: 'Topo menandakan adanya tantangan adaptasi hidup atau finansial di tahun-tahun pertama pernikahan. Namun, berkat ketangguhan perjuangan bersama, rumah tangga Anda akan berakhir sangat sukses, berwibawa, dan kaya raya.'
    },
    TINARI: {
      hasil: 'TINARI (Murah Rezeki & Beruntung)',
      warna: 'text-rose-700 bg-rose-50 border-rose-200',
      desc: 'Tinari membawa berkah keberuntungan sandang pangan yang melimpah. Rumah tangga diramalkan selalu diliputi kemudahan dalam mencari nafkah, mendapat jalan rezeki tidak terduga, dan sering dikelilingi kebahagiaan.'
    },
    PADU: {
      hasil: 'PADU (Sering Selisih Paham - Wajar)',
      warna: 'text-orange-700 bg-orange-50 border-orange-200',
      desc: 'Padu berarti pasangan ini sering selisih paham mengenai hal-hal kecil. Namun, perselisihan ini merupakan bumbu rumah tangga dan tidak akan merusak keutuhan ikatan karena dasar cinta yang kuat. Kuncinya: kurangi ego masing-masing!'
    },
    SUJANAN: {
      hasil: 'SUJANAN (Rawan Cemburu & Salah Paham)',
      warna: 'text-red-700 bg-red-50 border-red-200',
      desc: 'Sujanan menandakan hubungan yang membutuhkan komunikasi ekstra terbuka untuk menghindari kecemburuan atau salah paham. Pastikan Anda berdua membangun pilar kepercayaan penuh, keterbukaan, dan kejujuran mutlak.'
    },
    PESTHI: {
      hasil: 'PESTHI (Rukun, Tenteram & Adem Ayem)',
      warna: 'text-sky-700 bg-sky-50 border-sky-200',
      desc: 'Pesthi melambangkan keharmonisan tingkat tinggi yang stabil dan langgeng. Hubungan diramalkan berjalan sangat damai, adem ayem, rukun, dan terhindar dari permasalahan/ujian kehidupan yang berat. Sangat ideal untuk jangka panjang.'
    }
  };

  function getCompatibility(n1: number, n2: number) {
    const total = n1 + n2;
    const rem = total % 8;
    
    switch (rem) {
      case 1: return COMPATIBILITY.PEGAT;
      case 2: return COMPATIBILITY.RATU;
      case 3: return COMPATIBILITY.JODOH;
      case 4: return COMPATIBILITY.TOPO;
      case 5: return COMPATIBILITY.TINARI;
      case 6: return COMPATIBILITY.PADU;
      case 7: return COMPATIBILITY.SUJANAN;
      case 0: return COMPATIBILITY.PESTHI;
      default: return COMPATIBILITY.JODOH;
    }
  }

  // Tabs Toggle JavaScript
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active', 'border-brand-600', 'text-brand-800'));
      tabBtns.forEach(b => b.classList.add('border-transparent', 'text-text-muted'));
      
      btn.classList.add('active', 'border-brand-600', 'text-brand-800');
      btn.classList.remove('border-transparent', 'text-text-muted');

      const targetTab = btn.getAttribute('data-tab');
      tabContents.forEach(content => {
        if (content.id === `tab-${targetTab}`) {
          content.classList.remove('hidden');
          content.classList.add('block');
        } else {
          content.classList.remove('block');
          content.classList.add('hidden');
        }
      });
    });
  });

  // Single Weton Form submit handling
  const formSingle = document.getElementById('form-single') as HTMLFormElement;
  const resultSingle = document.getElementById('result-single');

  if (formSingle && resultSingle) {
    formSingle.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('single-name') as HTMLInputElement).value;
      const dateVal = (document.getElementById('single-date') as HTMLInputElement).value;

      if (!dateVal) return;

      const weton = getWeton(dateVal);
      
      const pancasudaIdx = weton.neptu % 7;
      const pancasudaObj = PANCASUDA[pancasudaIdx as keyof typeof PANCASUDA];

      const karakterLahirIdx = weton.neptu % 5;
      const karakterLahirObj = KARAKTER_LAHIR[karakterLahirIdx as keyof typeof KARAKTER_LAHIR];

      const dateDisplay = new Date(dateVal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

      resultSingle.innerHTML = `
        <div class="text-center pb-4 border-b border-brand-200/50">
          <span class="text-[10px] uppercase tracking-widest text-brand-700 font-bold bg-brand-100/50 px-3 py-1.5 rounded-full">Hasil Perhitungan Weton</span>
          <h4 class="font-serif text-2xl text-brand-900 mt-4 mb-1 font-bold">${name}</h4>
          <p class="text-xs text-text-muted">Tanggal Lahir: ${dateDisplay}</p>
        </div>

        <!-- 3-Column Neptu Grid -->
        <div class="grid grid-cols-3 gap-3 text-center my-4">
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">Hari Lahir</span>
            <span class="block text-sm font-extrabold text-brand-900 mt-1">${weton.hari}</span>
            <span class="text-[10px] text-text-muted font-medium">(Neptu ${weton.hariNeptu})</span>
          </div>
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">Pasaran Jawa</span>
            <span class="block text-sm font-extrabold text-brand-900 mt-1">${weton.pasaran}</span>
            <span class="text-[10px] text-text-muted font-medium">(Neptu ${weton.pasaranNeptu})</span>
          </div>
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">Neptu Weton</span>
            <span class="block text-base font-black text-brand-850 mt-0.5">${weton.neptu}</span>
            <span class="text-[10px] text-text-muted font-medium">(Total Nilai)</span>
          </div>
        </div>

        <!-- Deep Interpretations List -->
        <div class="space-y-4 pt-2">
          <div class="p-4 bg-white rounded-xl border border-brand-200/30 space-y-1">
            <span class="block text-xs font-bold text-brand-850 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Sifat Hari Lahir
            </span>
            <p class="text-xs text-text-muted leading-relaxed">${weton.hariKarakter}</p>
          </div>

          <div class="p-4 bg-white rounded-xl border border-brand-200/30 space-y-1">
            <span class="block text-xs font-bold text-brand-850 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Watak Pasaran Jawa
            </span>
            <p class="text-xs text-text-muted leading-relaxed">${weton.pasaranWatak}</p>
          </div>

          <div class="p-4 bg-white rounded-xl border border-brand-200/30 space-y-1">
            <span class="block text-xs font-bold text-brand-850 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Primbon Pancasuda (${pancasudaObj.nama})
            </span>
            <p class="text-xs text-text-muted leading-relaxed">${pancasudaObj.ket}</p>
          </div>

          <div class="p-4 bg-white rounded-xl border border-brand-200/30 space-y-1">
            <span class="block text-xs font-bold text-brand-850 uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Karakter Sandang Pangan (${karakterLahirObj.nama})
            </span>
            <p class="text-xs text-text-muted leading-relaxed">${karakterLahirObj.ket}</p>
          </div>
        </div>
      `;
      resultSingle.classList.remove('hidden');
    });
  }

  // Jodoh Weton Form submit handling
  const formJodoh = document.getElementById('form-jodoh') as HTMLFormElement;
  const resultJodoh = document.getElementById('result-jodoh');

  if (formJodoh && resultJodoh) {
    formJodoh.addEventListener('submit', (e) => {
      e.preventDefault();
      const p1 = (document.getElementById('jodoh-name-1') as HTMLInputElement).value;
      const d1 = (document.getElementById('jodoh-date-1') as HTMLInputElement).value;
      const p2 = (document.getElementById('jodoh-name-2') as HTMLInputElement).value;
      const d2 = (document.getElementById('jodoh-date-2') as HTMLInputElement).value;

      if (!d1 || !d2) return;

      const w1 = getWeton(d1);
      const w2 = getWeton(d2);
      const totalNeptu = w1.neptu + w2.neptu;
      const match = getCompatibility(w1.neptu, w2.neptu);

      resultJodoh.innerHTML = `
        <div class="text-center pb-4 border-b border-brand-200/50">
          <span class="text-[10px] uppercase tracking-widest text-brand-700 font-bold bg-brand-100/50 px-3 py-1.5 rounded-full">Hasil Kesesuaian Pernikahan</span>
          <h4 class="font-serif text-2xl text-brand-900 mt-4 font-bold">${p1} & ${p2}</h4>
          <p class="text-xs text-text-muted">Kecocokan berdasarkan total nilai neptu weton</p>
        </div>

        <!-- Partners Comparison Grid -->
        <div class="grid grid-cols-2 gap-4 text-center my-4">
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">${p1}</span>
            <span class="block text-sm font-extrabold text-brand-900 mt-1">${w1.hari} ${w1.pasaran}</span>
            <span class="text-[10px] text-text-muted font-medium">Neptu ${w1.neptu}</span>
          </div>
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">${p2}</span>
            <span class="block text-sm font-extrabold text-brand-900 mt-1">${w2.hari} ${w2.pasaran}</span>
            <span class="text-[10px] text-text-muted font-medium">Neptu ${w2.neptu}</span>
          </div>
        </div>

        <!-- Primbon Match Summary -->
        <div class="p-5 rounded-2xl border text-center ${match.warna}">
          <span class="block text-[10px] font-bold uppercase tracking-widest mb-1 text-opacity-80">Tafsir Kecocokan</span>
          <span class="block text-xl font-extrabold leading-tight mb-2.5">${match.hasil}</span>
          <p class="text-xs font-medium leading-relaxed max-w-lg mx-auto text-opacity-90">${match.desc}</p>
        </div>

        <!-- 2-Column Details Summary -->
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30 text-center">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider">Total Neptu</span>
            <span class="block text-xl font-black text-brand-850 mt-0.5">${totalNeptu}</span>
            <span class="text-[10px] text-text-muted font-medium">(${w1.neptu} + ${w2.neptu})</span>
          </div>
          <div class="p-3.5 bg-white rounded-xl border border-brand-200/30 text-center flex flex-col justify-center items-center">
            <span class="block text-[10px] text-text-muted uppercase font-bold tracking-wider mb-1">Status Kecocokan</span>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-brand-100 text-brand-800">
              Modulo 8 Valid
            </span>
          </div>
        </div>
      `;
      resultJodoh.classList.remove('hidden');
    });
  }
</script>
