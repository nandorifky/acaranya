---
import { getCollection } from 'astro:content';
import DesignCard from '../designs/DesignCard.astro';

interface Props {
  templates: string[];
}

const { templates = [] } = Astro.props;

// Fetch all published designs
const allDesigns = await getCollection('designs');
const publishedDesigns = allDesigns.filter(d => d.data.status === 'published');

// Map design entries matching the specified slugs
const matchedDesigns = templates
  .map(slug => {
    const trimmed = slug.trim();
    return publishedDesigns.find(d => d.id === trimmed || d.id.replace(/\.[^/.]+$/, "") === trimmed);
  })
  .filter((d): d is NonNullable<typeof d> => !!d);

if (matchedDesigns.length === 0) {
  return null;
}
---

<div class="design-showcase-wrapper my-10 not-prose">
  <div class="text-center mb-6">
    <span class="text-[10px] font-extrabold tracking-[0.2em] text-brand-700 uppercase block mb-1">REKOMENDASI TEMPLATE</span>
    <h4 class="font-serif text-lg sm:text-xl text-brand-900 font-bold">Desain Undangan Pilihan Untuk Anda</h4>
  </div>

  <!-- Strict 2-column grid for both Mobile and Desktop -->
  <div class="grid grid-cols-2 gap-4 sm:gap-6 max-w-2xl mx-auto">
    {matchedDesigns.map(design => (
      <DesignCard design={design} />
    ))}
  </div>
</div>
