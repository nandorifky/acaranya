---
import Container from '../base/Container.astro';
import { siteConfig } from '../../data/site';

const stats = [
  { value: siteConfig.stats.totalInvitations, label: 'Undangan Dibuat' },
  { value: siteConfig.stats.totalGuests, label: 'Tamu Diundang' },
  { value: siteConfig.stats.totalDesigns, label: 'Pilihan Desain' },
  { value: siteConfig.stats.since, label: 'Berpengalaman' },
];
---

<section class="relative bg-[#FAF9F6]" id="trust-stats">
  <div class="h-px bg-gradient-to-r from-transparent via-[#C9B77D]/20 to-transparent"></div>
  <Container>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 py-12 lg:py-16">
      {stats.map((stat, i) => (
        <div class:list={['text-center space-y-2', i < stats.length - 1 ? 'lg:border-r lg:border-border-soft/60' : '']}>
          <p class="font-serif text-4xl lg:text-[2.75rem] font-medium text-brand-950 leading-none tracking-tight">
            {stat.value}
          </p>
          <p class="text-[10px] text-text-muted uppercase tracking-[0.2em] font-bold">{stat.label}</p>
        </div>
      ))}
    </div>
  </Container>
  <div class="h-px bg-gradient-to-r from-transparent via-[#C9B77D]/20 to-transparent"></div>
</section>
