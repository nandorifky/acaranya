---
import Container from '../base/Container.astro';
import Section from '../base/Section.astro';
import Icon from '../ui/Icon.astro';

const stats = [
  { 
    label: 'Kertas Dihemat', 
    value: '500k+', 
    unit: 'Lembar',
    icon: 'copy',
    desc: 'Menghindari pemborosan kertas fisik dari undangan konvensional.'
  },
  { 
    label: 'Pohon Terlindungi', 
    value: '120+', 
    unit: 'Pohon Dewasa',
    icon: 'zap', // Using zap as a placeholder for energy/life, or I can add a leaf icon if needed
    desc: 'Setara dengan melestarikan area hijau kecil untuk masa depan.'
  },
  { 
    label: 'Emisi Karbon', 
    value: '65%', 
    unit: 'Lebih Rendah',
    icon: 'globe',
    desc: 'Mengurangi jejak karbon dari proses logistik dan distribusi fisik.'
  }
];
---

<Section bg="cream" id="eco-impact" class="relative overflow-hidden">
  {/* Decorative background element */}
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#B59A73]/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
  
  <Container>
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand-950/5 rounded-full border border-brand-950/10">
          <span class="text-[9px] uppercase tracking-[0.2em] text-brand-950 font-bold">Kesadaran Lingkungan</span>
        </div>
        <h2 class="font-serif text-3xl md:text-5xl text-brand-950 leading-tight">
          Rayakan momen bahagia, <span class="italic font-normal text-[#B59A73]">lestarikan bumi kita</span>
        </h2>
        <p class="text-sm text-text-secondary leading-relaxed font-sans tracking-wide">
          Di Acaranya.id, kami percaya bahwa kemewahan tidak harus mengorbankan alam. Dengan beralih ke undangan digital, Anda turut berkontribusi dalam mengurangi limbah kertas and jejak karbon global.
        </p>
        <div class="pt-4">
          <div class="p-6 bg-white/50 backdrop-blur-sm border border-[#B59A73]/20 rounded-2xl">
            <p class="text-[13px] italic text-brand-850 font-serif leading-relaxed">
              "Setiap undangan digital yang Anda kirimkan adalah satu langkah kecil untuk bumi yang lebih hijau bagi generasi mendatang."
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-6">
        {stats.map((stat) => (
          <div class="flex items-start gap-5 p-6 bg-white rounded-2xl border border-border-soft shadow-sm hover:shadow-md transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-cream flex items-center justify-center shrink-0">
              <Icon name={stat.icon} size={20} class="text-[#B59A73]" />
            </div>
            <div class="space-y-1">
              <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-serif font-bold text-brand-950">{stat.value}</span>
                <span class="text-[10px] font-bold uppercase tracking-widest text-[#B59A73]">{stat.unit}</span>
              </div>
              <p class="text-[11px] font-bold text-brand-900 uppercase tracking-wider">{stat.label}</p>
              <p class="text-[11px] text-text-muted leading-relaxed">{stat.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>
