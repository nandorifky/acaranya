---
import Container from '../base/Container.astro';
import Icon from '../ui/Icon.astro';
import { createWhatsappUrl } from '../../lib/whatsapp/create-whatsapp-url';
---

<section class="relative min-h-[90vh] flex items-center justify-center pt-16 pb-20 overflow-hidden bg-cream" id="hero">
  <!-- Mesh Gold Glow Background (Kinto style) -->
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-champagne/15 blur-[120px]"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-brand-200/20 blur-[100px]"></div>
  </div>

  <Container>
    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[calc(100vh-100px)] py-8 lg:py-0">
      
      <!-- Left Column: Content -->
      <div class="lg:col-span-7 space-y-8 animate-fade-in-up">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-brand-200/60 bg-surface/50 backdrop-blur-md">
          <span class="w-1.5 h-1.5 rounded-full bg-soft-gold animate-pulse"></span>
          <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-brand-700">Premium Digital Invitation</span>
        </div>
        
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-[4.75rem] text-brand-950 leading-[1.06] tracking-tight">
          Undangan digital<br class="hidden sm:block" />
          cantik untuk momen <span class="italic font-normal text-soft-gold">terindahmu.</span>
        </h1>
        
        <p class="text-base sm:text-lg text-text-secondary max-w-[500px] font-sans tracking-wide leading-relaxed">
          Pilih desain mewah, kirim data acara, dan bagikan undangan Anda secara instan. Dilengkapi RSVP otomatis, musik latar premium, dan peta navigasi presisi.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/desain-undangan-digital/" 
            class="px-8 py-4 bg-brand-900 text-cream rounded-full hover:bg-brand-950 transition-all font-semibold tracking-widest text-[11px] uppercase active:scale-[0.98] shadow-card hover:shadow-card-hover duration-300"
            id="hero-cta-primary">
            Lihat Desain
          </a>
          <a href={createWhatsappUrl()} target="_blank" rel="noopener noreferrer" 
            class="px-8 py-4 border border-brand-300/80 rounded-full hover:bg-white hover:border-brand-500 transition-all font-semibold tracking-widest text-[11px] uppercase duration-300 text-brand-800 flex items-center gap-2"
            id="hero-cta-whatsapp">
            <Icon name="whatsapp" size={15} class="text-[#25D366]" />
            Order via WhatsApp
          </a>
        </div>

        <!-- Trust Mini-signals / Stats Grid -->
        <div class="pt-8 border-t border-border-soft flex gap-10">
          <div>
            <p class="font-serif text-2xl font-semibold text-brand-900 leading-none">2,000+</p>
            <p class="text-[10px] text-text-muted uppercase tracking-widest font-sans font-bold mt-2">Undangan Aktif</p>
          </div>
          <div>
            <p class="font-serif text-2xl font-semibold text-brand-900 leading-none">150k+</p>
            <p class="text-[10px] text-text-muted uppercase tracking-widest font-sans font-bold mt-2">Tamu Terundang</p>
          </div>
          <div>
            <p class="font-serif text-2xl font-semibold text-brand-900 leading-none">Rp75k</p>
            <p class="text-[10px] text-text-muted uppercase tracking-widest font-sans font-bold mt-2">Harga Mulai</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Layered Mockups -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end animate-fade-in" style="animation-delay: 0.2s;">
        <!-- Phone Device Mockup -->
        <div class="relative w-full max-w-[280px] sm:max-w-[300px] aspect-[9/16] rounded-[42px] border-[7px] border-brand-950 bg-kinto-dark shadow-elevated overflow-hidden animate-float">
          <!-- Mockup Screen Content -->
          <div class="absolute inset-0 bg-cover bg-center p-6 flex flex-col justify-between text-center text-cream-warm" style="background-image: linear-gradient(rgba(18, 17, 16, 0.45), rgba(18, 17, 16, 0.9)), url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=600');">
            
            <div class="space-y-2">
              <span class="text-[9px] uppercase tracking-[0.3em] font-sans text-champagne/80 font-bold">The Wedding of</span>
              <p class="font-serif text-2xl font-light italic">Sarah & Rian</p>
            </div>
            
            <!-- Glassmorphic Countdown Widget -->
            <div class="glass p-4 rounded-2xl border border-white/10 text-brand-950 space-y-3.5 shadow-elevated">
              <span class="text-[9px] uppercase tracking-widest font-bold text-soft-gold block">Countdown to Special Day</span>
              <div class="grid grid-cols-3 gap-1.5 text-center">
                <div class="bg-surface-muted/60 py-1.5 rounded-lg">
                  <span class="font-serif text-sm font-bold block">12</span>
                  <span class="text-[8px] text-text-muted font-bold">HARI</span>
                </div>
                <div class="bg-surface-muted/60 py-1.5 rounded-lg">
                  <span class="font-serif text-sm font-bold block">08</span>
                  <span class="text-[8px] text-text-muted font-bold">JAM</span>
                </div>
                <div class="bg-surface-muted/60 py-1.5 rounded-lg">
                  <span class="font-serif text-sm font-bold block">45</span>
                  <span class="text-[8px] text-text-muted font-bold">MENIT</span>
                </div>
              </div>
              <button class="w-full py-2 bg-brand-900 text-cream rounded-xl text-[10px] font-bold tracking-widest uppercase hover:bg-brand-950 transition-colors">
                Buka Undangan
              </button>
            </div>
            
          </div>
        </div>

        <!-- Floating Glass Widget: RSVP Success -->
        <div class="absolute top-[20%] -left-6 glass p-4 rounded-2xl border border-border-soft/60 shadow-card max-w-[170px] animate-pulse-slow">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-full bg-success/15 flex items-center justify-center text-success text-[10px] font-bold">✓</div>
            <div>
              <span class="text-[9px] text-text-muted uppercase tracking-wider block font-semibold">RSVP Hadir</span>
              <span class="font-serif text-xs font-semibold text-brand-900">Sarah & Rian</span>
            </div>
          </div>
        </div>

        <!-- Floating Glass Widget: Star Rating -->
        <div class="absolute bottom-[15%] -right-4 glass p-3.5 rounded-xl border border-border-soft/60 shadow-card animate-pulse-slow" style="animation-delay: 1.5s;">
          <div class="flex gap-0.5 mb-1.5">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="star" size={10} class="text-soft-gold fill-soft-gold" />
            ))}
          </div>
          <p class="text-[10px] text-text-muted font-bold uppercase tracking-wider">Premium Rating</p>
        </div>
      </div>
      
    </div>
  </Container>

  <!-- Scroll Indicator (Kinto signature element) -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#trust-stats" class="flex flex-col items-center gap-1 text-text-muted hover:text-soft-gold transition-colors duration-300">
      <Icon name="chevron-down" size={20} />
    </a>
  </div>
</section>
