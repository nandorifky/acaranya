---
import Container from '../base/Container.astro';
import Section from '../base/Section.astro';
import Icon from '../ui/Icon.astro';

const steps = [
  { 
    icon: 'palette', 
    title: 'Pilih Desain', 
    description: 'Jelajahi galeri template premium kami dan pilih desain yang paling berkesan.' 
  },
  { 
    icon: 'clipboard-list', 
    title: 'Kirim Data Acara', 
    description: 'Isi detail data acara Anda melalui formulir digital kami yang intuitif.' 
  },
  { 
    icon: 'message-square-quote', 
    title: 'Review & Revisi', 
    description: 'Tim desainer kami memproses undangan, dan Anda bebas melakukan revisi.' 
  },
  { 
    icon: 'send', 
    title: 'Siap Bagikan', 
    description: 'Undangan digital aktif dan siap disebarkan ke seluruh tamu undangan.' 
  },
];
---

<Section bg="white" id="how-it-works">
  <Container>
    {/* Section Header */}
    <div class="mb-20 text-center space-y-4">
      <span class="text-[10px] uppercase tracking-[0.25em] text-[#B59A73] font-bold block">Alur Kerja</span>
      <h2 class="font-serif text-3xl md:text-5xl text-brand-950 max-w-xl mx-auto leading-tight">
        Langkah mudah mewujudkan <span class="italic font-normal text-[#B59A73]">undangan impian</span>
      </h2>
      <p class="text-xs md:text-sm text-text-secondary max-w-md mx-auto font-sans tracking-wide leading-relaxed">
        Proses pembuatan yang terstruktur untuk hasil yang elegan dan profesional.
      </p>
    </div>

    <div class="max-w-6xl mx-auto">
      {/* Desktop Layout (Horizontal Grid) */}
      <div class="hidden md:grid md:grid-cols-4 gap-8 relative">
        
        {/* Decorative Connecting Line (Desktop Only) */}
        <div class="absolute top-10 left-[12%] right-[12%] h-px hidden md:block">
          <div class="w-full h-full border-t border-dashed border-[#B59A73]/40"></div>
        </div>

        {steps.map((step, i) => (
          <div class="relative flex flex-col items-center text-center group">
            {/* Icon Container */}
            <div class="relative z-10 w-20 h-20 mb-6 rounded-3xl bg-cream border border-[#B59A73]/20 flex items-center justify-center transition-all duration-500 group-hover:border-[#B59A73] group-hover:rotate-6 group-hover:shadow-xl group-hover:shadow-[#B59A73]/10">
              <div class="w-16 h-16 rounded-2xl border border-[#B59A73]/10 flex items-center justify-center bg-white">
                <Icon name={step.icon} size={28} class="text-[#B59A73]" />
              </div>
              
              {/* Step Number Badge */}
              <div class="absolute -top-2 -right-2 w-7 h-7 bg-brand-950 text-cream text-[10px] font-bold rounded-full flex items-center justify-center border-2 border-white shadow-sm group-hover:bg-[#B59A73] transition-colors duration-300">
                {i + 1}
              </div>
            </div>

            {/* Content */}
            <div class="space-y-3">
              <h3 class="font-serif text-lg font-semibold text-brand-950 group-hover:text-[#B59A73] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-xs lg:text-[13px] text-text-secondary leading-relaxed font-sans tracking-wide">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      {/* Mobile Layout (Vertical Centered) */}
      <div class="md:hidden space-y-12">
        {steps.map((step, i) => (
          <div class="flex flex-col items-center text-center">
            {/* Icon & Number */}
            <div class="relative w-16 h-16 mb-6 rounded-2xl bg-cream border border-[#B59A73]/20 flex items-center justify-center">
              <Icon name={step.icon} size={24} class="text-[#B59A73]" />
              <div class="absolute -top-2 -right-2 w-6 h-6 bg-brand-950 text-cream text-[9px] font-bold rounded-full flex items-center justify-center border-2 border-white">
                {i + 1}
              </div>
            </div>

            {/* Content */}
            <div class="max-w-xs space-y-2">
              <h3 class="font-serif text-lg font-semibold text-brand-950">{step.title}</h3>
              <p class="text-xs text-text-secondary leading-relaxed font-sans">{step.description}</p>
            </div>

            {/* Small vertical connector for mobile */}
            {i !== steps.length - 1 && (
              <div class="mt-8 w-px h-8 bg-gradient-to-b from-[#B59A73]/40 to-transparent"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>
