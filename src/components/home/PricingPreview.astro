---
import Container from "../base/Container.astro";
import Section from "../base/Section.astro";
import SectionHeader from "../base/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import { pricingPlans } from "../../data/pricing-static";
import { siteConfig } from "../../data/site";
---

<Section bg="cream" id="pricing-preview">
  <Container>
    <div class="mb-14 text-center space-y-3">
      <span
        class="text-[10px] uppercase tracking-[0.2em] text-soft-gold font-bold"
        >Investasi Anda</span
      >
      <h2
        class="font-serif text-3xl md:text-5xl text-brand-950 max-w-xl mx-auto leading-tight"
      >
        Paket Harga Transparan Tanpa Biaya Tersembunyi
      </h2>
      <p
        class="text-sm text-text-secondary max-w-md mx-auto font-sans tracking-wide"
      >
        Pilih paket yang paling tepat sesuai dengan kebutuhan acara istimewa
        Anda.
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto items-stretch stagger"
    >
      {
        pricingPlans.map((plan, index) => (
          <div
            class:list={[
              "relative bg-surface overflow-hidden transition-all duration-300 rounded-3xl border flex flex-col justify-between",
              plan.isPopular
                ? "border-[#B59A73] shadow-elevated z-10 md:-my-4 bg-[#fff8ec]/10"
                : "border-border-soft/60 hover:border-[#B59A73]/30 hover:shadow-card shadow-sm",
            ]}
          >
            {plan.isPopular && (
              <div class="bg-[#B59A73] text-[#FAF9F6] text-center text-[9px] font-bold py-1.5 uppercase tracking-[0.2em]">
                Paling Populer
              </div>
            )}

            <div class="p-7 lg:p-8 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div>
                  <h3 class="font-serif text-2xl font-semibold text-brand-950">
                    {plan.name}
                  </h3>
                  <p class="text-[12px] text-text-muted mt-1 leading-relaxed">
                    {plan.description}
                  </p>
                </div>

                <div>
                  <span class="font-serif text-[2.75rem] font-medium text-brand-950 leading-none tracking-tight">
                    {plan.priceDisplay}
                  </span>
                </div>

                <div class="h-px bg-border-soft/60 my-2" />

                <ul class="space-y-3 pt-2">
                  {plan.features.slice(0, 5).map((feature) => (
                    <li class="flex items-start gap-3 text-[13px] text-text-secondary font-sans tracking-wide leading-relaxed">
                      <div class="w-4 h-4 rounded-full bg-success/10 flex items-center justify-center shrink-0 mt-0.5">
                        <Icon name="check" size={10} class="text-success" />
                      </div>
                      <span>{feature}</span>
                    </li>
                  ))}
                  {plan.features.length > 5 && (
                    <li class="text-[12px] text-soft-gold font-bold tracking-wider uppercase pl-7">
                      +{plan.features.length - 5} Fitur Tambahan
                    </li>
                  )}
                </ul>
              </div>

              <div class="pt-4">
                <a
                  href={`/order-undangan/?package=${plan.slug}`}
                  aria-label={`Pilih dan pesan paket undangan digital ${plan.name} seharga ${plan.priceDisplay}`}
                  data-action="select-package"
                  data-package={plan.slug}
                  class:list={[
                    "w-full inline-flex items-center justify-center gap-2 py-3.5 text-[11px] font-bold uppercase tracking-widest rounded-full transition-all duration-300 shadow-sm active:scale-[0.98]",
                    plan.isPopular
                      ? "bg-[#B59A73] text-cream hover:bg-brand-950 hover:shadow"
                      : "border border-border-soft text-brand-800 hover:bg-white hover:border-brand-500 hover:shadow",
                  ]}
                >
                  {plan.ctaLabel}
                  <Icon name="arrow-right" size={12} />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-10">
      <a
        href={siteConfig.integrations.pricingUrl}
        class="inline-flex items-center gap-1.5 text-soft-gold text-xs font-bold uppercase tracking-widest hover:text-brand-950 transition-colors duration-300"
      >
        Lihat Detail & Perbandingan Lengkap
        <Icon name="arrow-right" size={13} />
      </a>
    </div>
  </Container>
</Section>
