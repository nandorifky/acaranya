---
import Container from "../base/Container.astro";
import Icon from "../ui/Icon.astro";
import { pricingPlans } from "../../data/pricing-static";
import { siteConfig } from "../../data/site";
---

<section class="py-28 bg-cream relative overflow-hidden" id="pricing-preview">
  <!-- Subtle gold background accents -->
  <div class="absolute left-[-15%] top-1/4 w-[500px] h-[500px] rounded-full bg-[#B59A73]/5 blur-[120px] pointer-events-none"></div>
  <div class="absolute right-[-15%] bottom-1/4 w-[500px] h-[500px] rounded-full bg-[#B59A73]/5 blur-[120px] pointer-events-none"></div>

  <Container>
    <!-- Section Header -->
    <div class="mb-20 text-center space-y-4 max-w-[680px] mx-auto animate-fade-in">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-brand-200/60 bg-surface/50 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-soft-gold animate-pulse"></span>
        <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-brand-700">Investasi Terbaik</span>
      </div>
      
      <h2 class="font-serif text-4xl sm:text-5xl text-brand-950 leading-tight">
        Investasi Transparan untuk Momen <span class="italic font-normal text-soft-gold">Bersejarah</span> Anda.
      </h2>
      
      <p class="text-text-secondary text-sm sm:text-base leading-relaxed font-sans max-w-lg mx-auto">
        Satu kali bayar, aktif selamanya. Pilih paket undangan digital terbaik yang dikurasi khusus untuk kelancaran hari pernikahan impian Anda.
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 max-w-5xl mx-auto items-stretch z-10 relative">
      
      {
        pricingPlans.map((plan) => (
          <div
            class:list={[
              "relative rounded-[32px] overflow-hidden border flex flex-col justify-between transition-all duration-500 group cursor-pointer",
              plan.isPopular
                ? "bg-brand-950 text-cream border-champagne/40 shadow-elevated md:-translate-y-4 md:scale-[1.03] z-10"
                : "bg-[#FAF9F6] text-brand-950 border-brand-200/40 hover:border-[#B59A73]/30 hover:shadow-card shadow-sm hover:-translate-y-1",
            ]}
          >
            {/* Subtle Grid Dot Overlay inside the Popular Card */}
            {plan.isPopular && (
              <div class="absolute inset-0 opacity-[0.02] pointer-events-none bg-[radial-gradient(#ffffff_1.5px,transparent_1.5px)] [background-size:12px_12px] z-0"></div>
            )}

            {/* Popular Floating Badge */}
            {plan.isPopular && (
              <div class="absolute top-6 right-6 z-10">
                <span class="bg-gradient-to-r from-soft-gold to-[#c9b77d] text-brand-950 text-[7px] font-black tracking-widest uppercase px-3 py-1 rounded-full shadow-md">
                  Paling Populer
                </span>
              </div>
            )}

            <div class="p-8 lg:p-10 flex-1 flex flex-col justify-between space-y-8 z-10 relative">
              
              <!-- Plan Header -->
              <div class="space-y-6">
                <div>
                  <h3 class="font-serif text-2xl font-bold tracking-tight">
                    {plan.name}
                  </h3>
                  <p class:list={[
                    "text-[11px] font-medium leading-relaxed mt-2 max-w-[220px]",
                    plan.isPopular ? "text-cream/70" : "text-text-muted"
                  ]}>
                    {plan.description}
                  </p>
                </div>

                <!-- Price -->
                <div class="space-y-1">
                  <span class="text-[9px] uppercase tracking-widest font-extrabold block text-soft-gold">Sekali Bayar</span>
                  <div class="flex items-baseline gap-1">
                    <span class="font-serif text-3xl sm:text-5xl font-black tracking-tight">
                      {plan.priceDisplay}
                    </span>
                  </div>
                </div>

                <div class:list={[
                  "h-[0.5px] w-full",
                  plan.isPopular ? "bg-cream/15" : "bg-brand-200/40"
                ]} />

                <!-- Features List -->
                <ul class="space-y-4 pt-2">
                  {plan.features.slice(0, 5).map((feature) => (
                    <li class="flex items-start gap-3.5 text-[12px] leading-relaxed font-sans tracking-wide">
                      <div class:list={[
                        "w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 shadow-sm",
                        plan.isPopular 
                          ? "bg-soft-gold/20 text-soft-gold border border-soft-gold/30" 
                          : "bg-success/10 text-success border border-success/15"
                      ]}>
                        <Icon name="check" size={10} strokeWidth={3} />
                      </div>
                      <span class:list={[
                        plan.isPopular ? "text-cream/90 font-medium" : "text-text-secondary font-semibold"
                      ]}>{feature}</span>
                    </li>
                  ))}
                  
                  {plan.features.length > 5 && (
                    <li class:list={[
                      "text-[10px] font-black tracking-widest uppercase pl-8",
                      plan.isPopular ? "text-soft-gold" : "text-[#B59A73]"
                    ]}>
                      +{plan.features.length - 5} Fitur Tambahan Terintegrasi
                    </li>
                  )}
                </ul>
              </div>

              <!-- CTA Button -->
              <div class="pt-6">
                <a
                  href={`/order-undangan/?package=${plan.slug}`}
                  aria-label={`Pilih dan pesan paket undangan digital ${plan.name} seharga ${plan.priceDisplay}`}
                  data-action="select-package"
                  data-package={plan.slug}
                  class:list={[
                    "w-full inline-flex items-center justify-center gap-2.5 py-4 text-[9px] font-black uppercase tracking-[0.25em] rounded-full transition-all duration-300 shadow-sm active:scale-[0.98]",
                    plan.isPopular
                      ? "bg-gradient-to-r from-soft-gold to-[#c9b77d] text-brand-950 hover:brightness-105 hover:shadow-md"
                      : "border border-brand-200 text-brand-900 bg-white hover:bg-brand-950 hover:text-cream hover:border-brand-950",
                  ]}
                >
                  {plan.ctaLabel}
                  <Icon name="arrow-right" size={10} strokeWidth={2.5} />
                </a>
              </div>

            </div>
          </div>
        ))
      }

    </div>

    <!-- Comparative Link -->
    <div class="text-center mt-14 animate-fade-in" style="animation-delay: 0.3s;">
      <a
        href={siteConfig.integrations.pricingUrl}
        class="inline-flex items-center gap-2 text-[#B59A73] hover:text-brand-950 text-xs font-black uppercase tracking-widest transition-colors duration-300"
      >
        Lihat Detail & Perbandingan Lengkap Fitur Paket
        <Icon name="arrow-right" size={12} strokeWidth={2.5} />
      </a>
    </div>
  </Container>
</section>
