---
import Container from "../base/Container.astro";
import Icon from "../ui/Icon.astro";
---

<section class="py-24 bg-cream relative overflow-hidden" id="cultural-layouts">
  <!-- Subtle background branding -->
  <div class="absolute right-0 top-1/4 w-[500px] h-[500px] rounded-full bg-brand-200/10 blur-[120px] pointer-events-none"></div>

  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      
      <!-- Left Column: Editorial Copy -->
      <div class="lg:col-span-5 space-y-8 animate-fade-in">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-brand-200/60 bg-surface/50 backdrop-blur-md">
          <span class="w-1.5 h-1.5 rounded-full bg-soft-gold"></span>
          <span class="text-[9px] uppercase tracking-[0.2em] font-bold text-brand-700">Ragam Adat Nusantara & Syari'i</span>
        </div>

        <h2 class="font-serif text-4xl sm:text-5xl text-brand-950 leading-[1.1] tracking-tight">
          Menghormati <span class="italic font-normal text-soft-gold">Tradisi Adat</span> & Kesucian Undangan Syar'i.
        </h2>

        <p class="text-text-secondary text-base sm:text-lg leading-relaxed font-sans max-w-[460px]">
          Acaranya.id menghadirkan pilihan desain undangan pernikahan adat nusantara serta undangan digital Syar'i yang dirancang presisi sesuai keyakinan dan kehormatan tradisi keluarga Anda.
        </p>

        <!-- Feature List with Premium Styling -->
        <div class="space-y-4 pt-2 max-w-[440px]">
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-[#B59A73]/15 flex items-center justify-center text-soft-gold shrink-0">
              <Icon name="check" size={14} />
            </div>
            <div>
              <h4 class="text-xs font-black text-brand-950 uppercase tracking-wider mb-1">Tata Letak Undangan Syar'i</h4>
              <p class="text-[11px] text-text-muted leading-relaxed font-semibold">Opsi pemisahan kelompok undangan pria & wanita, tanpa iringan musik instrumen, dan penempatan ayat suci Al-Qur'an secara terhormat.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-[#B59A73]/15 flex items-center justify-center text-soft-gold shrink-0">
              <Icon name="check" size={14} />
            </div>
            <div>
              <h4 class="text-xs font-black text-brand-950 uppercase tracking-wider mb-1">Integrasi Weton & Neptu Jawa</h4>
              <p class="text-[11px] text-text-muted leading-relaxed font-semibold">Tampilkan perhitungan hari baik pernikahan Jawa (Sri, Lungguh, Gedhong) secara elegan sebagai bagian dari cerita cinta Anda.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-[#B59A73]/15 flex items-center justify-center text-soft-gold shrink-0">
              <Icon name="check" size={14} />
            </div>
            <div>
              <h4 class="text-xs font-black text-brand-950 uppercase tracking-wider mb-1">Aksen Etnik Nusantara Kustom</h4>
              <p class="text-[11px] text-text-muted leading-relaxed font-semibold">Hiasan ornamen batik Jawa, ukiran Jepara, tenun Songket Minang, hingga ulos Batak yang dipadukan secara modern dan minimalis.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 9:16 Previews -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-6 animate-fade-in" style="animation-delay: 0.2s;">
        
        <!-- Card 1: Syar'i Elegant Layout -->
        <div class="relative group cursor-pointer">
          <div class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-cream-warm flex flex-col justify-between p-5 relative">
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-brand-950/20 z-10 opacity-70 group-hover:opacity-60 transition-opacity"></div>
            
            <img 
              src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=600" 
              alt="Desain Undangan Pernikahan Syar'i"
              class="absolute inset-0 w-full h-full object-cover z-0 filter sepia-[20%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            
            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full">Syar'i Layout</span>
              <span class="w-2.5 h-2.5 rounded-full bg-success/80"></span>
            </div>

            <!-- Content Area inside Screen -->
            <div class="z-20 text-center text-cream space-y-2">
              <span class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block">Walimatul 'Ursy</span>
              <h3 class="font-serif text-xl italic font-normal leading-none">Aisyah & Yusuf</h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <p class="text-[7px] tracking-widest uppercase font-semibold text-cream/80">Tanpa Instrumen Musik</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <h4 class="text-[11px] font-black uppercase tracking-wider text-brand-950">Syari'i Warm Blush</h4>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">Sesuai Syariat Islam</p>
          </div>
        </div>

        <!-- Card 2: Traditional Weton Jawa Layout -->
        <div class="relative group cursor-pointer">
          <div class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-[#121110] flex flex-col justify-between p-5 relative">
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/80 via-transparent to-brand-950/20 z-10 opacity-70 group-hover:opacity-60 transition-opacity"></div>
            
            <img 
              src="https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?q=80&w=600" 
              alt="Desain Undangan Pernikahan Weton Jawa"
              class="absolute inset-0 w-full h-full object-cover z-0 filter sepia-[30%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            
            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full">Adat Jawa</span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#B59A73]"></span>
            </div>

            <!-- Content Area inside Screen -->
            <div class="z-20 text-center text-cream space-y-2">
              <span class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block">Serat Katresnan</span>
              <h3 class="font-serif text-xl italic font-normal leading-none">Roro & Bagus</h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <span class="px-2 py-0.5 bg-[#B59A73]/30 border border-[#B59A73]/40 rounded text-[6px] tracking-wider uppercase font-bold text-[#c9b77d] inline-block">Weton Sri (Mulia)</span>
            </div>
          </div>
          <div class="mt-4 text-center">
            <h4 class="text-[11px] font-black uppercase tracking-wider text-brand-950">Javanese Heritage</h4>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">Integrasi Perhitungan Weton</p>
          </div>
        </div>

        <!-- Card 3: Modern Botanical Layout -->
        <div class="relative group cursor-pointer">
          <div class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-[#FAF9F6] flex flex-col justify-between p-5 relative">
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-brand-950/20 z-10 opacity-60 group-hover:opacity-50 transition-opacity"></div>
            
            <img 
              src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=600" 
              alt="Desain Undangan Pernikahan Modern"
              class="absolute inset-0 w-full h-full object-cover z-0 filter contrast-[98%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            
            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full">Modern Style</span>
              <span class="w-2.5 h-2.5 rounded-full bg-soft-gold"></span>
            </div>

            <!-- Content Area inside Screen -->
            <div class="z-20 text-center text-cream space-y-2">
              <span class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block">Save The Date</span>
              <h3 class="font-serif text-xl italic font-normal leading-none">Chloe & Darren</h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <p class="text-[7px] tracking-widest uppercase font-semibold text-cream/80">Eucalyptus Minimalist</p>
            </div>
          </div>
          <div class="mt-4 text-center">
            <h4 class="text-[11px] font-black uppercase tracking-wider text-brand-950">Eucalyptus Modern</h4>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">Desain Universal Elegan</p>
          </div>
        </div>

      </div>
    </div>
  </Container>
</section>
