---
import Container from "../base/Container.astro";
import Icon from "../ui/Icon.astro";
---

<section class="py-24 bg-cream relative overflow-hidden" id="cultural-layouts">
  <!-- Subtle background branding -->
  <div
    class="absolute right-0 top-1/4 w-[500px] h-[500px] rounded-full bg-brand-200/10 blur-[120px] pointer-events-none"
  >
  </div>

  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left Column: Editorial Copy -->
      <div class="lg:col-span-5 space-y-8 animate-fade-in">
        <div
          class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-brand-200/60 bg-surface/50 backdrop-blur-md"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-soft-gold"></span>
          <span
            class="text-[9px] uppercase tracking-[0.2em] font-bold text-brand-700"
            >Ragam Adat Nusantara & Syari'i</span
          >
        </div>

        <h2
          class="font-serif text-4xl sm:text-5xl text-brand-950 leading-[1.1] tracking-tight"
        >
          Menghormati <span class="italic font-normal text-soft-gold"
            >Tradisi Adat</span
          > & Kesucian Undangan Syar'i.
        </h2>

        <p
          class="text-text-secondary text-base sm:text-lg leading-relaxed font-sans max-w-[460px]"
        >
          Acaranya.id menghadirkan pilihan desain undangan pernikahan adat
          nusantara serta undangan digital Syar'i yang dirancang presisi sesuai
          keyakinan dan kehormatan tradisi keluarga Anda.
        </p>

        <!-- Feature List with Premium Styling -->
        <div
          class="pt-6 border-t border-border-soft/60 flex flex-wrap items-center gap-x-6 gap-y-3"
          data-astro-cid-wse7a2hg=""
        >
          <div
            class="flex items-center gap-2.5 text-text-secondary text-[12px] font-medium tracking-wide"
            data-astro-cid-wse7a2hg=""
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-[#B59A73]"
              aria-hidden="true"
              ><path d="M6 3h12l4 6-10 13L2 9Z"></path><path
                d="M11 3 8 9l4 13 4-13-3-6"></path><path d="M2 9h20"
              ></path></svg
            >
            <span data-astro-cid-wse7a2hg=""
              >Adat Jawa, Aceh, Batak, Minang, dll</span
            >
          </div>
          <div
            class="hidden md:block w-[1px] h-3.5 bg-border-strong/30"
            data-astro-cid-wse7a2hg=""
          >
          </div>
          <div
            class="flex items-center gap-2.5 text-text-secondary text-[12px] font-medium tracking-wide"
            data-astro-cid-wse7a2hg=""
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-[#B59A73]"
              aria-hidden="true"
              ><path
                d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
              ></path></svg
            >
            <span data-astro-cid-wse7a2hg=""
              >Islami, Kristiani, Katolik, Hinduisme, Buddhisme, Konghucu
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 9:16 Previews -->
      <div
        class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-6 animate-fade-in"
        style="animation-delay: 0.2s;"
      >
        <!-- Card 1: Syar'i Elegant Layout -->
        <div class="relative group cursor-pointer">
          <div
            class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-cream-warm flex flex-col justify-between p-5 relative"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-brand-950/20 z-10 opacity-70 group-hover:opacity-60 transition-opacity"
            >
            </div>

            <img
              src="/images/undangan-digital-display-homepage-1.webp"
              alt="Desain Undangan Pernikahan Adat Jawa"
              class="absolute inset-0 w-full h-full object-cover z-0 filter sepia-[20%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />

            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span
                class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full"
                >Adat Jawa</span
              >
              <span class="w-2.5 h-2.5 rounded-full bg-cream"></span>
            </div>

            <!-- Content Area inside Screen -->
            <!-- <div class="z-20 text-center text-cream space-y-2">
              <span class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block">Walimatul 'Ursy</span>
              <h3 class="font-serif text-xl italic font-normal leading-none">Aisyah & Yusuf</h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <p class="text-[7px] tracking-widest uppercase font-semibold text-cream/80">Tanpa Instrumen Musik</p>
            </div> -->
          </div>
          <div class="mt-4 text-center">
            <h3
              class="text-[11px] font-black uppercase tracking-wider text-brand-950"
            >
              Feminime Javanese
            </h3>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">
              Adat Jawa & Islami
            </p>
          </div>
        </div>

        <!-- Card 2: Traditional Weton Jawa Layout -->
        <div class="relative group cursor-pointer">
          <div
            class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-[#121110] flex flex-col justify-between p-5 relative"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-brand-950/80 via-transparent to-brand-950/20 z-10 opacity-70 group-hover:opacity-60 transition-opacity"
            >
            </div>

            <img
              src="/images/undangan-digital-display-homepage-2.webp"
              alt="Desain Undangan Pernikahan Adat Minangkabau"
              class="absolute inset-0 w-full h-full object-cover z-0 filter sepia-[30%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />

            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span
                class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full"
                >Adat Minangkabau</span
              >
              <span class="w-2.5 h-2.5 rounded-full bg-[#B59A73]"></span>
            </div>

            <!-- Content Area inside Screen -->
            <!-- <div class="z-20 text-center text-cream space-y-2">
              <span
                class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block"
                >Serat Katresnan</span
              >
              <h3 class="font-serif text-xl italic font-normal leading-none">
                Roro & Bagus
              </h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <span
                class="px-2 py-0.5 bg-[#B59A73]/30 border border-[#B59A73]/40 rounded text-[6px] tracking-wider uppercase font-bold text-[#c9b77d] inline-block"
                >Weton Sri (Mulia)</span
              >
            </div>  -->
          </div>
          <div class="mt-4 text-center">
            <h3
              class="text-[11px] font-black uppercase tracking-wider text-brand-950"
            >
              Gadang
            </h3>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">
              Adat Minangkabau Sumatera Barat
            </p>
          </div>
        </div>

        <!-- Card 3: Modern Botanical Layout -->
        <div class="relative group cursor-pointer">
          <div
            class="w-full aspect-[9/16] rounded-2xl overflow-hidden border border-brand-200/40 shadow-elevated transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-card-hover bg-[#FAF9F6] flex flex-col justify-between p-5 relative"
          >
            <div
              class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-brand-950/20 z-10 opacity-60 group-hover:opacity-50 transition-opacity"
            >
            </div>

            <img
              src="/images/undangan-digital-display-homepage-3.webp"
              alt="Desain Undangan Pernikahan Modern"
              class="absolute inset-0 w-full h-full object-cover z-0 filter contrast-[98%] group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />

            <!-- Top Badges inside Screen -->
            <div class="z-20 flex justify-between items-center">
              <span
                class="px-2 py-0.5 bg-white/95 text-brand-900 text-[7px] font-black uppercase tracking-widest rounded-full"
                >Elegant Modern</span
              >
              <span class="w-2.5 h-2.5 rounded-full bg-soft-gold"></span>
            </div>

            <!-- Content Area inside Screen -->
            <!-- <div class="z-20 text-center text-cream space-y-2">
              <span
                class="text-[7px] uppercase tracking-[0.2em] text-[#c9b77d] font-bold block"
                >Save The Date</span
              >
              <h3 class="font-serif text-xl italic font-normal leading-none">
                Chloe & Darren
              </h3>
              <div class="w-6 h-[0.5px] bg-[#c9b77d]/40 mx-auto"></div>
              <p
                class="text-[7px] tracking-widest uppercase font-semibold text-cream/80"
              >
                Eucalyptus Minimalist
              </p>
            </div> -->
          </div>
          <div class="mt-4 text-center">
            <h3
              class="text-[11px] font-black uppercase tracking-wider text-brand-950"
            >
              Salsa
            </h3>
            <p class="text-[9px] text-text-muted font-bold font-sans mt-0.5">
              Kurung Koto
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
