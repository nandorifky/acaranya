---
import Container from '../base/Container.astro';
import Section from '../base/Section.astro';
import SectionHeader from '../base/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/site';

const allTestimonials = await getCollection('testimonials');
const published = allTestimonials.filter(t => t.data.status === 'published').slice(0, 3);
---

<Section bg="white" id="testimonials">
  <Container>
    <div class="mb-14 text-center space-y-3">
      <span class="text-[10px] uppercase tracking-[0.2em] text-soft-gold font-bold">Kisah Bahagia</span>
      <h2 class="font-serif text-3xl md:text-5xl text-brand-950 max-w-xl mx-auto leading-tight">
        Kesan Indah dari Ribuan Pelanggan Kami
      </h2>
      <p class="text-sm text-text-secondary max-w-md mx-auto font-sans tracking-wide">
        Kepuasan Anda adalah karya terbaik kami. Berikut cerita dari mereka yang memercayakan momen indahnya kepada kami.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger items-stretch">
      {published.map((testimonial) => (
        <figure class="relative bg-surface rounded-3xl p-7 lg:p-8 border border-border-soft/60 shadow-sm hover:shadow-card transition-all duration-300 flex flex-col justify-between">
          <!-- Quote Icon Accent -->
          <div class="absolute top-6 right-6 text-soft-gold/10 font-serif text-7xl leading-none select-none pointer-events-none">“</div>
          
          <div class="space-y-6">
            <!-- Stars -->
            <div class="flex gap-0.5" aria-label={`Rating ${testimonial.data.rating} dari 5 bintang`}>
              {Array.from({ length: testimonial.data.rating }).map(() => (
                <Icon name="star" size={12} class="text-soft-gold fill-soft-gold" />
              ))}
            </div>

            <!-- Quote Text -->
            <blockquote class="font-serif text-base text-brand-900 leading-relaxed italic relative z-10 font-medium">
              "{testimonial.data.message}"
            </blockquote>
          </div>

          <!-- Author Info -->
          <figcaption class="flex items-center gap-3.5 pt-6 border-t border-border-soft/50 mt-6">
            <div class="w-9 h-9 rounded-full bg-brand-50/60 border border-brand-100 flex items-center justify-center shrink-0">
              <span class="font-serif text-sm text-brand-700 font-bold uppercase">
                {testimonial.data.name.charAt(0)}
              </span>
            </div>
            <div>
              <p class="font-serif text-[15px] font-semibold text-brand-950">{testimonial.data.name}</p>
              <p class="text-[10px] text-text-muted font-bold uppercase tracking-wider mt-0.5">{testimonial.data.eventType}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </Container>
</Section>
