---
import Container from "../base/Container.astro";
import Icon from "../ui/Icon.astro";
import { whyChooseUsFeatures } from "../../data/why-choose-us";

const features = whyChooseUsFeatures;
---

<section
  class="relative py-20 sm:py-24 lg:py-32 bg-white overflow-hidden"
  id="why-acaranya"
>
  <!-- Dot Matrix -->
  <div
    class="absolute inset-0 text-brand-300 opacity-30 pointer-events-none"
    style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px; mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);"
  >
  </div>

  <Container>
    <div class="relative z-10">
      <div class="mb-16 lg:mb-20 text-center space-y-4">
        <span
          class="text-[10px] uppercase tracking-[0.2em] text-soft-gold font-bold"
          >Kenapa Acaranya.id</span
        >
        <h2
          class="font-serif text-3xl md:text-5xl text-brand-950 max-w-2xl mx-auto leading-tight"
        >
          Solusi Undangan Digital Terima Beres
        </h2>
        <p
          class="text-sm text-text-secondary max-w-lg mx-auto font-sans tracking-wide leading-relaxed"
        >
          Kami membantu mewujudkan momen spesial Anda dengan pelayanan yang
          ramah dan profesional, serta menyediakan detail fitur undangan yang
          lengkap untuk memenuhi kebutuhan setiap momen spesial.
        </p>
      </div>

      <!-- Open Grid Layout (No borders, Kinto style) -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-14 stagger"
      >
        {
          features.map((feature) => (
            <div class="group text-center lg:text-left">
              <span class="text-[10px] tracking-[0.2em] uppercase text-soft-gold font-bold block mb-3">
                {feature.num}
              </span>
              <h3 class="font-serif text-xl font-semibold text-brand-950 mb-3 group-hover:text-soft-gold transition-colors duration-300">
                {feature.title}
              </h3>
              <p class="text-text-secondary text-sm leading-relaxed font-sans tracking-wide">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
